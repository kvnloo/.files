#!/usr/bin/env bash
# Render config/k3s/manifests/62-hre-phone-code.yaml (ConfigMap hre-phone-code) from the pod code.
# --check: fail if the committed ConfigMap is stale.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd); repo=$(cd "$here/../.." && pwd)
out=$repo/config/k3s/manifests/62-hre-phone-code.yaml
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
{ echo "# GENERATED by services/hre-phone/render-configmap; do not edit."
  kubectl create configmap hre-phone-code -n phones --dry-run=client -o yaml \
    --from-file="$here/phone_label.py" --from-file="$here/phone_sweep.py" --from-file="$here/phone_embed.py" --from-file="$here/assemble_labels.py"
} > "$tmp"
if [ "${1:-}" = --check ]; then cmp -s "$tmp" "$out" || { echo "stale: $out (run services/hre-phone/render-configmap)"; exit 1; }; exit 0; fi
cp "$tmp" "$out"; echo "wrote $out"
