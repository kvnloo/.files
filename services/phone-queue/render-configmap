#!/usr/bin/env python3
"""Render config/k3s/manifests/60-phone-queue-code.yaml from the service sources.

  services/phone-queue/render-configmap          write it
  services/phone-queue/render-configmap --check  exit 1 when the committed file is stale
setup-k3s.sh check runs --check, so a source edit without a re-render fails the check.
"""
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
OUT = HERE.parents[1] / "config/k3s/manifests/60-phone-queue-code.yaml"
FILES = ["common.py", "server.py", "runner.py", "phone_tools.py", "model_shim.py"]


def render():
    lines = ["# GENERATED by services/phone-queue/render-configmap from services/phone-queue/*.py.",
             "# Do not edit; edit the sources and re-render (setup-k3s.sh check fails when stale).",
             "apiVersion: v1", "kind: ConfigMap", "metadata:", "  name: phone-queue-code",
             "  namespace: phones", "data:"]
    for name in FILES:
        lines.append(f"  {name}: |")
        for line in (HERE / name).read_text().splitlines():
            lines.append(("    " + line) if line else "")
    return "\n".join(lines) + "\n"


if __name__ == "__main__":
    text = render()
    if "--check" in sys.argv:
        if not OUT.exists() or OUT.read_text() != text:
            sys.exit(f"{OUT} is stale: run services/phone-queue/render-configmap")
        print("phone-queue ConfigMap is current")
    else:
        OUT.write_text(text)
        print(f"wrote {OUT}")
