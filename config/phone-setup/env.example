# Phone setup settings. `scripts/phone-setup init` copies this to
# ~/.config/phone-setup/env; every phone script in this repo reads that file.
# Plain KEY=value lines (sourced by bash). Leave a value empty to use the default.

# The phone's hardware serial (`adb shell getprop ro.serialno`). It stays the same when
# the wireless-debugging port changes, so scripts find the phone by this, not by ip:port.
PHONE_SERIAL=

# Package id of your Detent build. Use your own id so it never collides with stock Detent
# from the Play Store / GitHub releases (stock has no colour receiver and no live themes).
DETENT_PACKAGE=app.detent.launcher.fork

# Wallpaper Engine (desktop, Steam) workshop folder. Only needed to convert desktop scenes
# for the phone on Linux. Windows users can send wallpapers with WE's own "Mobile" button.
WE_WORKSHOP_DIR=$HOME/.local/share/Steam/steamapps/workshop/content/431960

# Where phone packages (.mpkg) are kept. Too big for Git, so keep them outside the repo.
WE_MPKG_STORE=$HOME/.local/share/wallpapers/mpkg

# Your own list of live wallpapers (same shape as config/wallpapers/live.json).
# Empty = the repo's list, which is Kevin's.
LIVE_LIST=$HOME/.config/wallpapers/live.json

# Colour file the desktop colour sync reads (Noctalia's; pywal-style keys
# mSurface/mOnSurface/mPrimary). Only for Hyprland + Noctalia desktops.
DETENT_COLORS=$HOME/.config/noctalia/colors.json
