{
  "services": {
    "tailscaled": {
      "argv": ["/root/.local/share/fleet/sv/tailscaled/run"],
      "cwd": "/root/.local/share/fleet/sv/tailscaled"
    },
    "sshd": {
      "argv": ["/root/.local/share/fleet/sv/sshd/run"],
      "cwd": "/root/.local/share/fleet/sv/sshd"
    },
    "tern-remote": {
      "argv": ["/root/.local/share/fleet/sv/tern-remote/run"],
      "cwd": "/root/.local/share/fleet/sv/tern-remote"
    },
    "worker": ["/usr/bin/python3", "/root/.local/lib/fleet/fleet-phone-worker", "serve"]
  },
  "restart": {"base": 1, "cap": 60, "burst": 5, "window": 300, "stable": 120}
}
