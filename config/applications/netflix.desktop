[Desktop Entry]
Type=Application
Name=Netflix
GenericName=Video Streaming
Comment=Watch Netflix with the main Chrome profile
Exec=/usr/bin/google-chrome-stable --profile-directory=Default --app=https://www.netflix.com/
TryExec=/usr/bin/google-chrome-stable
Icon=netflix
Terminal=false
Categories=AudioVideo;Video;
Keywords=netflix;movies;tv;streaming;
StartupNotify=true
