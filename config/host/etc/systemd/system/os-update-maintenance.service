[Unit]
Description=R09 maintenance window: apply staged updates, reboot if a package that needs one changed
Documentation=file:///workspace/.files/docs/fleet/OS-UPDATE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /etc/os-update/run maintenance
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=2h
