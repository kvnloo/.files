[Unit]
Description=Resource envelope for interactive coding agents

[Slice]
CPUAccounting=yes
CPUWeight=80
IOAccounting=yes
IOWeight=50
MemoryAccounting=yes
# Throttle the fleet before it can reclaim the compositor and foreground apps.
MemoryHigh=10G
# Disk swap is an emergency tier, not unbounded working memory for agents.
MemorySwapMax=24G
