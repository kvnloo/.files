[Unit]
Description=Lease-only fleet reclamation report (hourly and disk-pressure)

[Service]
Type=oneshot
ExecStart=%h/.local/lib/artifact-leases/current/scripts/artifact-lease-controller.py --monitor --node groot --node mbp --node s22 --output %h/.local/state/artifact-leases/reports
# 3 = report written, part of a node unreachable (a phone asleep); controller errors exit 1.
SuccessExitStatus=3
TimeoutStartSec=15min
