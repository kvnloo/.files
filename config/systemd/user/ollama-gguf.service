[Unit]
Description=GPU-accelerated GGUF inference via Ollama
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/zer0models

[Service]
ExecStart=/mnt/zer0models/zer0-models/runtime/ollama-0.33.2/bin/ollama serve
Environment=HOME=/home/kvn
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/mnt/zer0models/zer0-models/ollama
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
