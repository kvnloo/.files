[Unit]
Description=Pull the hub's State Packet and owner corrections (read-only artifacts for the harness hooks)
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/z0int-state-pull
Nice=10
# Best-effort, not idle: on mq-deadline an idle read waits ~10 s behind any
# streaming job, which breaks this unit's short deadline (tests/test_idle_io_deadline.py).
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=120
