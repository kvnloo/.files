[Unit]
Description=z0int continuous shadow-learning tick (never promotes)
After=network-online.target

[Service]
Type=oneshot
Environment=Z0INT_HOME=%h/.z0int
Environment=Z0INT_PYTHON=%h/workspace/z0intelligence-pinned/.venv/bin/python
ExecStart=%h/workspace/z0intelligence-pinned/.venv/bin/python -m z0int.cli loop tick --lock %h/.z0int/loop/quiet-lane.lock --lock-wait-s 30 --budget-s 120 --ledger %h/.z0int/loop/quiet-lane-ledger.jsonl
Nice=19
SuccessExitStatus=3
IOSchedulingClass=idle
