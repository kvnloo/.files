[Unit]
Description=FBL1: drain the Fable queue on an account in the Fable-first phase (one job at a time)
After=network-online.target
[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/fable-drain
TimeoutStartSec=3h30min
Nice=10
IOSchedulingClass=idle
OOMPolicy=continue
