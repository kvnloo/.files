[Unit]
Description=LumenFold private process-study Tailnet origin
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/workspace/zer0/experiments/miniature-transformation-ad-lab
ExecStart=/usr/bin/python tools/range_http_server.py --directory outputs/v3/private-process-blog --port 9152
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/workspace/zer0/experiments/miniature-transformation-ad-lab

[Install]
WantedBy=default.target
