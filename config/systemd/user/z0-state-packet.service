[Unit]
Description=Refresh source-linked agent state packet atomically
ConditionFileIsExecutable=%h/.local/lib/z0-state-packet/current/bin/generate-packet

[Service]
Type=oneshot
ExecStart=%h/.local/lib/z0-state-packet/current/bin/generate-packet
UMask=0077
Nice=19
# Best-effort, not idle: on mq-deadline an idle read waits ~10 s behind any
# streaming job, which breaks this unit's short deadline (tests/test_idle_io_deadline.py).
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5min
