[Unit]
Description=z0 factory ghcache: shared caching, budgeted GitHub read proxy (127.0.0.1:18090)
Documentation=https://github.com/kvnloo/oss-factory/blob/main/factory/EXECUTION_SUBSTRATE.md
After=network-online.target

[Service]
Type=simple
# Rendered by install-user-units.sh: FACTORY_TOOLS is the absolute tools/factory path.
Environment=FACTORY_TOOLS=/mnt/zer0models/worktrees/oss-factory-substrate/tools/factory
Environment=GHCACHE_STATE=%h/.local/state/z0-factory
# Short-lived handler threads would each keep a glibc malloc arena: 136 MiB RSS after a
# 200-agent burst without this.
Environment=MALLOC_ARENA_MAX=2
# No --pod-listen (2026-11-24): the k3s server moved to mbp, groot's node is NotReady/cordoned,
# cni0 (10.42.0.1) no longer exists here and z0/factory-gateway is scaled to 0. To serve pods
# again, add `--pod-listen <cni0 IP>:18091` on the host that runs them (kvnloo/oss-factory#455:
# the bind now backs off and gives up instead of logging every 30 s forever).
ExecStart=/usr/bin/python3 -u ${FACTORY_TOOLS}/ghcache.py --listen 127.0.0.1:18090 --core-per-hour 3000 --reserve 500 --max-upstream 3
Restart=on-failure
RestartSec=10
# X2b 2026-11-07 (t_0c86492a): throttle at the old cap (MemoryHigh), hard stop at 1.5x.
MemoryHigh=256M
MemoryMax=384M
CPUQuota=50%
Nice=5

[Install]
WantedBy=default.target
