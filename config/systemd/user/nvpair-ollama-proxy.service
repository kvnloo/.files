[Unit]
Description=NVIDIA PAIR ollama-proxy (mbp) :11440 with stdin FIFO
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=/home/kvn/workspace/hermes-jobs/mesh-velocity/pair-staging
ExecStartPre=/usr/bin/bash -c "rm -f logs/ollama-proxy.stdin; mkfifo logs/ollama-proxy.stdin"
ExecStart=/usr/bin/bash -c "sleep infinity > logs/ollama-proxy.stdin & exec ./ollama-proxy -port 11440 -ignore-persisted-port -log-level info < logs/ollama-proxy.stdin"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
