[Unit]
Description=Cap memory of uncapped user services so a hog dies alone (not its neighbours)
Documentation=https://github.com/kvnloo/.files/blob/dev/scripts/service-envelope

[Service]
# Resident loop (F16): the 60 s oneshot timer cost 60 unit starts per hour.
Type=simple
ExecStart=%h/.local/bin/service-envelope --loop
Restart=always
RestartSec=10
MemoryMax=64M
Nice=5

[Install]
WantedBy=default.target
