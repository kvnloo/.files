[Unit]
Description=Keep kernel OOM kills off coding-agent roots (tools and subagents go first)
Documentation=file:///home/kvn/.local/bin/agent-oom-guard

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/agent-oom-guard
Restart=always
RestartSec=2
# Lowest score an unprivileged unit may take; the guard itself must outlive tools.
OOMScoreAdjust=100
MemoryMax=192M
CPUQuota=25%
Nice=5

[Install]
WantedBy=default.target
