[Unit]
Description=Protect agent roots and desktop; relieve zone pressure with disposable tools
Documentation=file:///home/kvn/.local/bin/agent-oom-guard

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/agent-oom-guard
Restart=always
RestartSec=2
# Lowest score an unprivileged unit may take; the guard itself must outlive tools.
OOMScoreAdjust=100
# X2b 2026-11-07 (t_0c86492a): throttle at the old cap (MemoryHigh), hard stop at 1.5x.
MemoryHigh=192M
MemoryMax=288M
CPUQuota=25%
Nice=5

[Install]
WantedBy=default.target
