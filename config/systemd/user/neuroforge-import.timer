[Unit]
Description=Periodically import existing redacted activity and learning outboxes

[Timer]
OnBootSec=45s
# F16 start budget (2026-11-16): low-urgency, 2 min -> 5 min.
OnCalendar=*-*-* *:0/5:00
Persistent=true
AccuracySec=5s
RandomizedDelaySec=3s
Unit=neuroforge-import.service

[Install]
WantedBy=timers.target
