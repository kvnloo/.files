[Unit]
Description=O7: provider routing check over omp, Hermes profile and Dash role configs (read-only)

[Service]
Type=oneshot
Environment=PYTHONPATH=/mnt/zer0models/z0-wt/bend-ops-laws/src
# report-only: findings go to ~/.local/state/z0-guard/decisions.jsonl; values of key/token
# fields are never read into the output.
ExecStart=/usr/bin/python3 -m z0int.fsm.guard routing
TimeoutStartSec=1min
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/z0-guard
