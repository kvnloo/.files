[Unit]
Description=adb server for the USB agent phone (boot start; skipped when a server already listens)
Documentation=man:adb(1)

[Service]
Type=simple
# Never fight a server that fleet-adb or a client already started: that kill
# would reset every phone connection. Exit 1 here skips the start cleanly.
ExecCondition=/bin/sh -c '/usr/bin/ss -Hltn "sport = :5037" | grep -q . && exit 1 || exit 0'
ExecStart=%h/android/sdk/platform-tools/adb -L tcp:5037 server nodaemon
Restart=on-failure
RestartSec=10
# X2b 2026-11-07 (t_0c86492a): throttle at the old cap (MemoryHigh), hard stop at 1.5x.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=default.target
