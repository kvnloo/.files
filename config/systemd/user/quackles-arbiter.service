[Unit]
Description=Quackles memory arbiter tick: unload idle (sleeping) llama router children when Quackles/host need RAM

[Service]
Type=oneshot
# QK_ARB_DRY_RUN=1 = log only. Edit ~/.config/quackles-arbiter/env (written by install.sh) to switch.
EnvironmentFile=-%h/.config/quackles-arbiter/env
ExecStart=%h/zer0/oss/hermes-k8s-lab/quackles/arbiter/qk-arbiter --once
Nice=10
# backstop for the script's own --deadline-s (60 s): a stalled tick must not block later ones
TimeoutStartSec=90
MemoryMax=128M
