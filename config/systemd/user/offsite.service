[Unit]
Description=Off-machine copies: push local-only git work to kvnloo remotes (canon #16)
After=network-online.target

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -I %h/.local/bin/offsite-sync --apply
TimeoutStartSec=20h
