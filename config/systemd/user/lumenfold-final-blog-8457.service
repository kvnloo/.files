[Unit]
Description=LumenFold final case-study Tailnet origin
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/workspace/zer0/experiments/miniature-transformation-ad-lab/outputs/final-case-study
ExecStart=/usr/bin/python -m http.server 9143 --bind 127.0.0.1
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/workspace/zer0/experiments/miniature-transformation-ad-lab/outputs/final-case-study

[Install]
WantedBy=default.target
