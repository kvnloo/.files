[Unit]
Description=Report and deduplicate failure of %I
OnFailure=

[Service]
Type=oneshot
# Spool, not report: the daemon drains %t/service-watch/intake each scan and stays the only DB
# writer. `service-watch failure <unit>` remains for manual reports.
ExecStart=/usr/bin/install -D -m 0600 /dev/null %t/service-watch/intake/%i
UMask=0077
Nice=15
MemoryMax=96M
# Best-effort, not idle: on mq-deadline an idle read waits ~10 s behind any
# streaming job, which breaks this unit's short deadline (tests/test_idle_io_deadline.py).
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=
TasksMax=16
NoNewPrivileges=true
TimeoutStartSec=15
