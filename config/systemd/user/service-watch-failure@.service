[Unit]
Description=Report and deduplicate failure of %I
OnFailure=

[Service]
Type=oneshot
ExecStart=%h/.local/bin/service-watch failure %I
UMask=0077
Nice=15
MemoryMax=96M
# Best-effort, not idle: on mq-deadline an idle read waits ~10 s behind any
# streaming job, which breaks this unit's short deadline (tests/test_idle_io_deadline.py).
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=
TasksMax=16
NoNewPrivileges=true
TimeoutStartSec=90
