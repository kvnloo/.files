[Unit]
Description=Ollama (user-local, CPU) for NVIDIA PAIR mbp node
After=network-online.target

[Service]
ExecStart=/home/kvn/.local/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=LD_LIBRARY_PATH=/home/kvn/.local/lib/ollama
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
