[Unit]
Description=Factory ChatGPT queue launcher (%i)
After=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /mnt/zer0models/workspace/zer0/data/operations/chatgpt-driver/bin/tern-queue-loop.sh %i
Slice=agent.slice
# X2b 2026-11-07 (t_0c86492a): throttle at the old cap (MemoryHigh), hard stop at 1.5x.
MemoryHigh=600M
MemoryMax=900M
Nice=5
IOWeight=10
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
