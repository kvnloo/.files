[Unit]
Description=Zer0 continuous voice on stable NVIDIA Maxine microphone
Requires=zer0-maxine-stable.service
After=zer0-maxine-stable.service

[Service]
Type=simple
Environment=PULSE_SOURCE=zer0_maxine_full
Environment=ZERO_VOICE_INPUT=pulse
Environment=ZERO_VOICE_MIC_MODE=continuous
Environment=ZERO_VOICE_STATE_DIR=/home/kvn/.local/state/zer0-voice/maxine-full
Environment=ZERO_VOICE_HEALTH=/home/kvn/.local/state/zer0-voice/maxine-full/health.json
Environment=ZERO_VOICE_DEBUG=/home/kvn/.local/state/zer0-voice/maxine-full/debug.jsonl
Environment=ZERO_VOICE_METRICS=/workspace/zer0/products/pm/bench/voice-history.jsonl
Environment=ZERO_VOICE_CONTROL_SOCKET=/run/user/1000/zer0-voice-maxine-full.sock
Environment=ZERO_VOICE_LIVE_MODEL=gpt-5.6-luna
Environment=ZERO_VOICE_LIVE_EFFORT=low
Environment=ZERO_VOICE_BARGE_IN=final
ExecStart=/home/kvn/.local/state/zer0-voice/releases/bundles/a06b262af9ec76e0e56a8313202093df91a5c38438deca5d471f07daf1ea199d/voice/candidate-service /home/kvn/.local/state/zer0-voice/releases/bundles/a06b262af9ec76e0e56a8313202093df91a5c38438deca5d471f07daf1ea199d 019f904f-2462-7593-85c4-22b88e4f4908
Restart=always
RestartSec=1
StartLimitIntervalSec=60
StartLimitBurst=5
TimeoutStopSec=5

[Install]
WantedBy=default.target
