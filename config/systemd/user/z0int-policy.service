[Unit]
Description=Ingest measured findings and compile decision policy
OnFailure=service-watch-failure@z0int\x2dpolicy.service.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/zer0models/z0-wt/decision-policy
Environment=PATH=/home/kvn/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/mnt/zer0models/z0-wt/decision-policy/src
ExecStart=/bin/sh -ec 'z0int policy ingest && z0int policy compile'
UMask=0077
Nice=15
MemoryMax=256M
CPUQuota=15%
TasksMax=32
TimeoutStartSec=5min
NoNewPrivileges=true
