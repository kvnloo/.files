[Unit]
Description=Report-only tracked host configuration drift audit
# Failure watcher: the escaped OnFailure= lives in the service-watch drop-in (90-service-watch.conf).
# An inline OnFailure=service-watch-failure@%n.service is NOT escaped (%I turns "-" into "/") and fired a
# second, failing watcher (memory-services-20261027 step 0a).

[Service]
Type=oneshot
ExecStart=%h/.local/bin/host-drift --output %h/.local/state/host-drift/latest.json
ExecStartPost=%h/.local/lib/files-host-drift/current/scripts/service-watch.py host-drift
SuccessExitStatus=1 2
Nice=19
IOSchedulingClass=idle
MemoryMax=256M
TimeoutStartSec=180
NoNewPrivileges=yes
