[Unit]
Description=Report-only tracked host configuration drift audit

[Service]
Type=oneshot
ExecStart=%h/.local/bin/host-drift --output %h/.local/state/host-drift/latest.json
ExecStartPost=%h/.local/bin/service-watch host-drift
SuccessExitStatus=1 2
Nice=19
# Best-effort, not idle: on mq-deadline an idle read waits ~10 s behind any
# streaming job, which breaks this unit's short deadline (tests/test_idle_io_deadline.py).
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=256M
TimeoutStartSec=180
NoNewPrivileges=yes
