[Unit]
Description=Recall check: owner canon reaches every turn and memory search finds his words
# Failure watcher: the escaped OnFailure= lives in the service-watch drop-in (90-service-watch.conf).
# An inline OnFailure=service-watch-failure@%n.service is NOT escaped (%I turns "-" into "/") and fired a
# second, failing watcher (memory-services-20261027 step 0a).
Wants=agentsview.service
After=agentsview.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /mnt/zer0models/workspace/zer0/data/operations/memory-repair-20261025/recall_check.py
Nice=10
TimeoutStartSec=5min
# Durable run receipt (journal rotates within hours): ~/.local/state/memory-services/receipts.jsonl
ExecStopPost=-%h/.local/bin/memory-unit-receipt memory-recall-check.service /mnt/zer0models/workspace/zer0/data/operations/memory-repair-20261025/recall-receipt.json
