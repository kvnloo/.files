[Unit]
Description=T3 Code nightly server (fork channels/nightly, copy of real data, port 3793)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace
Environment=T3CODE_HOME=/mnt/zer0models/workspace/zer0/data/operations/t3-channels/nightly-server/home
Environment=NODE_ENV=production
# No GitHub auth: the copied threads still watch PRs, and stable already wakes them.
Environment=GH_CONFIG_DIR=%h/.local/state/t3-nightly-no-gh
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN
ExecStart=/workspace/hermes-home/tools/node-26.12.1-linux-x64/bin/node /mnt/zer0models/workspace/zer0/oss/t3code-wt/nightly-server/apps/server/src/bin.ts serve --base-dir /mnt/zer0models/workspace/zer0/data/operations/t3-channels/nightly-server/home --port 3793 --lan --no-browser %h/workspace
Restart=on-failure
RestartSec=5
MemoryHigh=3G
StandardOutput=append:/mnt/zer0models/workspace/zer0/data/operations/t3-channels/nightly-server/server.log
StandardError=append:/mnt/zer0models/workspace/zer0/data/operations/t3-channels/nightly-server/server.log

[Install]
WantedBy=default.target
