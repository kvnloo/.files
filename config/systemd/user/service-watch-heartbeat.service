[Unit]
Description=Check service watch self-heartbeat without LLM calls

[Service]
Type=oneshot
ExecStart=%h/.local/bin/service-watch heartbeat
UMask=0077
Nice=19
MemoryMax=96M
# Best-effort, not idle: on mq-deadline an idle read waits ~10 s behind any
# streaming job, which breaks this unit's short deadline (tests/test_idle_io_deadline.py).
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=
TasksMax=16
NoNewPrivileges=true
TimeoutStartSec=90
