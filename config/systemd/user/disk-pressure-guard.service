[Unit]
Description=Fail-closed disk pressure guard

[Service]
Type=oneshot
ExecStart=%h/.local/bin/disk-pressure-guard
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# user-tmpfiles creates the leaf before activation; sandbox the guaranteed parent.
ReadWritePaths=%h/.local/state
