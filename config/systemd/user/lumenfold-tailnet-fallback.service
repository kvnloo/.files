[Unit]
Description=LumenFold original-only Tailnet IPv4 fallback
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/workspace/zer0/experiments/miniature-transformation-ad-lab
# Tailnet address from the untracked private overlay; a missing key stops the unit.
EnvironmentFile=%h/.config/dotfiles/private.env
ExecStartPre=/bin/sh -c 'test -n "$${GROOT_TAILNET_IP}" || { echo "GROOT_TAILNET_IP is not set in %h/.config/dotfiles/private.env (see config/private.example.env)" >&2; exit 1; }'
ExecStart=/usr/bin/python tools/range_http_server.py --directory outputs/final-case-study --bind ${GROOT_TAILNET_IP} --port 9160
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/workspace/zer0/experiments/miniature-transformation-ad-lab
RestrictAddressFamilies=AF_INET

[Install]
WantedBy=default.target
