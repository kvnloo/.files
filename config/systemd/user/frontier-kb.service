[Unit]
Description=frontier-kb Postgres (pgvector) on host 0
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/workspace/frontier-kb
EnvironmentFile=-/home/kvn/.config/frontier-kb/env
Environment=KB_BIND=127.0.0.1
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.host-0.yml up -d kb
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.host-0.yml stop kb
TimeoutStartSec=120

[Install]
WantedBy=default.target
