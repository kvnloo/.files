[Unit]
Description=Run the z0 network meta-optimizer cycle every 5 min (jittered)

[Timer]
OnBootSec=90s
# F16 start budget (2026-11-16): low-urgency, 2 min -> 5 min.
OnUnitActiveSec=5min
# Avoid the :00/:15/:30 timer pile-up that coincided with the 13:43 OOM storm.
RandomizedDelaySec=20s
AccuracySec=5s
Persistent=false
Unit=network-optimizer.service

[Install]
WantedBy=timers.target
