[Unit]
Description=Refresh local env files from Bitwarden Secrets Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=HERMES_HOME=%h/.hermes
Environment=PATH=%h/.hermes/bin:%h/.local/bin:/usr/bin:/bin
ExecStart=%h/workspace/.files/scripts/bws-apply-local-secrets.sh

[Install]
WantedBy=default.target
