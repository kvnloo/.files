[Unit]
Description=Refresh scoped runtime credentials from Bitwarden Secrets Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=HERMES_HOME=%h/.hermes
Environment=PATH=%h/.hermes/bin:%h/.local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/bws-apply-local-secrets

[Install]
WantedBy=default.target
