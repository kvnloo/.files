[Unit]
Description=LumenFold private process-study Tailnet origin
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/workspace/zer0/experiments/miniature-transformation-ad-lab/outputs/v3/private-process-blog
ExecStart=/usr/bin/python -m http.server 9142 --bind 127.0.0.1
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/workspace/zer0/experiments/miniature-transformation-ad-lab/outputs/v3/private-process-blog

[Install]
WantedBy=default.target
