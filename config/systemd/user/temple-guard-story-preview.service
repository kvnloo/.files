[Unit]
Description=Temple Guard VitePress artifact story
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/workspace/zer0/experiments/jedi_temple_guard
ExecStart=/usr/bin/npm run story:preview -- --host 0.0.0.0 --port 4176
# Re-apply this unit's tailnet route on every start (a `serve reset` on 2026-11-06 wiped it).
ExecStartPost=-/usr/bin/tailscale serve --bg --https=8447 http://127.0.0.1:4176
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
