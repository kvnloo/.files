[Unit]
Description=Tailnet-only bidirectional file portal
After=graphical-session.target tailscaled.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/taildrop-portal
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Downloads/Taildrop /workspace/Transfers/Taildrop
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=graphical-session.target
