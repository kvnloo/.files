[Unit]
Description=z0 farm: bounded llama.cpp CUDA router on tailnet 100.113.138.100:11530
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# One resident model; idle children release resources after two minutes.
# Keep the router itself running so existing clients retain the same endpoint.
ExecStart=/workspace/z0-farm/llama.cpp-b11270/build/bin/llama-server --models-dir /workspace/z0-farm/models/router --models-max 1 --device CUDA0 -ngl 99 -c 8192 --parallel 2 --cache-ram 512 --host 100.113.138.100 --port 11530 --no-webui --reasoning off -t 4 --sleep-idle-seconds 120
# Groot has 23.36 GiB RAM. Bound the whole router/child cgroup, not just its parent.
MemoryAccounting=yes
MemoryHigh=6G
MemoryMax=8G
MemorySwapMax=512M
ManagedOOMPreference=none
OOMPolicy=kill
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=default.target
