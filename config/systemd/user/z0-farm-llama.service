[Unit]
Description=z0 farm: bounded llama.cpp CUDA router on groot's tailnet address, port 11530
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# One resident model; idle children release resources after two minutes.
# Keep the router itself running so existing clients retain the same endpoint.
# Tailnet address from the untracked private overlay; a missing key stops the unit.
EnvironmentFile=%h/.config/dotfiles/private.env
ExecStartPre=/bin/sh -c 'test -n "$${GROOT_TAILNET_IP}" || { echo "GROOT_TAILNET_IP is not set in %h/.config/dotfiles/private.env (see config/private.example.env)" >&2; exit 1; }'
ExecStart=/workspace/z0-farm/llama.cpp-b11270/build/bin/llama-server --models-dir /workspace/z0-farm/models/router --models-max 1 --device CUDA0 -ngl 99 -c 8192 --parallel 2 --cache-ram 512 --host ${GROOT_TAILNET_IP} --port 11530 --no-webui --reasoning off -t 4 --sleep-idle-seconds 120
# Groot has 23.36 GiB RAM. Bound the whole router/child cgroup, not just its parent.
MemoryAccounting=yes
MemoryHigh=infinity
MemoryMax=8G
MemorySwapMax=512M
ManagedOOMPreference=none
OOMPolicy=kill
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=default.target
