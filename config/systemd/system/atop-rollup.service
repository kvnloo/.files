[Unit]
Description=Convert closed atop archives on the MBP through fleet
After=network-online.target atop-rotate.service
Wants=network-online.target
OnSuccess=atop-rollup-retire.service

[Service]
Type=oneshot
User=kvn
Group=kvn
Environment=HOME=/home/kvn
Environment=PATH=/home/kvn/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/local/lib/infra-monitor/atop-rollup.py remote --limit 0
Nice=19
IOSchedulingClass=idle
IOWeight=10
CPUWeight=10
MemoryMax=512M
UMask=0077
TimeoutStartSec=infinity
NoNewPrivileges=true
ProtectSystem=full
