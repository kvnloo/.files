PURPLE_SELECTION:      #BE78D140;      // Purple at 25%
PURPLE_RIPPLE:         #BE78D130;      // Purple ripple

// --- Message bubble backgrounds ---
MSG_IN_BG:             #0A0A0A;        // Incoming message bubble
MSG_IN_BG_SEL:         #141414;        // Incoming selected
MSG_OUT_BG:            #0D0D10;        // Outgoing bubble (very slight tint)
MSG_OUT_BG_SEL:        #161618;        // Outgoing selected

// --- Text colors ---
TEXT_PRIMARY:           #E0E0E8;        // Primary text (light gray)
TEXT_SECONDARY:         #606070;        // Muted / secondary text
TEXT_TERTIARY:          #454558;        // Even more muted
TEXT_ON_ACCENT:         #FFFFFF;        // White text on accent backgrounds
TEXT_LINK:              ACCENT;         // Link text color

// --- Borders / dividers ---
BORDER:                #FFFFFF10;       // Subtle border (white 6%)
BORDER_LIGHT:          #FFFFFF08;       // Even subtler
SHADOW:                #00000060;       // General shadow

// --- Status colors ---
