CARD_BG:               #050505;        // Elevated surfaces / cards
HOVER_BG:              #141414;        // Hover state background

// --- Accent colors ---
ACCENT:                #75A4CD;        // Primary accent (blue)
ACCENT_PURPLE:         #BE78D1;        // Secondary accent (purple)
ACCENT_DIM:            #75A4CD80;      // Accent at 50% opacity
ACCENT_SELECTION:      #75A4CD40;      // Accent at 25% for selections
ACCENT_RIPPLE:         #75A4CD30;      // Accent ripple effect
ACCENT_FAINT:          #75A4CD18;      // Accent very faint (borders etc)
