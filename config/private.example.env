# Private network overlay: copy to ~/.config/dotfiles/private.env (or $DOTFILES_PRIVATE_DIR/private.env)
# and replace every placeholder. That file is never committed (.gitignore); this one only
# documents the keys. All values below are reserved example values: 100.64.0.x is the
# documentation slice of the tailnet range and example.ts.net is not a real tailnet.
#
# Format: KEY=VALUE, one per line; `export ` prefixes, # comments and quotes allowed.
# Readers: systemd units (EnvironmentFile=%h/.config/dotfiles/private.env, so units always
# use the default path), scripts/private_overlay.py, scripts/private-overlay, scripts/devscreen,
# scripts/tern-hosts-sync. Every key is required by at least one reader; a reader that
# needs a missing key stops with a message naming it. There are no built-in defaults.
# Check a filled file with: scripts/private-overlay check

# groot: the desktop/control plane (k3s server, Dash bridge and Metro, z0 farm llama.cpp
# router, LumenFold fallback, service-watch local triage route, k3s smoke-job targets).
GROOT_TAILNET_IP=100.64.0.10

# mbp: the MacBook Pro worker (fleet host lane, Tern sidebar).
MBP_TAILNET_IP=100.64.0.11

# omarchy-phone (S25 Ultra): the Omarchy/PRoot guest node and the Android Tailscale app node.
S25_TAILNET_IP=100.64.0.12
S25_ADB_HOST=100.64.0.13

# galaxy-s22plus (S22+): the localhost-0 guest node and the Android Tailscale app node.
S22_TAILNET_IP=100.64.0.14
S22_ADB_HOST=100.64.0.15

# lenovo-tab: the Android Tailscale app node (adb over the tailnet on :5555).
TAB_TAILNET_IP=100.64.0.16

# The tailnet's MagicDNS suffix (docs and operator commands only).
TAILNET_DOMAIN=example.ts.net
