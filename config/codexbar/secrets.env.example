# Copy to ~/.config/codexbar/secrets.env (0600). Not tracked in git.
# Then run: workspace/.files/scripts/codexbar-sync-credentials.sh

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Vercel AI Gateway — https://vercel.com/docs/ai-gateway
VERCEL_AI_GW_KEY=
# VERCEL_API_KEY=   # fallback alias

# Nous Portal — https://portal.nousresearch.com/
# Optional if you use Hermes Agent (auto-loaded from ~/.hermes/auth.json).
NOUS_API_KEY=

# Optional overrides
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# VERCEL_AI_GW_URL=https://ai-gateway.vercel.sh/v1
# NOUS_API_URL=https://inference-api.nousresearch.com/v1
