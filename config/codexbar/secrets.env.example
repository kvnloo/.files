# Copy to ~/.config/codexbar/secrets.env (never commit the real file).
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
VERCEL_AI_GW_KEY=
NOUS_API_KEY=
# Optional: paste the Cookie header from cursor.com (DevTools → Network → any API request).
# Prefer signing into Cursor IDE locally; codexbar reads ~/.config/Cursor/.../state.vscdb when logged in.
CURSOR_COOKIE=
