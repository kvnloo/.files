+import type { Html, HtmlBuilder } from "foldkit/html"
+
+export interface EnsembleCamera {
+  readonly flat: boolean
+  readonly tilt: string
+  readonly turn: string
+  readonly spacing: string
+  readonly zoom: string
+  readonly cameraEpoch: number
+}
+export const boundedCamera = (raw: string, low: number, high: number, fallback: number) =>
+  Number.isFinite(Number(raw)) ? Math.max(low, Math.min(high, Number(raw))) : fallback
+
+/** Gesture deltas update only the camera fields, preserving the caller's model snapshot. */
+export const zoomEnsembleCamera = <Camera extends EnsembleCamera>(camera: Camera, factor: number) => ({
+  ...camera,
+  cameraEpoch: camera.cameraEpoch + 1,
+  zoom: String(Math.round(Math.max(20, Math.min(200, Number(camera.zoom) * factor)) * 10) / 10)
+})
+
+export const orbitEnsembleCamera = <Camera extends EnsembleCamera>(camera: Camera, dx: number, dy: number) => ({
+  ...camera,
+  cameraEpoch: camera.cameraEpoch + 1,
+  turn: String(Math.round((((((Number(camera.turn) + dx * 0.35 + 180) % 360) + 360) % 360) - 180) * 10) / 10),
+  tilt: String(Math.round(Math.max(0, Math.min(65, Number(camera.tilt) - dy * 0.25)) * 10) / 10)
+})
+
+/** Production fleet camera controls, shared without coupling the scene to review policy. */
+export const ensembleCameraView = <Message>(h: HtmlBuilder<Message>, model: EnsembleCamera,
+  changed: (field: string, raw: string) => Message) => {
+  const range = (name: string, field: string, min: number, max: number, value: string) => h.label([], [
+    name,
+    h.input([
+      h.Type("range"), h.AriaLabel(name), h.Min(String(min)), h.Max(String(max)),
+      h.Key(`camera:${field}:${model.cameraEpoch}`),
+      { _tag: "Prop", key: "defaultValue", value },
+      h.OnInput((raw) => changed(field, raw))
+    ])
+  ])
+  return h.div([h.Class("ensemble-camera")], [
+    range("Tilt", "tilt", 0, 65, model.tilt),
+    range("Rotation", "turn", -180, 180, model.turn),
+    range("Layer spacing", "spacing", 70, 190, model.spacing),
+    range("Zoom", "zoom", 20, 200, model.zoom)
+  ])
+}
+
+/** The production CSS-3D planes and viewport. Layers are presentation, never policy records. */
+export const ensembleViewportView = <Message>(h: HtmlBuilder<Message>, model: EnsembleCamera, content: {
+  readonly active: number
+  readonly ariaLabel: string
+  readonly orientation: string
+  readonly layers: readonly {
+    readonly index: number
+    readonly color: string
+    readonly title: string
+    readonly caption: string
+    readonly diagram: Html
+  }[]
+  readonly connectors?: readonly Html[]
+}) => {
+  const { layers } = content
+  const spacing = boundedCamera(model.spacing, 70, 190, 130)
+  const sceneHeight = model.flat ? 660 : 630 + Math.max(0, layers.length - 3) * 75
+  return h.div([
+    h.Class("ensemble-viewport"),
+    h.Style({ height: model.flat ? "auto" : `${sceneHeight}px` }),
+    h.AriaLabel(content.ariaLabel)
+  ], [
+    h.div([h.Class("ensemble-scene"), h.Style({
+      transform: model.flat ? "none"
+        : `translateY(${-35 + Math.max(0, layers.length - 3) * 30}px) scale(${boundedCamera(model.zoom, 20, 200, 72) / 100}) rotateX(${boundedCamera(model.tilt, 0, 65, 48)}deg) rotateZ(${boundedCamera(model.turn, -180, 180, -16)}deg) translateZ(${(-(layers.length - 1) * spacing) / 2}px)`
+    })], [
+      ...layers.filter((layer) => !model.flat || layer.index === content.active).map((layer) => h.div([
+        h.Class(`ensemble-layer agent-index-${layer.index} ${layer.index === content.active ? "is-selected" : ""}`),
+        h.Style({ transform: model.flat ? "none" : `translateZ(${(layers.length - 1 - layer.index) * spacing}px)`, borderColor: layer.color })
+      ], [
+        h.div([h.Class("ensemble-layer-title"), h.Style({ color: layer.color })], [
+          h.strong([], [layer.title]), h.span([], [layer.caption])
+        ]),
+        layer.diagram
+      ])),
+      ...(!model.flat ? content.connectors ?? [] : [])
+    ]),
+    ...(!model.flat ? [h.div([h.Class("ensemble-gesture-hint")], ["Drag to rotate · wheel or pinch to zoom · touch: scroll vertically"])] : []),
+    ...(model.flat ? [h.div([h.Class("ensemble-orientation")], [content.orientation])] : [])
+  ])
+}
