+    children.push(h.h3([], [`${law.id} · ${law.name}`]), h.p([], [law.text]), h.p([], [h.strong([], ["Prevents: "]), law.prevents]),
+      h.p([], [h.strong([], [`${law.incidents.count.toLocaleString()} `]), law.incidents.label, ` (${law.incidents.source}).`]),
+      h.h4([], ["Guards in the Bend model"]),
+      h.ul([], guarded.map((g) => h.li([], [`${g.from === "*" ? "any state" : g.from} + ${g.event}: ${g.text}`]))))
+  } else if (selected.startsWith("edge:")) {
+    const route = routeById.get(selected)!
+    const from = stateMeta(route.machine, route.from)!, to = stateMeta(route.machine, route.to)!
+    children.push(h.h3([], [`${from.title} → ${to.title}`]),
+      h.p([], [`Events: ${route.events.join(", ")}. This edge exists because the compiled Bend moved a sample state along it (${projection.provenance.calls.toLocaleString()} checked calls); it also appears in the upstream Mermaid drawing.`]),
+      ...route.laws.map((id) => h.p([], [h.button([h.Type("button"), h.OnClick(Message.Selected({ id: `law:${id}` }))], [`${id} · ${laws.get(id)?.name}`]), ` — ${laws.get(id)?.text}`])))
+  } else {
+    const [, machine, raw] = selected.split(":")
+    const state = stateMeta(machine, Number(raw))!
+    const outgoing = [...routeById.values()].filter((r) => r.machine === machine && r.from === state.id)
+    children.push(h.h3([], [state.title]), h.p([], [state.owner]), h.p([], [state.summary]),
+      ...(machine === scenario.machine && Number(raw) === currentState(model) && valueDetail(machine, currentValue(model), scenario) ? [h.p([h.Class("fsm-value")], [`Now: ${valueDetail(machine, currentValue(model), scenario)}`])] : []),
+      h.h4([], ["Ways out (from the compiled Bend)"]),
