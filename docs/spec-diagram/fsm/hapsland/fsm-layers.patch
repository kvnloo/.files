+import { createHash } from "node:crypto"
+import { readFileSync } from "node:fs"
+import { dirname, resolve, sep } from "node:path"
+import { fileURLToPath } from "node:url"
+import { defineConfig } from "vite"
+
+const packageRoot = dirname(fileURLToPath(import.meta.url))
+const upstreamRoot = resolve(packageRoot, "../..")
+const diagramRoot = resolve(packageRoot, "../../../.files/docs/spec-diagram")
+const dotfilesRoot = resolve(diagramRoot, "../..")
+const requiredArtifacts = [
+  "Flow.bend", "model.json", "adapter.mjs", "build.mjs", "scenarios.json",
+  "Flow.generated.mjs", "projection.json", "architecture.json"
+] as const
+
+// Fail closed before Vite serves policy bytes. This is freshness, not deployment proof.
+function requireFreshReceipt() {
+  const receipt = JSON.parse(readFileSync(resolve(diagramRoot, "receipt.json"), "utf8")) as {
+    artifacts: Record<string, string>
+    sources: { path: string; sha256: string }[]
+  }
+  for (const name of requiredArtifacts) {
+    const expected = receipt.artifacts[name]
+    const actual = createHash("sha256").update(readFileSync(resolve(diagramRoot, name))).digest("hex")
+    if (typeof expected !== "string" || expected !== actual) {
+      throw new Error(`Stale .files diagram receipt for ${name}; regenerate with its existing build.mjs producer before launching Hapsland.`)
+    }
+  }
+  for (const source of receipt.sources) {
+    const path = resolve(dotfilesRoot, source.path)
+    if (!path.startsWith(`${dotfilesRoot}${sep}`)) throw new Error("Diagram receipt source escapes the .files checkout")
+    const actual = createHash("sha256").update(readFileSync(path)).digest("hex")
+    if (actual !== source.sha256) throw new Error(`Stale .files source receipt for ${source.path}; regenerate with build.mjs.`)
+  }
+}
+
+requireFreshReceipt()
+
+export default defineConfig({
+  root: packageRoot,
+  base: "./",
+  cacheDir: resolve(upstreamRoot, ".test-runs/vite-dotfiles"),
+  plugins: [{
+    name: "dotfiles-receipt-freshness",
+    configureServer(server) {
+      server.middlewares.use((request, _response, next) => {
+        try {
+          if (request.url?.includes("dotfiles") || request.url?.includes("spec-diagram")) requireFreshReceipt()
+          next()
+        } catch (error) {
+          next(error instanceof Error ? error : new Error(String(error)))
+        }
+      })
+    },
+    buildStart: requireFreshReceipt
+  }],
+  resolve: {
+    dedupe: ["effect", "foldkit"],
+    alias: [{ find: /^@dotfiles-diagram\//, replacement: `${diagramRoot}/` }]
+  },
+  server: {
+    host: "127.0.0.1", port: 4183, strictPort: true,
+    fs: { strict: true, allow: [packageRoot, resolve(upstreamRoot, "node_modules"), diagramRoot] }
+  },
+  preview: { host: "127.0.0.1", port: 4183, strictPort: true },
+  build: { outDir: resolve(upstreamRoot, ".test-runs/dotfiles-hapsland-dist"), rollupOptions: { input: resolve(packageRoot, "dotfiles.html") } }
+})
