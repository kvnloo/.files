+      last ? last.reason : "No event sent yet."
+    ]),
+    h.p([h.Class("progress")], [`${model.cursor} / ${scenario.steps.length} events · ${matches ? "every step matches the receipt-bound producer replay" : "MISMATCH with producer replay.json — do not trust this run"}`]),
