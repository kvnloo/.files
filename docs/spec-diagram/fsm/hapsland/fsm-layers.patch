+
+function lawRow(h: HtmlBuilder<Message>, law: Law) {
+  return h.tr([], [
+    h.th([h.Scope("row")], [h.button([h.Type("button"), h.OnClick(Message.Selected({ id: `law:${law.id}` }))], [law.id])]),
