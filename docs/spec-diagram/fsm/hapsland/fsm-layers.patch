+      ...(step.note ? [h.p([], [step.note])] : [])] : []),
+    ...(last ? [h.div([h.Class("canonical-commands")], [h.h3([], ["What Bend decided"]), h.ol([], last.outputs.map((o) => h.li([], [o.label])))])] : []),
+    ...(next ? [h.p([], [h.strong([], ["Next: "]), h.span([h.Class(`fsm-source ${next.source}`)], [next.source === "report" ? "REPORT" : "WHAT-IF"]), ` ${describeEvent(next.event, scenario)}`])] : []),
