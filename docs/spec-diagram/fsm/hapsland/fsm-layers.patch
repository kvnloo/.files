+/* The dashboard, ensemble, inspector, history and timeline use the production theme unchanged. */
+.dotfiles-camera { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: 1rem; }
+.dotfiles-canvas { touch-action: none; user-select: none; cursor: grab; }
+.dotfiles-canvas.dragging { cursor: grabbing; }
+.dotfiles-topology .topology-scroll { overflow: hidden; scrollbar-gutter: auto; }
+.dotfiles-topology .topology-scroll svg { width: 100%; min-width: 0; height: auto; }
+:is(.dotfiles-topology, .dotfiles-layer-topology) .topology-node.selected > rect { stroke: #245bb8; stroke-width: 4px; }
+:is(.dotfiles-topology, .dotfiles-layer-topology) .topology-route { cursor: pointer; }
+:is(.dotfiles-topology, .dotfiles-layer-topology) .topology-route:focus-visible path { stroke-width: 5px; opacity: 1; }
+:is(.dotfiles-topology, .dotfiles-layer-topology) .topology-route-label { paint-order: stroke; stroke: #fcfdff; stroke-width: 4px; stroke-linejoin: round; }
+.dotfiles-citations code, .dotfiles-receipt dd { overflow-wrap: anywhere; }
+.dotfiles-dashboard .simulation-stage-inspector select { max-width: 100%; }
+.dotfiles-dashboard .topology-route-key button { text-align: left; }
+@media (max-width: 700px) {
+  .dotfiles-topology .topology-node text:nth-of-type(2) { font-size: 12px; }
+  .dotfiles-topology .topology-route-label { font-size: 10px; }
+}
