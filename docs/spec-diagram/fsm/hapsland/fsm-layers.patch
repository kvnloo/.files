index 0000000..bfb097d
--- /dev/null
+++ w/packages/agent-flow-viz/src/fsm/projection.ts
@@ -0,0 +1,231 @@
+import modelText from "@fsm-diagram/model.json?raw"
+import scenarioText from "@fsm-diagram/scenarios.json?raw"
+import projectionText from "@fsm-diagram/projection.json?raw"
+import replayText from "@fsm-diagram/replay.json?raw"
+import receiptText from "@fsm-diagram/receipt.json?raw"
+import type { Json } from "@fsm-diagram/adapter.mjs"
+
+export type Point = { readonly x: number; readonly y: number }
+export type Placement = Point & { readonly width: number; readonly height: number }
+export type StateMeta = {
+  readonly id: number; readonly tag: string; readonly machine: string; readonly owner: string
+  readonly title: string; readonly summary: string; readonly point: Point; readonly terminal?: boolean
+}
+export type Law = {
+  readonly id: string; readonly loop: string; readonly name: string; readonly text: string; readonly prevents: string
+  readonly incidents: { readonly count: number; readonly label: string; readonly source: string }
+}
+export type Guard = { readonly machine: string; readonly from: string; readonly event: string; readonly laws: readonly string[]; readonly text: string }
+export type Plane = {
+  readonly id: string; readonly title: string; readonly owner: string; readonly color: string; readonly machines: readonly string[]
+  readonly summary: string; readonly width: number; readonly height: number
+  readonly lawCards?: readonly { readonly law: string; readonly point: Point }[]
+}
+type FsmModel = {
+  readonly title: string; readonly scope: string; readonly trustBoundary: string
+  readonly machines: Readonly<Record<string, { readonly title: string; readonly step: string; readonly plane: string }>>
+  readonly types: Readonly<Record<string, { readonly ctors?: Readonly<Record<string, unknown>> }>>
+  readonly states: Readonly<Record<string, readonly StateMeta[]>>
+  readonly laws: readonly Law[]; readonly guards: readonly Guard[]; readonly planes: readonly Plane[]
+  readonly nodeSize: { readonly width: number; readonly height: number }
+  readonly curves: Readonly<Record<string, Readonly<Record<string, number | readonly (readonly [number, number])[]>>>>
+  readonly roles: readonly { readonly id: string; readonly who: string; readonly note: string }[]
+  readonly explainer: { readonly intro: string; readonly loops: readonly string[]; readonly statechart: string; readonly roles: string }
+  readonly sources: readonly { readonly path: string; readonly upstream: string; readonly gitBlob: string }[]
+  readonly proofs: readonly { readonly project: string; readonly pr: string; readonly commit: string; readonly verdict: string; readonly bend: string; readonly verifiedAt: string; readonly scope: string }[]
+}
+export type Step = { readonly event: Json & { readonly tag: string }; readonly facts: Readonly<Record<string, Json>>; readonly note: string; readonly source: "report" | "what-if"; readonly at?: string | null }
+export type Scenario = {
+  readonly id: string; readonly machine: string; readonly title: string; readonly summary: string; readonly item: string
+  readonly initial: Json; readonly actors: Readonly<Record<string, string>>; readonly shas?: Readonly<Record<string, string>>
+  readonly steps: readonly Step[]
+}
+export type Edge = { readonly machine: string; readonly from: number; readonly to: number; readonly event: string; readonly laws: readonly string[] }
+
+export const fsm: FsmModel = JSON.parse(modelText)
+const scenarioFile: { readonly scenarios: readonly Scenario[]; readonly provenance: Readonly<Record<string, Json>> } = JSON.parse(scenarioText)
+export const scenarios = scenarioFile.scenarios
+export const tapeProvenance = scenarioFile.provenance
+export const projection: {
+  readonly edges: readonly Edge[]; readonly selfLoops: readonly Edge[]
+  readonly documentedComparison: { readonly documentedEdges: number; readonly documentedNotProducedByBend: readonly Edge[]; readonly producedByBendNotDocumented: readonly Edge[] }
+  readonly provenance: { readonly calls: number; readonly scope: string }
+} = JSON.parse(projectionText)
+export const producerReplay: readonly { readonly id: string; readonly steps: readonly { readonly state: number; readonly verdict: string }[] }[] = JSON.parse(replayText)
+export const receipt: {
+  readonly generatedAt: string; readonly compiler: { readonly version: string; readonly executableSha256: string }
+  readonly artifacts: Readonly<Record<string, string>>; readonly rawCompilerOutputSha256: string
+} = JSON.parse(receiptText)
+
+export const laws = new Map(fsm.laws.map((law) => [law.id, law]))
+export const planes = fsm.planes
+export const planeIndexForMachine = (machine: string) => planes.findIndex((plane) => plane.machines.includes(machine))
+export const stateMeta = (machine: string, id: number) => fsm.states[machine]?.find((state) => state.id === id)
+export const nodeId = (machine: string, id: number) => `node:${machine}:${id}`
+export const eventTags = (machine: string) => Object.keys(fsm.types[machine === "work-item" ? "WorkItem.Ev"
+  : machine === "worker" ? "WorkerSupervision.Ev" : machine === "lease" ? "WorkerSupervision.LEv" : "WorkerSupervision.PEv"].ctors ?? {})
+
+/** One drawn route per (machine, from, to); several Bend events can share it. */
+export type Route = { readonly id: string; readonly machine: string; readonly from: number; readonly to: number; readonly events: readonly string[]; readonly laws: readonly string[] }
+export const routes: readonly Route[] = (() => {
+  const grouped = new Map<string, { machine: string; from: number; to: number; events: string[]; laws: Set<string> }>()
+  for (const edge of projection.edges) {
+    const key = `${edge.machine}:${edge.from}>${edge.to}`
+    const entry = grouped.get(key) ?? { machine: edge.machine, from: edge.from, to: edge.to, events: [], laws: new Set<string>() }
+    if (!entry.events.includes(edge.event)) entry.events.push(edge.event)
+    edge.laws.forEach((law) => entry.laws.add(law))
+    grouped.set(key, entry)
+  }
+  return [...grouped.entries()].map(([id, e]) => ({ id: `edge:${id}`, machine: e.machine, from: e.from, to: e.to, events: e.events, laws: [...e.laws].sort() }))
+})()
+export const routeById = new Map(routes.map((route) => [route.id, route]))
+
+// Phone layout: two columns, main path on the right, side exits on the left.
+const mobileSlots: Readonly<Record<string, readonly (readonly [string, number, number])[]>> = {
+  "work-item": [["Proposed", 0, 0], ["Claimed", 1, 0], ["Abandoned", 0, 1], ["Implementing", 1, 1], ["Interrupted", 0, 2], ["Verifying", 1, 2],
+    ["Blocked", 0, 3], ["DraftPR", 1, 3], ["Merged", 0, 4], ["Integrated", 1, 4], ["Accepted", 0, 5], ["Deployed", 1, 5]],
+  worker: [["Dispatched", 0, 0], ["Running", 1, 0], ["Stalled", 0, 1], ["Completed", 1, 1], ["Interrupted", 0, 2], ["Integrated", 1, 2],
+    ["Overdue", 0, 3], ["Resumed", 1, 3], ["Abandoned", 0, 4]],
+  lease: [["Free", 0, 0], ["Held", 1, 0]],
+  device: [["free-unknown", 0, 1], ["free-seen", 1, 1], ["held-unknown", 0, 2], ["held-seen", 1, 2]]
+}
+const mobileLawSlots: readonly (readonly [number, number])[] = [[0, 3], [1, 3], [0, 4], [1, 4], [0, 5], [1, 5]]
+
+export interface PlaneLayout {
+  readonly places: Map<string, Placement>
+  readonly lawPlaces: Map<string, Placement>
+  readonly routes: readonly Route[]
+  readonly width: number
+  readonly height: number
+}
+
+export function planeLayout(index: number, mobile: boolean): PlaneLayout {
+  const plane = planes[index]
+  const places = new Map<string, Placement>()
+  const lawPlaces = new Map<string, Placement>()
+  const size = mobile ? { width: 180, height: 70 } : fsm.nodeSize
+  let rows = 0
+  for (const machine of plane.machines) {
+    for (const state of fsm.states[machine]) {
+      if (mobile) {
+        const slot = mobileSlots[machine].find(([tag]) => tag === state.tag)!
+        rows = Math.max(rows, slot[2] + 1)
+        places.set(nodeId(machine, state.id), { x: 8 + slot[1] * 202, y: 14 + slot[2] * 104, ...size })
+      } else places.set(nodeId(machine, state.id), { ...state.point, ...size })
+    }
+  }
+  plane.lawCards?.forEach((card, i) => {
+    if (mobile) {
+      const [col, row] = mobileLawSlots[i]
+      rows = Math.max(rows, row + 1)
+      lawPlaces.set(card.law, { x: 8 + col * 202, y: 14 + row * 104, ...size })
+    } else lawPlaces.set(card.law, { ...card.point, ...size })
+  })
+  return {
+    places, lawPlaces, routes: routes.filter((route) => plane.machines.includes(route.machine)),
+    width: mobile ? 398 : plane.width, height: mobile ? 14 + rows * 104 : plane.height
+  }
+}
+
+const border = (box: Placement, toward: Point): Point => {
+  const c = { x: box.x + box.width / 2, y: box.y + box.height / 2 }
+  const dx = toward.x - c.x, dy = toward.y - c.y
+  const t = Math.min(dx === 0 ? Infinity : (box.width / 2 + 3) / Math.abs(dx), dy === 0 ? Infinity : (box.height / 2 + 3) / Math.abs(dy))
+  return { x: c.x + dx * t, y: c.y + dy * t }
+}
+
+/** Straight route, or a quadratic bend when declared or when a reverse route exists. */
+export function routeGeometry(route: Route, layout: PlaneLayout, mobile: boolean) {
+  const a = layout.places.get(nodeId(route.machine, route.from))!
+  const b = layout.places.get(nodeId(route.machine, route.to))!
+  const ac = { x: a.x + a.width / 2, y: a.y + a.height / 2 }
+  const bc = { x: b.x + b.width / 2, y: b.y + b.height / 2 }
+  const fromTag = stateMeta(route.machine, route.from)!.tag, toTag = stateMeta(route.machine, route.to)!.tag
+  const reverse = layout.routes.some((r) => r.machine === route.machine && r.from === route.to && r.to === route.from)
+  const declared = mobile ? undefined : fsm.curves[route.machine]?.[`${fromTag}>${toTag}`]
+  if (Array.isArray(declared)) {
+    // Explicit lane: a polyline through declared waypoints (kept clear of other boxes).
+    const via = declared.map(([x, y]) => ({ x, y }))
+    const start = border(a, via[0])
+    const end = border(b, via[via.length - 1])
+    const points = [start, ...via, end]
+    const middle = Math.floor((points.length - 1) / 2)
+    const at = { x: (points[middle].x + points[middle + 1].x) / 2, y: (points[middle].y + points[middle + 1].y) / 2 }
+    return {
+      path: points.map((p, i) => `${i ? "L" : "M"} ${p.x} ${p.y}`).join(" "), tip: end,
+      toward: { x: end.x - via[via.length - 1].x, y: end.y - via[via.length - 1].y }, badge: at, labelPoint: { x: at.x, y: at.y - 15 }
+    }
+  }
+  const offset = typeof declared === "number" ? declared : reverse ? 18 : 0
+  const mid = { x: (ac.x + bc.x) / 2, y: (ac.y + bc.y) / 2 }
+  const len = Math.hypot(bc.x - ac.x, bc.y - ac.y) || 1
+  const normal = { x: -(bc.y - ac.y) / len, y: (bc.x - ac.x) / len }
+  const control = { x: mid.x + normal.x * offset * 2, y: mid.y + normal.y * offset * 2 }
+  const start = border(a, offset ? control : bc)
+  const end = border(b, offset ? control : ac)
+  const path = offset ? `M ${start.x} ${start.y} Q ${control.x} ${control.y} ${end.x} ${end.y}` : `M ${start.x} ${start.y} L ${end.x} ${end.y}`
+  const toward = offset ? { x: end.x - control.x, y: end.y - control.y } : { x: end.x - start.x, y: end.y - start.y }
+  const at = offset ? { x: 0.25 * start.x + 0.5 * control.x + 0.25 * end.x, y: 0.25 * start.y + 0.5 * control.y + 0.25 * end.y }
+    : { x: (start.x + end.x) / 2, y: (start.y + end.y) / 2 }
+  // Curved routes put their label on the outside of the bend so paired routes never share a label spot.
+  const side = Math.sign(offset)
+  const labelPoint = side === 0 ? { x: at.x, y: at.y - 15 }
+    : { x: at.x + normal.x * side * (Math.abs(normal.x) * 40 + 16), y: at.y + normal.y * side * 18 + (normal.y * side > 0 ? 8 : 0) }
+  return { path, tip: end, toward, badge: at, labelPoint }
+}
+
+/** Short value detail under a node title (presentation of the Bend state value). */
+export function valueDetail(machine: string, value: Json, scenario: Scenario): string {
+  if (value === null || typeof value !== "object" || Array.isArray(value)) return ""
+  const v = value as Readonly<Record<string, Json>>
+  const actor = (a: Json) => {
+    const x = a as Readonly<Record<string, Json>>
+    return `${scenario.actors[String(x.id)] ?? `#${x.id}`} (${x.role})`
+  }
+  const sha = (n: Json) => scenario.shas?.[String(n)] ?? (n === 0 ? "none" : `sha#${n}`)
+  const parts: string[] = []
+  if (machine === "work-item") {
+    if (v.au) parts.push(`author ${actor(v.au)}`)
+    if (v.hd !== undefined) parts.push(`head ${sha(v.hd)}`)
+    if (v.ig !== undefined) parts.push(`integrated ${sha(v.ig)}`)
+    if (v.dp !== undefined) parts.push(`served ${sha(v.dp)}`)
+    if (v.ap) parts.push(`accepted by ${actor(v.ap)}`)
+  } else if (machine === "worker") {
+    const w = v.w as Readonly<Record<string, Json>>
+    parts.push(`${w.load}${w.exc === "NoExc" ? "" : ` + ${w.exc} exception`}`)
+    if (v.h) parts.push(`on ${v.h}`)
+    if (v.hb !== undefined) parts.push(`last beat t+${v.hb} min`)
+    if (v.at !== undefined) parts.push(`interrupted t+${v.at} min`)
+    if (v.bg !== undefined) parts.push(`${v.bg} background`)
+    if (v.by !== undefined) parts.push(`by ${scenario.actors[String(v.by)] ?? `#${v.by}`}`)
+  } else if (machine === "lease") {
+    if (v.o !== undefined) parts.push(scenario.actors[String(v.o)] ?? `holder #${v.o}`)
+  } else {
+    const lk = v.lk as Readonly<Record<string, Json>>, fg = v.fg as Readonly<Record<string, Json>>
+    parts.push(lk.tag === "Held" ? `lock: session ${lk.o}` : "lock free", fg.tag === "Seen" ? `foreground: app ${fg.app}` : "foreground unknown")
+  }
+  return parts.join(" · ")
+}
+
+export const describeEvent = (event: Json, scenario: Scenario): string => {
+  const e = event as Readonly<Record<string, Json>>
+  const actor = (a: Json) => {
+    const x = a as Readonly<Record<string, Json>>
+    return typeof a === "number" ? scenario.actors[String(a)] ?? `#${a}` : `${scenario.actors[String(x.id)] ?? `#${x.id}`} (${x.role})`
+  }
+  const sha = (n: Json) => scenario.shas?.[String(n)] ?? `sha#${n}`
+  const bits: string[] = []
+  if (e.a !== undefined) bits.push(`by ${actor(e.a)}`)
+  if (e.sha !== undefined) bits.push(`sha ${sha(e.sha)}`)
+  if (e.ish !== undefined) bits.push(`into ${sha(e.ish)}`)
+  if (e.served !== undefined) bits.push(`serving ${sha(e.served)}`)
+  if (e.r) { const r = e.r as Readonly<Record<string, Json>>; bits.push(`receipt ${r.pass ? "pass" : "fail"} @ ${sha(r.sha)}`) }
+  if (e.h) bits.push(`on ${e.h}`)
+  if (e.t !== undefined) bits.push(`t+${e.t} min`)
+  if (e.now !== undefined) bits.push(`clock t+${e.now} min`)
+  if (e.by !== undefined) bits.push(`successor ${scenario.actors[String(e.by)] ?? `#${e.by}`}`)
+  if (e.log !== undefined) bits.push(e.log ? "read the log" : "did NOT read the log")
+  if (e.app !== undefined) bits.push(`app ${e.app}`)
+  if (e.dead !== undefined) bits.push(e.dead ? "holder proven dead" : "no evidence holder is dead")
+  return `${e.tag}${bits.length ? ` (${bits.join(", ")})` : ""}`
+}
