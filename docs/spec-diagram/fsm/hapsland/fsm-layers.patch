@@ -0,0 +1,187 @@
+import architectureText from "@dotfiles-diagram/architecture.json?raw"
+import modelText from "@dotfiles-diagram/model.json?raw"
+import scenarioText from "@dotfiles-diagram/scenarios.json?raw"
+import receiptText from "@dotfiles-diagram/receipt.json?raw"
+
+export type Citation = { readonly path: string; readonly symbol: string }
+export type Concept = {
+  readonly id: string; readonly group: string; readonly title: string; readonly owner: string
+  readonly summary: string; readonly kind: string; readonly citations: readonly Citation[]; readonly states: readonly number[]
+}
+export type Relationship = {
+  readonly id: string; readonly from: string; readonly to: string; readonly label: string
+  readonly kind: string; readonly status: string; readonly citations: readonly Citation[]
+}
+type Architecture = {
+  readonly nodes: readonly Concept[]; readonly edges: readonly Relationship[]
+  readonly stateToNode: readonly { readonly state: number; readonly node: string }[]
+}
+export type Scenario = {
+  readonly id: string; readonly title: string; readonly summary: string; readonly initialState: number
+  readonly steps: readonly { readonly event: number; readonly facts: Readonly<Record<string, boolean>>; readonly note: string }[]
+}
+const architecture: Architecture = JSON.parse(architectureText)
+export const architectureData = architecture
+export const policyModel: {
+  readonly states: readonly { readonly id: number; readonly title: string }[]
+  readonly events: readonly { readonly id: number; readonly title: string }[]
+  readonly trustBoundary: string
+} = JSON.parse(modelText)
+export const scenarios: readonly Scenario[] = JSON.parse(scenarioText)
+export const receipt: {
+  readonly generatedAt: string; readonly compiler: { readonly version: string }
+  readonly artifacts: Readonly<Record<string, string>>
+} = JSON.parse(receiptText)
+export type Focus = "overview" | "onboarding" | "k3s"
+export type Point = { readonly x: number; readonly y: number }
+export type Placement = Point & { readonly width: number; readonly height: number }
+export interface ArchitectureLayout {
+  readonly places: Map<string, Placement>
+  readonly edges: readonly Relationship[]
+  readonly width: number
+  readonly height: number
+}
+
+export const conceptForState = (state: number) => architecture.stateToNode.find((item) => item.state === state)?.node
+export const concepts = new Map(architecture.nodes.map((node) => [node.id, node]))
+export const relationships = new Map(architecture.edges.map((edge) => [edge.id, edge]))
+
+const presentation: Record<string, readonly [string, string, string]> = {
+  phone: ["Phone · Tern / OMP", "CONTROLLER", "No server credentials"],
+  transport: ["Private access", "AUTHENTICATION", "Verify host identity"],
+  groot: ["Groot · native host", "HOST OWNER", "Storage / admin / network"],
+  checkout: [".files checkout", "DESIRED CONFIG", "Reviewed source, not state"],
+  onboarding: ["Status → consent", "ORDINARY SETUP", "Ask, select, or defer"],
+  modules: ["Shared modules", "APPROVED SELECTION", "Links · fonts · agent skills"],
+  preflight: ["K3s opt-in / check", "SEPARATE APPROVAL", "Read-only before apply"],
+  k3s: ["Private K3s server", "DESIRED · NOT INSTALLED", "CPU · SQLite · containerd"],
+  boundary: ["Namespace guardrails", "SEPARATE MANIFEST APPLY", "PSA · quota · deny traffic"],
+  "cpu-job": ["Bounded CPU Job", "RESTRICTED WORKLOAD", "No token · limits · deadline"],
+  evidence: ["Private evidence", "OBSERVATION BOUNDARY", "Results · controls · TTL"],
+  factory: ["Factory / human", "EXTERNAL AUTHORITY", "Claims · work orders · HITL"],
+  macbook: ["MacBook · client", "EXISTING CLIENT", "No server / admin copy"],
+  "deferred-capacity": ["Later agent / GPU", "DEFERRED · NOT INSTALLED", "Separate design + approval"]
+}
+export const conceptPresentation = (id: string) => presentation[id]
+
+const shortLabels: Record<string, string> = {
+  "phone-access": "Saved host", "macbook-access": "Client access", "desktop-auth": "Authenticate",
+  "host-checkout": "Reviewed checkout", "checkout-onboard": "Setup contract", "onboard-modules": "Approved selection",
+  "modules-host": "Configure host", "host-preflight": "Separate opt-in", "checkout-preflight": "Server defaults",
+  "preflight-server": "Check → approved apply", "host-server": "Owns private runtime", "server-boundary": "Separate apply",
+  "boundary-job": "Constrain Pods", "server-job": "Schedule / run", "factory-work": "Claims / HITL",
+  "job-evidence": "Results + logs", "boundary-evidence": "Test controls", "ttl-evidence": "Observe TTL",
+  "evidence-phone": "Read private logs", "future-agent": "Later approval"
+}
+export const relationshipLabel = (id: string) => shortLabels[id]
+
+/** Explicit specification regions, not workers or independently simulated runtimes. */
+export const specificationLayers = [
+  { id: "access", title: "Clients & host", owner: "ACCESS / HOST OWNERSHIP", color: "#386eb1",
+    summary: "Clients authenticate to the host; neither client becomes the private server.",
+    nodes: ["phone", "macbook", "transport", "groot"] },
+  { id: "setup", title: "Ordinary setup", owner: "CHECKOUT / APPROVED MODULES", color: "#31836a",
+    summary: "Reviewed desired configuration, explicit consent and shared module selection.",
+    nodes: ["checkout", "onboarding", "modules"] },
+  { id: "runtime", title: "Opt-in runtime", owner: "PREFLIGHT / RESTRICTED WORK", color: "#79559c",
+    summary: "Separate K3s opt-in, guardrails and bounded CPU work. Desired design, not installed.",
+    nodes: ["preflight", "k3s", "boundary", "cpu-job"] },
+  { id: "evidence", title: "Evidence & authority", owner: "PRIVATE RESULTS / HUMAN BOUNDARY", color: "#a4772e",
+    summary: "Private observations and external human authority; future capacity stays deferred.",
+    nodes: ["factory", "evidence", "deferred-capacity"] }
+] as const
+
+export function specificationLayerLayout(index: number) {
+  const layer = specificationLayers[index]
+  const places = new Map<string, Placement>(layer.nodes.map((id, position) => [id, {
+    x: position % 2 === 0 ? 28 : 448, y: position < 2 ? 44 : 292, width: 310, height: 116
+  }]))
+  const edges = architecture.edges.filter((edge) => places.has(edge.from) && places.has(edge.to))
+  return { places, edges, width: 830, height: 505 }
+}
+
+// Coordinates are a .files architectural presentation, not another policy model.
+const compactOverview = [
+  ["phone", 18, 18], ["transport", 218, 18], ["checkout", 18, 150], ["groot", 218, 150],
+  ["onboarding", 18, 282], ["modules", 218, 282], ["preflight", 18, 414], ["k3s", 218, 414],
+  ["boundary", 18, 546], ["cpu-job", 218, 546], ["factory", 18, 678], ["evidence", 218, 678],
+  ["macbook", 18, 810], ["deferred-capacity", 218, 810]
+] as const
+const compactOnboarding = [
+  ["phone", 18, 24], ["transport", 218, 24], ["checkout", 18, 194], ["groot", 218, 194],
+  ["onboarding", 18, 364], ["modules", 218, 364]
+] as const
+const compactK3s = [
+  ["groot", 18, 18], ["preflight", 218, 18], ["boundary", 18, 150], ["k3s", 218, 150],
+  ["cpu-job", 18, 282], ["evidence", 218, 282], ["factory", 18, 414], ["deferred-capacity", 218, 414]
+] as const
+const desktop = [
+  ["phone", 30, 30], ["transport", 290, 30], ["groot", 550, 30], ["checkout", 810, 30], ["macbook", 1070, 30],
+  ["factory", 30, 260], ["k3s", 290, 260], ["preflight", 550, 260], ["onboarding", 810, 260], ["modules", 1070, 260],
+  ["deferred-capacity", 30, 490], ["boundary", 290, 490], ["cpu-job", 550, 490], ["evidence", 810, 490]
+] as const
+
+export function layout(focus: string, mobile: boolean) {
+  const compact = focus === "onboarding" ? compactOnboarding : focus === "k3s" ? compactK3s : compactOverview
+  const ids = new Set<string>(compact.map(([id]) => id))
+  const entries = mobile ? compact : focus === "overview" ? desktop : desktop.filter(([id]) => ids.has(id))
+  const places = new Map<string, Placement>(entries.map(([id, x, y]) => [id, { x, y, width: mobile ? 162 : 216, height: mobile ? 78 : 104 }]))
+  const edges = architecture.edges.filter((edge) => places.has(edge.from) && places.has(edge.to))
+  return { places, edges, width: mobile ? 398 : 1320, height: mobile ? (focus === "overview" ? 910 : 514) : 664 }
+}
+
+// Only a checked accepted transition can light an existing matching relationship.
+// State changes within a concept stay there; absent structural arrows are not invented.
+export function activeRelationship(before: number, after: number, accepted: boolean) {
+  if (!accepted) return undefined
+  const from = conceptForState(before)
+  const to = conceptForState(after)
+  if (from === to) return undefined
+  return architecture.edges.find((edge) => edge.from === from && edge.to === to)?.id
+}
+
+export function routePlacement(edge: Relationship, places: Map<string, Placement>, mobile: boolean) {
+  const a = places.get(edge.from)!
+  const b = places.get(edge.to)!
+  const ac = { x: a.x + a.width / 2, y: a.y + a.height / 2 }
+  const bc = { x: b.x + b.width / 2, y: b.y + b.height / 2 }
+  let points: Point[]
+  if (Math.abs(ac.y - bc.y) < 1) {
+    const right = ac.x < bc.x
+    const start = { x: right ? a.x + a.width : a.x, y: ac.y }
+    const end = { x: right ? b.x : b.x + b.width, y: bc.y }
+    if (Math.abs(ac.x - bc.x) > a.width * 2) {
+      const lane = Math.max(8, Math.min(a.y, b.y) - (edge.id === "macbook-access" ? 17 : 9))
+      points = [start, { x: start.x, y: lane }, { x: end.x, y: lane }, end]
+    } else points = [start, end]
+  } else if (Math.abs(ac.x - bc.x) < 1) {
+    const down = ac.y < bc.y
+    const start = { x: ac.x, y: down ? a.y + a.height : a.y }
+    const end = { x: bc.x, y: down ? b.y : b.y + b.height }
+    if (Math.abs(ac.y - bc.y) > a.height * 2.6) {
+      const lane = mobile ? (ac.x > 200 ? 384 : 14) : a.x - 16
+      points = [start, { x: lane, y: start.y + (down ? 14 : -14) }, { x: lane, y: end.y + (down ? -14 : 14) }, end]
+    } else points = [start, end]
+  } else {
+    const down = ac.y < bc.y
+    const start = { x: ac.x, y: down ? a.y + a.height : a.y }
+    const end = { x: bc.x, y: down ? b.y : b.y + b.height }
+    let lane = (start.y + end.y) / 2
+    if (edge.id === "boundary-evidence") lane = a.y - 28
+    if (edge.id === "server-job") lane = a.y + a.height + 24
+    points = [start, { x: start.x, y: lane }, { x: end.x, y: lane }, end]
+  }
+  const middle = points.length === 2
+    ? { x: (points[0].x + points[1].x) / 2, y: (points[0].y + points[1].y) / 2 }
+    : { x: (points[1].x + points[2].x) / 2, y: (points[1].y + points[2].y) / 2 }
+  const tip = points[points.length - 1]
+  const prior = points[points.length - 2]
+  return {
+    path: points.map((p, index) => `${index === 0 ? "M" : "L"} ${p.x} ${p.y}`).join(" "),
+    tip, toward: { x: tip.x - prior.x, y: tip.y - prior.y }, badge: middle,
+    labelPoint: {
+      x: mobile ? Math.max(78, Math.min(320, middle.x)) : middle.x,
+      y: Math.abs(ac.y - bc.y) < 1 && points.length === 2 ? a.y - 8 : middle.y - 16
+    }
+  }
+}
