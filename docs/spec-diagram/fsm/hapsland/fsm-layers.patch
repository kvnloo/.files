index 0000000..1bb0dba
--- /dev/null
+++ w/packages/agent-flow-viz/src/dotfiles/model.ts
@@ -0,0 +1,110 @@
+import { Schema } from "effect"
+import { type Runtime, type Update } from "foldkit"
+import { defineMessageUnion } from "foldkit/message"
+import { transition } from "@dotfiles-diagram/adapter.mjs"
+import { scenarios } from "./projection"
+import { orbitEnsembleCamera, zoomEnsembleCamera } from "../ensemble-presentation"
+
+const Outcome = Schema.Struct({
+  before: Schema.Number, state: Schema.Number, event: Schema.Number, accepted: Schema.Boolean, reason: Schema.String,
+  outputs: Schema.Array(Schema.Struct({ kind: Schema.String, code: Schema.Number, label: Schema.String }))
+})
+const Camera = Schema.Struct({
+  tilt: Schema.String, turn: Schema.String, spacing: Schema.String, zoom: Schema.String,
+  cameraEpoch: Schema.Number, flat: Schema.Boolean
+})
+const initialCamera = { tilt: "48", turn: "-16", spacing: "130", zoom: "72", cameraEpoch: 0, flat: false }
+export const Model = Schema.Struct({
+  mobile: Schema.Boolean, focus: Schema.String, selected: Schema.String, active: Schema.Number,
+  scenario: Schema.Number, cursor: Schema.Number, state: Schema.Number,
+  last: Schema.NullOr(Outcome), history: Schema.Array(Outcome), replayStarted: Schema.Boolean,
+  playing: Schema.Boolean, elapsed: Schema.Number, timelineEpoch: Schema.Number, refusalsOnly: Schema.Boolean,
+  camera: Camera,
+  zoom: Schema.Number, panX: Schema.Number, panY: Schema.Number,
+  dragging: Schema.Boolean, dragX: Schema.Number, dragY: Schema.Number, dragScale: Schema.Number
+})
+export type Model = typeof Model.Type
+export const Message = defineMessageUnion({
+  Focused: { focus: Schema.String }, Selected: { id: Schema.String }, Responsive: { mobile: Schema.Boolean },
+  LayerSelected: { index: Schema.Number }, CameraChanged: { field: Schema.String, raw: Schema.String },
+  CameraZoomed: { factor: Schema.Number }, CameraRotated: { dx: Schema.Number, dy: Schema.Number },
+  CameraReset: {}, FlatToggled: {}, PlayToggled: {}, PlaybackTick: { deltaMs: Schema.Number },
+  ScenarioSelected: { index: Schema.Number }, Next: {}, Reset: {},
+  Seek: { position: Schema.Number, scrub: Schema.Boolean }, RefusalsToggled: {},
+  Zoomed: { factor: Schema.Number }, Fit: {}, Panned: { dx: Schema.Number, dy: Schema.Number },
+  DragStarted: { x: Schema.Number, y: Schema.Number, scale: Schema.Number },
+  Dragged: { x: Schema.Number, y: Schema.Number }, DragEnded: {}
+})
+export type Message = typeof Message.Type
+export const init: Runtime.ApplicationInit<Model, Message> = () => ({ model: {
+  mobile: window.matchMedia("(max-width: 700px)").matches, focus: "overview", selected: "", active: 0,
+  scenario: 0, cursor: 0, state: scenarios[0].initialState, last: null, replayStarted: false, history: [],
+  playing: false, elapsed: 0, timelineEpoch: 0, refusalsOnly: false, camera: initialCamera,
+  zoom: 1, panX: 0, panY: 0, dragging: false, dragX: 0, dragY: 0, dragScale: 1
+} })
+
+/** Seeking records missing checked results once and preserves the recorded future. */
+const seekHistory = (model: Model, requested: number, scrub = false): Model => {
+  const scenario = scenarios[model.scenario]
+  const cursor = Math.max(0, Math.min(scenario.steps.length, Math.trunc(requested)))
+  if (!Number.isFinite(cursor)) return model
+  let history = model.history
+  if (cursor > history.length) {
+    const extended = [...history]
+    let state = extended.at(-1)?.state ?? scenario.initialState
+    for (let index = extended.length; index < cursor; index++) {
+      const step = scenario.steps[index]
+      // The actual compiled .files Bend reducer is the only transition authority.
+      const outcome = transition(state, step.event, step.facts)
+      extended.push(outcome)
+      state = outcome.state
+    }
+    history = extended
+  }
+  const last = history[cursor - 1] ?? null
+  return { ...model, history, cursor, state: last?.state ?? scenario.initialState, last,
+    replayStarted: cursor > 0, timelineEpoch: model.timelineEpoch + (scrub ? 0 : 1),
+    playing: model.playing && cursor < scenario.steps.length }
+}
+
+export const update = (model: Model, message: Message): Update.Return<Model, Message> =>
+  Message.match(message, {
+    Focused: ({ focus }) => ({ model: { ...model, focus, zoom: 1, panX: 0, panY: 0 } }),
+    Selected: ({ id }) => ({ model: { ...model, selected: model.selected === id ? "" : id } }),
+    Responsive: ({ mobile }) => ({ model: { ...model, mobile, zoom: 1, panX: 0, panY: 0 } }),
+    LayerSelected: ({ index }) => ({ model: { ...model, active: index, selected: "" } }),
+    CameraChanged: ({ field, raw }) => ({ model: ["tilt", "turn", "spacing", "zoom"].includes(field)
+      ? { ...model, camera: { ...model.camera, [field]: raw } } : model }),
+    CameraZoomed: ({ factor }) => ({ model: { ...model, camera: zoomEnsembleCamera(model.camera, factor) } }),
+    CameraRotated: ({ dx, dy }) => ({ model: { ...model, camera: orbitEnsembleCamera(model.camera, dx, dy) } }),
+    CameraReset: () => ({ model: { ...model, camera: { ...initialCamera, cameraEpoch: model.camera.cameraEpoch + 1 } } }),
+    FlatToggled: () => ({ model: { ...model, camera: { ...model.camera, flat: !model.camera.flat } } }),
+    PlayToggled: () => ({ model: { ...model, playing: !model.playing && model.cursor < scenarios[model.scenario].steps.length, elapsed: 0 } }),
+    PlaybackTick: ({ deltaMs }) => {
+      if (!model.playing) return { model }
+      const elapsed = model.elapsed + deltaMs
+      if (elapsed < 900) return { model: { ...model, elapsed } }
+      return { model: seekHistory({ ...model, elapsed: 0 }, model.cursor + 1) }
+    },
+    ScenarioSelected: ({ index }) => ({ model: scenarios[index] ? {
+      ...model, scenario: index, cursor: 0, state: scenarios[index].initialState, last: null, replayStarted: false,
+      history: [], playing: false, elapsed: 0, timelineEpoch: model.timelineEpoch + 1
+    } : model }),
+    Next: () => ({ model: seekHistory({ ...model, playing: false }, model.cursor + 1) }),
+    Seek: ({ position, scrub }) => ({ model: seekHistory({ ...model, playing: false }, position, scrub) }),
+    Reset: () => ({ model: {
+      ...model, cursor: 0, state: scenarios[model.scenario].initialState, last: null, replayStarted: false,
+      history: [], playing: false, elapsed: 0, timelineEpoch: model.timelineEpoch + 1
+    } }),
+    RefusalsToggled: () => ({ model: { ...model, refusalsOnly: !model.refusalsOnly } }),
+    Zoomed: ({ factor }) => ({ model: { ...model, zoom: Math.min(3, Math.max(1, model.zoom * factor)) } }),
+    Fit: () => ({ model: { ...model, zoom: 1, panX: 0, panY: 0 } }),
+    Panned: ({ dx, dy }) => ({ model: { ...model, panX: model.panX + dx / model.zoom, panY: model.panY + dy / model.zoom } }),
+    DragStarted: ({ x, y, scale }) => ({ model: { ...model, dragging: true, dragX: x, dragY: y, dragScale: scale } }),
+    Dragged: ({ x, y }) => ({ model: model.dragging ? {
+      ...model, dragX: x, dragY: y,
+      panX: model.panX - (x - model.dragX) * model.dragScale / model.zoom,
+      panY: model.panY - (y - model.dragY) * model.dragScale / model.zoom
+    } : model }),
+    DragEnded: () => ({ model: { ...model, dragging: false } })
+  })
