+const stateTitle = (id: number) => policyModel.states.find((state) => state.id === id)?.title ?? String(id)
+const eventTitle = (id: number) => policyModel.events.find((event) => event.id === id)?.title ?? String(id)
+
+function architectureDiagram(model: Model, h: HtmlBuilder<Message>, graph: ArchitectureLayout, layer = false) {
+  const activeNode = model.replayStarted ? conceptForState(model.state) : undefined
+  const activeEdge = model.last ? activeRelationship(model.last.before, model.last.state, model.last.accepted) : undefined
+  const mobile = model.mobile && !layer
+  const width = graph.width / model.zoom, height = graph.height / model.zoom
+  return topologySurfaceView(h, {
+    width: graph.width, height: graph.height,
+    ...(layer ? {} : { viewBox: `${(graph.width - width) / 2 + model.panX} ${(graph.height - height) / 2 + model.panY} ${width} ${height}` }),
+    ariaLabel: `.files architecture: ${graph.places.size} concepts and ${graph.edges.length} directed structural relationships`,
+    role: "group", domainClass: layer ? "dotfiles-layer-topology" : "dotfiles-topology"
+  }, [
+    ...graph.edges.map((edge) => {
+      const route = routePlacement(edge, graph.places, mobile)
+      const index = architectureData.edges.findIndex((item) => item.id === edge.id) + 1
+      const external = edge.kind.startsWith("external")
+      return topologyRouteView(h, {
+        id: edge.id, title: `${index}. ${edge.label} (${edge.status} architecture; not native execution)`,
+        path: route.path, tip: route.tip, toward: route.toward,
+        badge: { point: route.badge, label: String(index) },
+        color: external ? "#9c742b" : edge.status === "deferred" ? "#7d8da2" : "#547dc0",
+        active: activeEdge === edge.id, dashed: external || edge.status === "deferred", external,
+        label: relationshipLabel(edge.id), labelPoint: route.labelPoint,
+        onInspect: () => Message.Selected({ id: edge.id })
+      })
+    }),
+    ...Array.from(graph.places, ([id, point]) => {
+      const concept = concepts.get(id)!
+      const [title, owner, caption] = conceptPresentation(id)
+      return topologyNodeView(h, {
+        id, point, width: point.width, height: point.height, title, owner, detail: concept.summary,
+        active: activeNode === id, selected: model.selected === id,
+        palette: concept.group === "runtime" ? { fill: "#edf1f6", stroke: "#7d8da2" }
+          : concept.group === "evidence" ? { fill: "#fff7e5", stroke: "#b08b46" }
+          : { fill: "#e9f1ff", stroke: "#547dc0" },
+        onInspect: () => Message.Selected({ id })
+      }, [h.text([
+        h.X(String(point.x + 13)), h.Y(String(point.y + (mobile ? 66 : 76))),
+        h.FontSize(mobile ? "10" : "11"), h.Fill("#435670")
+      ], [caption])])
+    })
+  ])
+}
+
+function inspector(model: Model, h: HtmlBuilder<Message>) {
+  const selected = model.selected || specificationLayers[model.active].nodes[0]
+  const node = concepts.get(selected)
+  const edge = relationships.get(selected)
+  const citations: readonly Citation[] = node?.citations ?? edge?.citations ?? []
+  return stageInspectorView(h, { focused: true, preparation: false, selected, children: [
+    h.details([h.Open(true)], [
+      h.summary([], ["Inspect a diagram concept or relationship by keyboard"]),
+      h.select([h.AriaLabel("Diagram stage"), h.Value(selected), h.OnChange((id) => Message.Selected({ id }))], [
+        ...architectureData.nodes.map((item) => h.option([h.Value(item.id)], [item.title])),
+        ...architectureData.edges.map((item) => h.option([h.Value(item.id)], [`${concepts.get(item.from)?.title} → ${concepts.get(item.to)?.title}: ${item.label}`]))
+      ])
+    ]),
+    h.h3([], [node?.title ?? edge?.label ?? "Architecture"]),
+    h.p([], [node?.summary ?? `${concepts.get(edge!.from)?.title} → ${concepts.get(edge!.to)?.title}. ${edge!.kind}; ${edge!.status} architecture, not observed execution.`]),
+    ...(node ? [
+      h.p([], [node.owner]),
+      h.p([], [node.states.length ? `Mapped Bend states: ${node.states.map(stateTitle).join(" · ")}` : "Architectural concept; no policy state is invented for this boundary."]),
+      h.h4([], ["Directed relationships"]),
+      h.ul([], architectureData.edges.filter((item) => item.from === node.id || item.to === node.id).map((item) =>
+        h.li([], [h.button([h.Type("button"), h.OnClick(Message.Selected({ id: item.id }))], [
+          `${concepts.get(item.from)?.title} → ${concepts.get(item.to)?.title}: ${item.label}`
+        ])])
+      ))
+    ] : []),
+    h.h4([], ["Source citations"]),
+    h.ul([h.Class("dotfiles-citations")], citations.map((citation) => h.li([], [h.code([], [citation.path]), ` · ${citation.symbol}`])))
+  ] })
+}
+
+function scenarioSelect(model: Model, h: HtmlBuilder<Message>) {
+  return h.label([], ["Scenario ", h.select([
+    h.Id("dotfiles-scenario"), h.Value(String(model.scenario)),
+    h.OnChange((value) => Message.ScenarioSelected({ index: Number(value) }))
+  ], scenarios.map((item, index) => h.option([h.Value(String(index))], [item.title])))])
+}
+
+function replay(model: Model, h: HtmlBuilder<Message>) {
+  const scenario = scenarios[model.scenario]
+  const step = scenario.steps[model.cursor - 1]
+  const next = scenario.steps[model.cursor]
+  return h.section([h.Class("card canonical-replay"), h.Id("canonical-replay")], [
+    h.h2([], ["Guided .files replay"]),
+    h.p([h.Class("section-guidance")], ["Choose a supplied-fact scenario and follow one checked event at a time. Replay cannot verify a host, install K3s or change the deployment status."]),
+    scenarioSelect(model, h),
+    h.p([h.Class("description")], [scenario.summary]),
+    h.div([h.Class("canonical-step-controls")], [
+      h.button([h.Type("button"), h.Disabled(model.cursor === 0), h.OnClick(Message.Seek({ position: model.cursor - 1, scrub: false }))], ["← Previous checked event"]),
+      h.button([h.Type("button"), h.Id("replay-next"), h.Disabled(!next), h.OnClick(Message.Next())], [next ? "Next checked event →" : "Scenario complete"]),
+      h.button([h.Type("button"), h.Disabled(model.cursor === 0), h.OnClick(Message.Seek({ position: 0, scrub: false }))], ["Return to start · retain history"]),
+      h.button([h.Type("button"), h.Id("replay-reset"), h.OnClick(Message.Reset())], ["Reset scenario"])
+    ]),
+    h.p([h.Class(`status${model.last && !model.last.accepted ? " blocked" : ""}`), h.AriaLive("polite"), h.DataAttribute("replay-state", String(model.state))], [
+      `Model state: ${stateTitle(model.state)}. `,
+      model.last ? `${model.last.accepted ? "ACCEPTED" : "REFUSED"}: ${model.last.reason}` : "No replay event run."
+    ]),
+    h.p([h.Class("progress")], [`${model.cursor} / ${scenario.steps.length} scenario events · ${model.history.length} retained checked results`]),
+    ...(step ? [h.p([], [step.note])] : []),
+    h.div([h.Class("canonical-commands")], [
+      h.h3([], ["Ordered Bend outputs"]),
+      model.last ? h.ol([], model.last.outputs.map((item) => h.li([], [`${item.kind}: ${item.label}`]))) : h.p([], ["No outputs before the first checked event."])
+    ]),
+    ...(next ? [h.p([], [`Next supplied event: ${eventTitle(next.event)}`])] : []),
+    h.details([h.Class("simulation-details")], [
+      h.summary([], ["Supplied facts / compilation receipt"]),
+      h.p([], [policyModel.trustBoundary]),
+      h.pre([h.Tabindex(0)], [JSON.stringify(step?.facts ?? next?.facts ?? {}, null, 2)]),
+      h.p([], [`${receipt.compiler.version} · generated ${receipt.generatedAt}`]),
+      h.dl([h.Class("dotfiles-receipt")], Object.entries(receipt.artifacts).flatMap(([name, hash]) => [h.dt([], [name]), h.dd([], [h.code([], [hash])])]))
+    ])
+  ])
+}
+
+function ensemble(model: Model, h: HtmlBuilder<Message>) {
+  const scenario = scenarios[model.scenario]
+  const active = specificationLayers[model.active]
+  return h.div([h.Id("monkey-business"), h.Class("ensemble")], [
+    h.section([h.Id("agent-ensemble"), h.Class(`ensemble-panel ${model.camera.flat ? "is-flat" : "is-spatial"}`)], [
+      h.div([h.Class("ensemble-heading")], [h.div([], [
+        h.p([h.Class("eyebrow")], [".FILES / SHARED SPECIFICATION SNAPSHOT"]),
+        h.h2([], ["Four regions. One checked model."]),
+        h.p([], ["Clients, setup, opt-in runtime and evidence are architectural regions—not advicees, workers or running clusters."])
+      ])]),
+      h.p([h.Class("section-guidance")], ["Play or Step the compiled Bend scenario, select a region, then select a concept or relationship to inspect its source. The complete connected 2D architecture remains below."]),
+      h.div([h.Class("ensemble-toolbar")], [
+        h.button([h.Type("button"), h.Class("ensemble-primary"), h.OnClick(Message.Reset())], ["Start scenario"]),
+        h.button([h.Type("button"), h.Id("dotfiles-play"), h.Disabled(model.cursor >= scenario.steps.length), h.OnClick(Message.PlayToggled())], [model.playing ? "Pause replay" : "Play replay"]),
+        h.button([h.Type("button"), h.Id("dotfiles-step"), h.Disabled(model.cursor >= scenario.steps.length), h.OnClick(Message.Next())], ["Step replay"]),
+        h.span([h.Class("ensemble-toolbar-divider")], []),
+        h.button([h.Type("button"), h.Id("dotfiles-flat"), h.Class(model.camera.flat ? "selected" : ""), h.OnClick(Message.FlatToggled())], [model.camera.flat ? "3D layers" : "Focus selected region"]),
+        h.button([h.Type("button"), h.Id("dotfiles-camera-reset"), h.OnClick(Message.CameraReset())], ["Reset view"])
+      ]),
+      h.p([h.Class("ensemble-feedback"), h.Role("status")], [`${scenario.title} · ${model.playing ? "Playing supplied events" : "Paused"} · ${model.cursor} / ${scenario.steps.length} checked events`]),
+      h.div([h.Class("shared-resident")], [
+        h.div([h.Class("shared-resident-heading")], [h.strong([], ["ONE COMPILED BEND SNAPSHOT"]), h.span([], [`${architectureData.nodes.length} concepts · ${architectureData.edges.length} sourced relationships`])]),
+        h.p([], [`${stateTitle(model.state)} · ${model.last ? (model.last.accepted ? "accepted" : "refused") : "initial state"}`]),
+        h.small([h.DataAttribute("deployment-status", "foreign-active-unverified")], ["Foreign K3s service ACTIVE · .files deployment UNVERIFIED · ownership/storage/admin/network review required. Health, Job, quota, CNI and TTL are unproved. Scenario outcomes are not deployment observations."])
+      ]),
+      h.div([h.Class("ensemble-layout")], [
+        h.aside([h.Class("ensemble-agents"), h.AriaLabel("Specification layers")], [
+          h.p([h.Class("ensemble-sidebar-label")], ["SPECIFICATION LAYERS"]),
+          h.p([h.Class("ensemble-hover-hint")], ["Select a region to inspect its sources. Hover or keyboard focus reveals its plane."]),
+          ...specificationLayers.map((layer, index) => h.button([
+            h.Type("button"), h.Class(`ensemble-agent agent-index-${index} ${index === model.active ? "selected" : ""}`),
+            h.Style({ borderLeftColor: layer.color }), h.OnClick(Message.LayerSelected({ index })),
+            h.AriaLabel(`Select ${layer.title}`), h.AriaPressed(String(index === model.active)), h.DataAttribute("layer", layer.id)
+          ], [
+            h.strong([], [layer.title]), h.span([], [layer.owner]),
+            h.span([], [`${layer.nodes.length} sourced concepts`]), h.small([], [layer.summary])
+          ])),
+          h.p([h.Class("ensemble-scope")], ["All planes reference one model snapshot. Cross-region arrows appear in the complete architecture below; vertical placement does not imply runtime communication."])
+        ]),
+        ensembleViewportView(h, model.camera, {
+          active: model.active, ariaLabel: "Three-dimensional .files specification regions",
+          orientation: `${active.title.toUpperCase()} / INSPECTION VIEW`,
+          layers: specificationLayers.map((layer, index) => ({
+            index, color: layer.color, title: layer.title.toUpperCase(), caption: "SOURCED DESIGN · NOT LIVE ACTIVITY",
+            diagram: architectureDiagram(model, h, specificationLayerLayout(index), true)
+          }))
+        })
+      ]),
+      ensembleCameraView(h, model.camera, (field, raw) => Message.CameraChanged({ field, raw })),
+      h.p([h.Class("ensemble-evidence-key")], ["Blue = setup / control · slate = opted-in runtime · gold dashed = external authority / evidence. Highlighting comes only from checked Bend outcomes."]),
+      h.div([h.Class("ensemble-resource-key")], [
+        h.span([h.Class("capacity-key")], ["● One retained event history"]),
+        h.span([h.Class("jev-key")], ["● Separate native deployment evidence"]),
+        h.p([], ["The browser sends no shell commands, Kubernetes API requests or model calls. No simulated result promotes the host to installed or running."])
+      ])
+    ]),
+    h.div([h.Class("ensemble-inspector-heading")], [h.h2([], [`Specification controls · ${active.title} selected`]), h.p([], ["Inspect source-owned concepts, checked transitions and retained results from this scenario."])]),
+    h.section([h.Class("chart-panel simulation-panel"), h.AriaLabel("Specification controls and event history")], [
+      h.h2([], ["Specification controls & event history"]),
+      h.p([], ["Compiled Bend decisions; supplied facts are not host observations."]),
+      h.nav([h.Class("simulation-navigation"), h.AriaLabel("Specification inspection sections")], [
+        h.a([h.Href("#resident-stage-inspector")], ["Inspect a concept"]),
+        h.a([h.Href("#resident-event-history")], ["Read event history"]),
+        h.a([h.Href("#canonical-replay")], ["Choose a scenario"]),
+        h.a([h.Href("#timing-diagrams")], ["Read transition timeline"])
+      ]),
+      inspector(model, h),
+      h.details([h.Class("simulation-details")], [
+        h.summary([], ["Checked event, ordered outputs and refusals"]),
+        h.p([], ["Supplied environment facts and checked model outcomes are separate from native evidence."]),
+        h.pre([h.Tabindex(0)], [JSON.stringify(model.last ? { facts: scenario.steps[model.cursor - 1].facts, result: model.last } : { state: model.state }, null, 2)])
+      ]),
+      h.h3([h.Id("resident-event-history"), h.Tabindex(-1)], ["Retained checked events"]),
+      h.button([h.Type("button"), h.OnClick(Message.RefusalsToggled())], [model.refusalsOnly ? "Show all events" : "Show refusals only"]),
+      ...retainedHistoryView(h, {
+        rows: [{ position: 0, label: `Start · ${stateTitle(scenario.initialState)}` }, ...model.history.flatMap((entry, index) =>
+          model.refusalsOnly && entry.accepted ? [] : [{ position: index + 1, label: `${index + 1}. ${eventTitle(entry.event)} · ${entry.accepted ? "accepted" : "refused"} · ${stateTitle(entry.state)}` }])],
+        position: model.cursor, minimum: 0, maximum: model.history.length,
+        epoch: `${model.scenario}:${model.timelineEpoch}`,
+        select: (position, scrub) => Message.Seek({ position, scrub })
+      })
+    ])
+  ])
+}
+
+function flatArchitecture(model: Model, h: HtmlBuilder<Message>) {
+  const graph = layout(model.focus, model.mobile)
+  const button = (label: string, message: Message, ariaLabel: string) => h.button([h.Type("button"), h.OnClick(message), h.AriaLabel(ariaLabel)], [label])
+  return h.section([h.Id("import-graph"), h.Class("card import-graph-section"), h.AriaLabel("Connected architectural relationships")], [
+    h.h2([], ["Complete .files architecture"]),
+    h.p([h.Class("section-guidance")], ["The approved 2D view: source-owned concepts and directed relationships. Choose a focus or inspect any numbered relationship; no import graph or runtime topology is fabricated."]),
+    h.div([h.Class("trace-options"), h.AriaLabel("Architecture focus")], [
+      ...([ ["overview", "Overview · all 14 concepts"], ["onboarding", "Onboarding"], ["k3s", "K3s · separate opt-in"] ] as const).map(([focus, label]) =>
+        h.button([h.Type("button"), h.Class(`trace${model.focus === focus ? " selected" : ""}`), h.DataAttribute("focus", focus), h.AriaPressed(String(model.focus === focus)), h.OnClick(Message.Focused({ focus }))], [label]))
+    ]),
+    h.div([h.Class("dotfiles-camera"), h.AriaLabel("Graph camera")], [
+      button("−", Message.Zoomed({ factor: 1 / 1.25 }), "Zoom out"),
+      button(`${Math.round(model.zoom * 100)}% · Fit`, Message.Fit(), "Fit architecture"),
+      button("+", Message.Zoomed({ factor: 1.25 }), "Zoom in"),
+      button("←", Message.Panned({ dx: -90, dy: 0 }), "Pan left"), button("↑", Message.Panned({ dx: 0, dy: -90 }), "Pan up"),
+      button("↓", Message.Panned({ dx: 0, dy: 90 }), "Pan down"), button("→", Message.Panned({ dx: 90, dy: 0 }), "Pan right")
+    ]),
+    h.div([
+      h.Class(`dotfiles-canvas${model.dragging ? " dragging" : ""}`), h.Id("dotfiles-canvas"),
+      h.OnPointerDown((_type, button, x, y, _time, _cx, _cy, _id, target) => {
+        if (button !== 0) return Option.none()
+        const element = target instanceof Element ? target.closest(".dotfiles-canvas") : null
+        const bounds = element?.getBoundingClientRect()
+        return Option.some(Message.DragStarted({ x, y, scale: graph.width / Math.max(1, bounds?.width ?? graph.width) }))
+      }),
+      h.OnPointerMove((x, y) => model.dragging ? Option.some(Message.Dragged({ x, y })) : Option.none()),
+      h.OnPointerUp(() => Option.some(Message.DragEnded())), h.OnPointerLeave(() => Option.some(Message.DragEnded()))
+    ], [architectureDiagram(model, h, graph)]),
+    h.details([h.Class("topology-route-key")], [
+      h.summary([], ["All 20 sourced relationships · inspect endpoints and citations"]),
+      h.ol([], architectureData.edges.map((edge) => h.li([], [
+        h.button([h.Type("button"), h.OnClick(Message.Selected({ id: edge.id }))], [
+          `${concepts.get(edge.from)?.title} → ${concepts.get(edge.to)?.title}: ${edge.label}`
+        ])
+      ])))
+    ]),
+    ...(model.selected ? [h.div([h.Class("flow-stage-inspector")], [
+      h.h3([], [concepts.get(model.selected)?.title ?? relationships.get(model.selected)?.label ?? "Selected architecture"]),
+      h.p([], [concepts.get(model.selected)?.summary ?? "Inspect the selected relationship's direction, status and source citations in the specification inspector."]),
+      h.a([h.Href("#resident-stage-inspector")], ["Open source inspector ↑"])
+    ])] : [])
+  ])
+}
+
+function timeline(model: Model, h: HtmlBuilder<Message>) {
+  const scenario = scenarios[model.scenario]
+  return h.section([h.Id("timing-diagrams"), h.Class("card timeline-section")], [
+    h.h2([], ["When the checked model changes"]),
+    h.p([h.Class("timeline-context")], ["Ordered compiled Bend events · no measured runtime timestamps or implied deployment latency"]),
+    h.div([h.Class("timeline-case-heading")], [h.h3([], [scenario.title]), h.span([h.Class("timeline-badge requirement")], ["SUPPLIED-FACT REPLAY"])]),
+    h.p([h.Class("description")], ["Only retained compiled results are plotted. Seeking never replaces a recorded future; choosing or resetting a scenario starts a separate history."]),
+    timelinePanelView(h, {
+      title: "Retained transitions", status: "CHECKED MODEL / NOT NATIVE OBSERVATION",
+      outcome: model.history.length ? `${model.history.length} checked results retained; inspecting position ${model.cursor}. Native snapshot remains foreign K3s service ACTIVE; .files deployment UNVERIFIED.` : "Step or play the scenario to record compiled Bend results. No native timing evidence is asserted.",
+      entries: model.history.map((entry, index) => ({
+        lane: entry.accepted ? "result" : "refusal", at: index + 1, kind: "checked transition",
+        label: `${index + 1}. ${eventTitle(entry.event)}`
+      }))
+    }, Math.max(1, scenario.steps.length), {
+      lanes: { result: "Accepted model events", refusal: "Refused model events" },
+      description: "Event position · not elapsed time", ariaLabel: "checked event position, not wall-clock time",
+      valueLabel: "Event position", tick: (value) => Number.isInteger(value) ? String(value) : "", value: (value) => `#${value}`
+    }),
+    h.div([h.Class("trace-options timeline-options"), h.Role("group"), h.AriaLabel("Select checked scenario")], scenarios.map((item, index) =>
+      h.button([h.Type("button"), h.Class(index === model.scenario ? "trace selected" : "trace"), h.OnClick(Message.ScenarioSelected({ index }))], [item.title]))),
+    h.div([h.Class("timeline-sources")], [h.strong([], ["Source authority: "]), h.code([], ["docs/spec-diagram/Flow.bend"]), h.code([], ["Flow.generated.mjs"]), h.code([], ["scenarios.json"]), h.a([h.Href("#canonical-replay")], ["Supplied facts and compiler receipt"])])
+  ])
+}
+
+export function view(model: Model, h: HtmlBuilder<Message>): Document {
+  return {
+    title: ".files · Hapsland guided replay",
+    body: h.main([h.Class("page dotfiles-dashboard")], [
+      dashboardHeaderView(h, {
+        title: "From clients to setup and private runtime",
+        intro: "Explore .files architecture, the checked Bend decisions and the evidence behind each transition.",
+        boundary: "Source-backed architectural design · supplied-fact compiled Bend replay · foreign K3s service ACTIVE; .files deployment UNVERIFIED. This page does not inspect or change your hosts, agent sessions or cluster.",
+        sections: [
+          { href: "#monkey-business", title: "Specification simulator", description: "Play checked events, select a region, then inspect its concepts and sources." },
+          { href: "#canonical-replay", title: "Guided replay", description: "Choose a scenario and follow one compiled Bend event at a time." },
+          { href: "#import-graph", title: "Architecture exploration", description: "See all 14 concepts and 20 directed, cited relationships in 2D." },
+          { href: "#timing-diagrams", title: "Transition timeline", description: "Compare retained model outcomes and their stated evidence boundaries." }
+        ]
+      }),
+      ensemble(model, h), replay(model, h), flatArchitecture(model, h), timeline(model, h)
+    ])
+  }
+}
