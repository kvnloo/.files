+import { Runtime, Subscription } from "foldkit"
+import { Schema, Stream } from "effect"
+import { cameraGestures } from "../ensemble-camera"
+import { Message, Model, init, update } from "./model"
+import { view } from "./view"
+import "../style.css"
+import "./style.css"
+
+const subscriptions = Subscription.make<Model, Message>()((entry) => ({
+  viewport: Subscription.persistent(Subscription.fromMediaQuery({
+    query: "(max-width: 700px)", mapMatches: (mobile) => Message.Responsive({ mobile })
+  })),
+  ensembleCamera: entry({ flat: Schema.Boolean }, {
+    modelToDependencies: (model) => ({ flat: model.camera.flat }),
+    keepAliveEquivalence: (before, after) => before.flat === after.flat,
+    dependenciesToStream: ({ flat }: { readonly flat: boolean }) => flat ? Stream.never
+      : cameraGestures((movement) => movement.kind === "zoom"
+        ? Message.CameraZoomed({ factor: movement.factor })
+        : Message.CameraRotated({ dx: movement.dx, dy: movement.dy }))
+  }),
+  playback: Subscription.animationFrame<Model, Message>({
+    isActive: (model) => model.playing,
+    toMessage: (deltaMs) => Message.PlaybackTick({ deltaMs })
+  })
+}))
+
+Runtime.run(Runtime.makeApplication({
+  Model, init, update, view, subscriptions, container: document.getElementById("root")
+}))
diff --git c/packages/agent-flow-viz/src/dotfiles/model.ts w/packages/agent-flow-viz/src/dotfiles/model.ts
