+import { Option } from "effect"
+import type { Html, HtmlBuilder } from "foldkit/html"
+
+/** SVG presentation shared by production flow and dotfiles architecture; callers own state and geometry. */
+export type TopologyPoint = { readonly x: number; readonly y: number }
+
+export type TopologyNodeSpec<Message> = {
+  readonly id: string
+  readonly point: TopologyPoint
+  readonly width: number
+  readonly height: number
+  readonly title: string
+  readonly owner: string
+  readonly detail: string
+  readonly active: boolean
+  readonly selected?: boolean
+  readonly palette?: { readonly fill: string; readonly stroke: string }
+  readonly onInspect?: () => Message
+}
+
+export const topologyNodeView = <Message>(
+  h: HtmlBuilder<Message>,
+  spec: TopologyNodeSpec<Message>,
+  children: ReadonlyArray<Html | string> = []
+) => {
+  const { point, onInspect } = spec
+  const palette = spec.palette ?? { fill: "#e9f1ff", stroke: "#547dc0" }
+  return h.g(
+    [
+      h.Class(`topology-node ${spec.active ? "active" : ""}${spec.selected ? " selected" : ""}`),
+      h.DataAttribute("topology-node", spec.id),
+      ...(onInspect
+        ? [
+            h.Role("button"),
+            h.Tabindex(0),
+            h.AriaLabel(`Inspect ${spec.title}`),
+            h.OnClick(onInspect()),
+            h.OnKeyDownSelfPreventDefault((key) =>
+              key === "Enter" || key === " " ? Option.some(onInspect()) : Option.none()
+            )
+          ]
+        : [])
+    ],
+    [
+      h.title([], [`${spec.title}: ${spec.detail}`]),
+      h.rect(
+        [
+          h.X(String(point.x)),
+          h.Y(String(point.y)),
+          h.Width(String(spec.width)),
+          h.Height(String(spec.height)),
+          h.Rx("12"),
+          h.Fill(palette.fill),
+          h.Stroke(palette.stroke),
+          h.StrokeWidth(spec.active ? "4" : "2")
+        ],
+        []
+      ),
+      h.text(
+        [
+          h.X(String(point.x + 13)),
+          h.Y(String(point.y + 25)),
+          h.FontSize("10"),
+          h.FontWeight("700"),
+          h.Fill("#52647d")
+        ],
+        [spec.owner]
+      ),
+      h.text(
+        [
+          h.X(String(point.x + 13)),
+          h.Y(String(point.y + 49)),
+          h.FontSize("14"),
+          h.FontWeight("700"),
+          h.Fill("#1e3048")
+        ],
+        [spec.title]
+      ),
+      ...children
+    ]
+  )
+}
+
+export type TopologyRouteSpec<Message> = {
+  readonly id: string
+  readonly title: string
+  readonly path: string
+  readonly badge: { readonly point: TopologyPoint; readonly label: string }
+  readonly tip: TopologyPoint
+  readonly toward: TopologyPoint
+  readonly color: string
+  readonly active: boolean
+  readonly dashed?: boolean
+  readonly linked?: boolean
+  readonly overlay?: boolean
+  readonly external?: boolean
+  readonly label?: string
+  readonly labelPoint?: TopologyPoint
+  readonly onInspect?: () => Message
+}
+
+const arrowHead = (tip: TopologyPoint, toward: TopologyPoint) => {
+  const length = Math.hypot(toward.x, toward.y)
+  const ux = toward.x / length
+  const uy = toward.y / length
+  const bx = tip.x - ux * 12
+  const by = tip.y - uy * 12
+  return `M ${tip.x} ${tip.y} L ${bx - uy * 6} ${by + ux * 6} L ${bx + uy * 6} ${by - ux * 6} Z`
+}
+
+export const topologyRouteView = <Message>(h: HtmlBuilder<Message>, spec: TopologyRouteSpec<Message>) => {
+  const { path, color, active, onInspect } = spec
+  const badge = spec.badge.point
+  return h.g(
+    [
+      h.Class(`topology-route ${active ? "active" : ""} ${spec.external ? "external" : ""}`),
+      h.DataAttribute("topology-route", spec.id),
+      ...(onInspect
+        ? [
+            h.Role("button"),
+            h.Tabindex(0),
+            h.AriaLabel(spec.title),
+            h.OnClick(onInspect()),
+            h.OnKeyDownSelfPreventDefault((key) =>
+              key === "Enter" || key === " " ? Option.some(onInspect()) : Option.none()
+            )
+          ]
+        : [])
+    ],
+    [
+      h.title([], [spec.title]),
+      h.path(
+        [
+          h.D(path),
+          h.Fill("none"),
+          h.Stroke(color),
+          h.StrokeWidth(active ? "4" : "2"),
+          ...(spec.dashed ? [h.StrokeDasharray("7 5")] : spec.linked ? [h.StrokeDasharray("2 6")] : [])
+        ],
+        []
+      ),
+      ...(spec.overlay
+        ? [h.path([h.D(path), h.Fill("none"), h.Stroke("#794aa0"), h.StrokeWidth("2"), h.StrokeDasharray("7 5")], [])]
+        : []),
+      h.path([h.D(arrowHead(spec.tip, spec.toward)), h.Fill(color)], []),
+      h.circle(
+        [
+          h.Cx(String(badge.x)),
+          h.Cy(String(badge.y)),
+          h.R("11"),
+          h.Fill(active ? color : "#fff"),
+          h.Stroke(color)
+        ],
+        []
+      ),
+      h.text(
+        [
+          h.X(String(badge.x)),
+          h.Y(String(badge.y + 1)),
+          h.TextAnchor("middle"),
+          h.DominantBaseline("middle"),
+          h.FontSize("10"),
+          h.FontWeight("700"),
+          h.Fill(active ? "#fff" : "#485b73")
+        ],
+        [spec.badge.label]
+      ),
+      ...(spec.label !== undefined && spec.labelPoint !== undefined
+        ? [
+            h.text(
+              [
+                h.Class("topology-route-label"),
+                h.X(String(spec.labelPoint.x)),
+                h.Y(String(spec.labelPoint.y)),
+                h.TextAnchor("middle"),
+                h.FontSize("10"),
+                h.FontWeight("700"),
+                h.Fill("#485b73")
+              ],
+              [spec.label]
+            )
+          ]
+        : [])
+    ]
+  )
+}
+
+export type TopologySurfaceSpec = {
+  readonly width: number
+  readonly height: number
+  readonly ariaLabel: string
+  readonly role?: "group" | "img"
+  readonly domainClass?: string
+  readonly viewBox?: string
+  readonly before?: ReadonlyArray<Html | string>
+  readonly after?: ReadonlyArray<Html | string>
+}
+
+/** Keeps the production frame and SVG ordering; before/after content stays outside the scroll surface. */
+export const topologySurfaceView = <Message>(
+  h: HtmlBuilder<Message>,
+  spec: TopologySurfaceSpec,
+  children: ReadonlyArray<Html | string>
+) =>
+  h.div(
+    [h.Class(`production-topology${spec.domainClass ? ` ${spec.domainClass}` : ""}`)],
+    [
+      ...(spec.before ?? []),
+      h.div(
+        [h.Class("topology-scroll")],
+        [
+          h.svg(
+            [
+              h.ViewBox(spec.viewBox ?? `0 0 ${spec.width} ${spec.height}`),
+              h.Role(spec.role ?? "img"),
+              h.AriaLabel(spec.ariaLabel)
+            ],
+            children
+          )
+        ]
+      ),
+      ...(spec.after ?? [])
+    ]
+  )
