+      h.button([h.Type("button"), h.Id("replay-next"), h.Disabled(!next), h.OnClick(Message.Next())], [next ? "Next event →" : "Tape complete"]),
+      h.button([h.Type("button"), h.Id("replay-reset"), h.OnClick(Message.Reset())], ["Restart tape"])
+    ]),
+    h.p([h.Class(`status${last && last.verdict !== "accepted" ? " blocked" : ""}`), h.AriaLive("polite"), h.DataAttribute("verdict", last?.verdict ?? "none")], [
