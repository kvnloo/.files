+/* Bend FSM layers: reuse the production dashboard theme; only small additions. */
+.fsm-explainer p { max-width: 72ch; line-height: 1.5; }
+.fsm-table-scroll { overflow-x: auto; }
+.fsm-laws { border-collapse: collapse; width: 100%; font-size: .88rem; }
+.fsm-laws th, .fsm-laws td { border-top: 1px solid #dfe6f0; padding: 8px 10px; text-align: left; vertical-align: top; }
+.fsm-laws thead th { font-size: .75rem; letter-spacing: .06em; color: #52647d; border-top: 0; }
+.fsm-laws th button { font-weight: 700; min-width: 3em; }
+.fsm-laws td span, .fsm-laws td small { color: #52647d; }
+.fsm-count strong { font-size: 1.15rem; }
+.fsm-scenario select { max-width: min(100%, 26rem); }
+.fsm-source { display: inline-block; font: 700 .7rem ui-monospace, monospace; padding: 2px 6px; border-radius: 4px; letter-spacing: .05em; }
+.fsm-source.report { background: #e3efff; color: #23508f; }
+.fsm-source.what-if { background: #f3e9ff; color: #5e3a86; }
+.fsm-verdict.refused { color: #8a3a2c; font-weight: 700; }
+.fsm-verdict.held { color: #8a5d14; font-weight: 700; }
+.fsm-verdict.accepted { color: #1f6b4b; font-weight: 700; }
+.fsm-value { font-family: ui-monospace, monospace; font-size: .85rem; overflow-wrap: anywhere; }
+:is(.fsm-topology, .fsm-layer-topology) .topology-node.selected > rect { stroke: #245bb8; stroke-width: 4px; }
+:is(.fsm-topology, .fsm-layer-topology) .topology-route { cursor: pointer; }
+:is(.fsm-topology, .fsm-layer-topology) .topology-route-label { paint-order: stroke; stroke: #fcfdff; stroke-width: 4px; stroke-linejoin: round; }
+.fsm-topology .topology-scroll { overflow: hidden; }
+.fsm-topology .topology-scroll svg { width: 100%; min-width: 0; height: auto; }
+@media (max-width: 700px) {
+  .fsm-dashboard .is-spatial .ensemble-scene { margin-left: calc((100% - 920px) / 2); margin-top: -40px; }
+  .fsm-dashboard .is-spatial .ensemble-viewport { height: 420px !important; }
+  .fsm-topology .topology-node text:nth-of-type(2) { font-size: 13px; }
+  .fsm-laws { font-size: .8rem; }
+  .fsm-laws th, .fsm-laws td { padding: 6px; }
+}
diff --git c/packages/agent-flow-viz/src/fsm/view.ts w/packages/agent-flow-viz/src/fsm/view.ts
