+import type { HtmlBuilder } from "foldkit/html"
+
+/** Shared retained-history presentation; callers supply checked records, never inferred events. */
+export const retainedHistoryView = <Message>(h: HtmlBuilder<Message>, content: {
+  readonly rows: readonly { readonly position: number; readonly label: string }[]
+  readonly position: number
+  readonly minimum: number
+  readonly maximum: number
+  readonly epoch: string
+  readonly select: (position: number, scrub: boolean) => Message
+}) => [
+  h.div([h.Class("simulation-history")], content.rows.map((row) =>
+    h.button([
+      h.Type("button"), h.Class(row.position === content.position ? "selected" : ""),
+      h.OnClick(content.select(row.position, false))
+    ], [row.label])
+  )),
+  h.label([], [
+    "Retained event timeline",
+    h.input([
+      h.Type("range"), h.AriaLabel("Retained event timeline"),
+      h.Min(String(content.minimum)), h.Max(String(content.maximum)),
+      h.Key(`timeline:${content.epoch}`),
+      { _tag: "Prop", key: "defaultValue", value: String(content.position) },
+      h.OnInput((raw) => content.select(Number(raw), true))
+    ])
+  ])
+]
