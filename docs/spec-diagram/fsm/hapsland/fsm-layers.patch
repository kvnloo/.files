--- /dev/null
+++ w/packages/agent-flow-viz/src/fsm/view.ts
@@ -0,0 +1,286 @@
+import type { Document, Html, HtmlBuilder } from "foldkit/html"
+import { dashboardHeaderView } from "../dashboard-shell"
+import { ensembleCameraView, ensembleViewportView } from "../ensemble-presentation"
+import { retainedHistoryView } from "../history-presentation"
+import { stageInspectorView } from "../inspection-presentation"
+import { timelinePanelView } from "../timeline-presentation"
+import { topologyNodeView, topologyRouteView, topologySurfaceView } from "../topology"
+import { Message, currentState, currentValue, type Model } from "./model"
+import {
+  describeEvent, fsm, laws, nodeId, planeLayout, planes, projection, receipt, routeById, routeGeometry,
+  scenarios, stateMeta, tapeProvenance, valueDetail, type Law, type PlaneLayout
+} from "./projection"
+
+const verdictWord = (verdict: string) => verdict === "accepted" ? "ACCEPTED" : verdict === "held" ? "HELD" : verdict === "no-change" ? "NO CHANGE" : "REFUSED"
+const lawColor = (id: string) => id.startsWith("W") ? "#31836a" : "#386eb1"
+
+function planeDiagram(model: Model, h: HtmlBuilder<Message>, index: number, layout: PlaneLayout, layer: boolean) {
+  const plane = planes[index]
+  const scenario = scenarios[model.scenario]
+  const onThisPlane = plane.machines.includes(scenario.machine)
+  const last = model.history[model.cursor - 1]
+  const mobile = model.mobile && !layer
+  const activeNode = onThisPlane ? nodeId(scenario.machine, currentState(model)) : ""
+  const activeRoute = onThisPlane && last?.accepted && last.before !== last.state ? `edge:${scenario.machine}:${last.before}>${last.state}` : ""
+  const value = currentValue(model)
+  return topologySurfaceView(h, {
+    width: layout.width, height: layout.height, role: "group", domainClass: layer ? "fsm-layer-topology" : "fsm-topology",
+    ariaLabel: `${plane.title}: ${layout.places.size} states and ${layout.routes.length} transitions produced by the compiled Bend`
+  }, [
+    ...layout.routes.map((route) => {
+      const geometry = routeGeometry(route, layout, mobile)
+      const from = stateMeta(route.machine, route.from)!, to = stateMeta(route.machine, route.to)!
+      return topologyRouteView(h, {
+        id: route.id, title: `${from.title} → ${to.title}: ${route.events.join(" / ")}${route.laws.length ? ` · guarded by ${route.laws.join(", ")}` : ""}`,
+        path: geometry.path, tip: geometry.tip, toward: geometry.toward,
+        badge: { point: geometry.badge, label: route.laws[0] ?? "·" },
+        color: route.laws.length ? lawColor(route.laws[0]) : "#7d8da2",
+        active: activeRoute === route.id, dashed: route.laws.length === 0,
+        ...(mobile ? {} : { label: route.events.join(" / "), labelPoint: geometry.labelPoint }),
+        onInspect: () => Message.Selected({ id: route.id })
+      })
+    }),
+    ...Array.from(layout.places, ([id, point]) => {
+      const [, machine, raw] = id.split(":")
+      const state = stateMeta(machine, Number(raw))!
+      const active = activeNode === id
