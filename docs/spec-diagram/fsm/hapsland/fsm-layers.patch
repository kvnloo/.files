+import { createHash } from "node:crypto"
+import { readFileSync } from "node:fs"
+import { dirname, resolve } from "node:path"
+import { fileURLToPath } from "node:url"
+import { defineConfig } from "vite"
+
+// Bend FSM layers (work item + worker supervision) next to the .files entry.
+// Both diagrams fail closed on stale artifacts before Vite serves or bundles them.
+const packageRoot = dirname(fileURLToPath(import.meta.url))
+const upstreamRoot = resolve(packageRoot, "../..")
+const fsmRoot = resolve(packageRoot, "../../../.files/docs/spec-diagram/fsm")
+const dotfilesRoot = resolve(fsmRoot, "..")
+const sha256 = (path: string) => createHash("sha256").update(readFileSync(path)).digest("hex")
+
+function requireFresh(root: string, names: readonly string[]) {
+  const receipt = JSON.parse(readFileSync(resolve(root, "receipt.json"), "utf8")) as { artifacts: Record<string, string> }
+  for (const name of names) {
+    if (receipt.artifacts[name] !== sha256(resolve(root, name))) {
+      throw new Error(`Stale diagram receipt for ${root}/${name}; rerun its build.mjs producer before launching Hapsland.`)
+    }
+  }
+}
+const fsmArtifacts = ["Runtime.bend", "WorkItem.bend", "WorkerSupervision.bend", "model.json", "scenarios.json", "adapter.mjs",
+  "build.mjs", "extract-tapes.py", "work-item.mmd", "worker-supervision.mmd", "Runtime.generated.mjs", "projection.json", "replay.json"] as const
+const dotfilesArtifacts = ["Flow.bend", "model.json", "adapter.mjs", "build.mjs", "scenarios.json", "Flow.generated.mjs",
+  "projection.json", "architecture.json"] as const
+const requireFreshAll = () => { requireFresh(fsmRoot, fsmArtifacts); requireFresh(dotfilesRoot, dotfilesArtifacts) }
+
+requireFreshAll()
+
+export default defineConfig({
+  root: packageRoot,
+  base: "./",
+  cacheDir: resolve(upstreamRoot, ".test-runs/vite-fsm"),
+  plugins: [{ name: "fsm-receipt-freshness", buildStart: requireFreshAll }],
+  resolve: {
+    dedupe: ["effect", "foldkit"],
+    alias: [
+      { find: /^@fsm-diagram\//, replacement: `${fsmRoot}/` },
+      { find: /^@dotfiles-diagram\//, replacement: `${dotfilesRoot}/` }
+    ]
+  },
+  server: { host: "127.0.0.1", port: 4184, strictPort: true, fs: { strict: true, allow: [packageRoot, resolve(upstreamRoot, "node_modules"), dotfilesRoot] } },
+  build: {
+    outDir: resolve(upstreamRoot, ".test-runs/fsm-hapsland-dist"), emptyOutDir: true,
+    rollupOptions: { input: { index: resolve(packageRoot, "fsm.html"), dotfiles: resolve(packageRoot, "dotfiles.html") } }
+  }
+})
