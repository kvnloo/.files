new file mode 100644
index 0000000..ebd4e1d
--- /dev/null
+++ w/packages/agent-flow-viz/src/fsm/model.ts
@@ -0,0 +1,114 @@
+import { Schema } from "effect"
+import { type Runtime, type Update } from "foldkit"
+import { defineMessageUnion } from "foldkit/message"
+import { transition, validateState, displayState, type FsmOutcome, type Json } from "@fsm-diagram/adapter.mjs"
+import { planeIndexForMachine, producerReplay, scenarios } from "./projection"
+import { orbitEnsembleCamera, zoomEnsembleCamera } from "../ensemble-presentation"
+
+const Outcome = Schema.Struct({
+  machine: Schema.String, before: Schema.Number, state: Schema.Number, event: Schema.Number, eventTag: Schema.String,
+  accepted: Schema.Boolean, verdict: Schema.String, reason: Schema.String, laws: Schema.Array(Schema.String),
+  value: Schema.String, matchesProducer: Schema.Boolean,
+  outputs: Schema.Array(Schema.Struct({ kind: Schema.String, label: Schema.String }))
+})
+export type Outcome = typeof Outcome.Type
+const Camera = Schema.Struct({
+  tilt: Schema.String, turn: Schema.String, spacing: Schema.String, zoom: Schema.String,
+  cameraEpoch: Schema.Number, flat: Schema.Boolean
+})
+const initialCamera = { tilt: "46", turn: "-14", spacing: "120", zoom: "72", cameraEpoch: 0, flat: false }
+const mobileCamera = { ...initialCamera, zoom: "39", spacing: "100", turn: "-8" }
+export const Model = Schema.Struct({
+  mobile: Schema.Boolean, selected: Schema.String, active: Schema.Number,
+  scenario: Schema.Number, cursor: Schema.Number, history: Schema.Array(Outcome),
+  playing: Schema.Boolean, elapsed: Schema.Number, timelineEpoch: Schema.Number, refusalsOnly: Schema.Boolean,
+  camera: Camera
+})
+export type Model = typeof Model.Type
+export const Message = defineMessageUnion({
+  Selected: { id: Schema.String }, Responsive: { mobile: Schema.Boolean }, LayerSelected: { index: Schema.Number },
+  CameraChanged: { field: Schema.String, raw: Schema.String }, CameraZoomed: { factor: Schema.Number },
+  CameraRotated: { dx: Schema.Number, dy: Schema.Number }, CameraReset: {}, FlatToggled: {},
+  PlayToggled: {}, PlaybackTick: { deltaMs: Schema.Number }, ScenarioSelected: { index: Schema.Number },
+  Next: {}, Reset: {}, Seek: { position: Schema.Number, scrub: Schema.Boolean }, RefusalsToggled: {}
+})
+export type Message = typeof Message.Type
+
+const isMobile = () => window.matchMedia("(max-width: 700px)").matches
+export const init: Runtime.ApplicationInit<Model, Message> = () => ({ model: {
+  mobile: isMobile(), selected: "", active: planeIndexForMachine(scenarios[0].machine), scenario: 0, cursor: 0, history: [],
+  playing: false, elapsed: 0, timelineEpoch: 0, refusalsOnly: false, camera: isMobile() ? mobileCamera : initialCamera
+} })
+
+/** The current Bend state value of the selected tape (initial when nothing ran). */
+export const currentValue = (model: Model): Json => {
+  const last = model.history[model.cursor - 1]
+  return last ? JSON.parse(last.value) as Json : validateState(scenarios[model.scenario].machine, scenarios[model.scenario].initial)
+}
+export const currentState = (model: Model) => {
+  const machine = scenarios[model.scenario].machine
+  return displayState(machine, currentValue(model))
+}
+
+const record = (outcome: FsmOutcome, scenarioIndex: number, position: number): Outcome => {
+  const expected = producerReplay[scenarioIndex]?.steps[position]
+  return {
+    machine: outcome.machine, before: outcome.before, state: outcome.state, event: outcome.event, eventTag: outcome.eventTag,
+    accepted: outcome.accepted, verdict: outcome.verdict, reason: outcome.reason, laws: [...outcome.laws],
+    value: JSON.stringify(outcome.value), outputs: outcome.outputs.map((o) => ({ kind: o.kind, label: o.label })),
+    // Fail-closed signal: the browser's run of the compiled Bend must equal the producer's receipt-bound replay.
+    matchesProducer: expected !== undefined && expected.state === outcome.state && expected.verdict === outcome.verdict
+  }
+}
+
+/** Seeking records missing checked results once and preserves the recorded future. */
+const seekHistory = (model: Model, requested: number, scrub = false): Model => {
+  const scenario = scenarios[model.scenario]
+  const cursor = Math.max(0, Math.min(scenario.steps.length, Math.trunc(requested)))
+  if (!Number.isFinite(cursor)) return model
+  let history = model.history
+  if (cursor > history.length) {
+    const extended = [...history]
+    let value: Json = extended.length ? JSON.parse(extended[extended.length - 1].value) as Json : validateState(scenario.machine, scenario.initial)
+    for (let index = extended.length; index < cursor; index++) {
+      const step = scenario.steps[index]
+      // The compiled z0intelligence Bend is the only transition authority.
+      const outcome = transition(scenario.machine, value, step.event, step.facts)
+      extended.push(record(outcome, model.scenario, index))
+      value = outcome.value
+    }
+    history = extended
+  }
+  return { ...model, history, cursor, timelineEpoch: model.timelineEpoch + (scrub ? 0 : 1),
+    playing: model.playing && cursor < scenario.steps.length }
+}
+
+const startScenario = (model: Model, index: number): Model => ({
+  ...model, scenario: index, cursor: 0, history: [], playing: false, elapsed: 0,
+  timelineEpoch: model.timelineEpoch + 1, active: planeIndexForMachine(scenarios[index].machine), selected: ""
+})
+
+export const update = (model: Model, message: Message): Update.Return<Model, Message> =>
+  Message.match(message, {
+    Selected: ({ id }) => ({ model: { ...model, selected: model.selected === id ? "" : id } }),
+    Responsive: ({ mobile }) => ({ model: { ...model, mobile } }),
+    LayerSelected: ({ index }) => ({ model: { ...model, active: index, selected: "" } }),
+    CameraChanged: ({ field, raw }) => ({ model: ["tilt", "turn", "spacing", "zoom"].includes(field)
+      ? { ...model, camera: { ...model.camera, [field]: raw } } : model }),
+    CameraZoomed: ({ factor }) => ({ model: { ...model, camera: zoomEnsembleCamera(model.camera, factor) } }),
+    CameraRotated: ({ dx, dy }) => ({ model: { ...model, camera: orbitEnsembleCamera(model.camera, dx, dy) } }),
+    CameraReset: () => ({ model: { ...model, camera: { ...(model.mobile ? mobileCamera : initialCamera), cameraEpoch: model.camera.cameraEpoch + 1 } } }),
+    FlatToggled: () => ({ model: { ...model, camera: { ...model.camera, flat: !model.camera.flat } } }),
+    PlayToggled: () => ({ model: { ...model, playing: !model.playing && model.cursor < scenarios[model.scenario].steps.length, elapsed: 0 } }),
+    PlaybackTick: ({ deltaMs }) => {
+      if (!model.playing) return { model }
+      const elapsed = model.elapsed + deltaMs
+      if (elapsed < 1100) return { model: { ...model, elapsed } }
+      return { model: seekHistory({ ...model, elapsed: 0 }, model.cursor + 1) }
+    },
+    ScenarioSelected: ({ index }) => ({ model: scenarios[index] ? startScenario(model, index) : model }),
+    Next: () => ({ model: seekHistory({ ...model, playing: false }, model.cursor + 1) }),
+    Seek: ({ position, scrub }) => ({ model: seekHistory({ ...model, playing: false }, position, scrub) }),
+    Reset: () => ({ model: startScenario(model, model.scenario) }),
+    RefusalsToggled: () => ({ model: { ...model, refusalsOnly: !model.refusalsOnly } })
+  })
diff --git c/packages/agent-flow-viz/src/fsm/projection.ts w/packages/agent-flow-viz/src/fsm/projection.ts
