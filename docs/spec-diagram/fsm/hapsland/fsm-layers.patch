+declare module "@fsm-diagram/adapter.mjs" {
+  export type Json = null | boolean | number | string | readonly Json[] | { readonly [key: string]: Json }
+  export interface FsmOutcome {
+    readonly machine: string
+    readonly before: number
+    readonly state: number
+    readonly event: number
+    readonly eventTag: string
+    readonly accepted: boolean
+    readonly verdict: "accepted" | "refused" | "held" | "no-change"
+    readonly reason: string
+    readonly laws: readonly string[]
+    readonly value: Json
+    readonly outputs: readonly { readonly kind: string; readonly label: string }[]
+  }
+  export function transition(machine: string, state: Json, event: Json, facts?: Readonly<Record<string, Json>>): FsmOutcome
+  export function validateState(machine: string, value: Json): Json
+  export function displayState(machine: string, value: Json): number
+}
