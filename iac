#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

cmd="${1:-}"
case "$cmd" in
  collect)
    exec python3 "$repo_root/scripts/iac/collect.py" "$@"
    ;;
  plan)
    shift
    exec python3 "$repo_root/scripts/iac/plan.py" "$@"
    ;;
  links)
    shift
    exec python3 "$repo_root/scripts/iac/links.py" "$@"
    ;;
  ""|-h|--help|help)
    cat <<'EOF'
usage: ./iac <command> [options]

commands:
  collect        collect read-only live machine state
  plan           compare observed state with fleet.toml
  links scan     inventory .files-owned symlinks and generate rollout scripts

No mutating apply command exists yet. Destructive transitions are never part of
normal convergence.
EOF
    ;;
  *)
    printf 'unknown iac command: %s\n' "$cmd" >&2
    exit 2
    ;;
esac
