#!/usr/bin/env python3
"""fleet: run work on the owner's tailnet workers and keep them healthy (run on groot).

  fleet nodes                                   registry + live probe, one line per node
  fleet run [opts] -- CMD...                    run CMD on the least-loaded eligible node
      --node NAME|auto  --class C  --arch amd64|arm64  --tolerate phone
      --mem 2G  --cpus 2  --timeout 3600  --src DIR (default: cwd)  --no-src
      --fetch PATH (repeatable, relative to the job dir)  --keep
      (--class matches a node's classes or its capabilities, e.g. android-build;
       scripts/fleet-build wraps this with the default routing for builds)
  fleet kill NODE JOB_ID                        stop a running host-lane job
  fleet health [--node N] [--strikes K] [--set key=value]   probe, judge, cordon/uncordon
  fleet labels                                  apply class labels/taints from config/fleet/nodes.yaml
  fleet enroll NODE                             harden a registered Linux node over root ssh
  fleet toolchain NODE [--check]                install the node's `toolchains` (JDK, Android SDK, Bun)
  fleet update NODE [--apply]                   show pending updates; --apply cordons, upgrades, uncordons
  fleet install-timer                           user systemd timer: `fleet health` every 2 minutes

Trusted jobs (`fleet run`) reuse the owner's host toolchain. MBP jobs are
Kueue-admitted Jobs; `--node mbp-host` reserves the same quota for a native
systemd scope. Other Linux workers use capped agentjob scopes, and phones use
polite-run. Untrusted code belongs in the restricted k3s `factory` queue.
"""
import argparse
import concurrent.futures as cf
import json
import math
import os
import random
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parent.parent
REGISTRY = REPO / "config/fleet/nodes.yaml"
STATE = Path(os.environ.get("FLEET_STATE", Path.home() / ".local/state/fleet"))
KUBECONFIG = os.environ.get("KUBECONFIG", str(Path.home() / ".kube/k3s.yaml"))
KEY = os.environ.get("FLEET_SSH_KEY", str(Path.home() / ".ssh/id_ed25519"))
ANNOT = "z0.dev/cordoned-by"


def die(msg, code=1):
    print(f"fleet: {msg}", file=sys.stderr)
    sys.exit(code)


def merge(a, b):
    out = dict(a)
    for k, v in (b or {}).items():
        out[k] = merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def registry():
    reg = yaml.safe_load(REGISTRY.read_text())
    nodes = {}
    for name, n in reg["nodes"].items():
        n = merge({"health": reg["defaults"]["health"], "lane": reg["defaults"]["lane"]}, n)
        n["name"] = name
        n.setdefault("kind", "linux")
        n.setdefault("ssh_user", "agentjob")
        n.setdefault("ssh_port", 22)
        n.setdefault("classes", [])
        n.setdefault("taints", [])
        n.setdefault("capabilities", [])
        n.setdefault("toolchains", [])
        n["k8s"] = n["kind"] == "linux"
        n["lane_enabled"] = n["role"] == "worker"
        nodes[name] = n
    return reg, nodes


def resolve(nodes, name):
    """A node's registry name; also accepts its `aliases` (s22 -> galaxy-s22plus)."""
    if not name or name in nodes:
        return name
    return next((k for k, n in nodes.items() if name in n.get("aliases", [])), name)


def mb(s):
    s = str(s).strip().upper()
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([KMGT]?)I?B?", s)
    if not m:
        die(f"bad size {s}")
    return int(float(m.group(1)) * {"": 1 / 2**20, "K": 1 / 1024, "M": 1, "G": 1024, "T": 2**20}[m.group(2)])


def ssh_cmd(n, user=None, port=None):
    user = user or n["ssh_user"]
    port = port or n["ssh_port"]
    ctl = Path.home() / ".ssh"
    return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "IdentitiesOnly=yes",
            "-i", KEY, "-o", "ServerAliveInterval=30", "-o", "ControlMaster=auto",
            "-o", f"ControlPath={ctl}/cm-fleet-%r@%h:%p", "-o", "ControlPersist=120",
            "-p", str(port), f"{user}@{n['tailnet_ip']}"]


def probe_path(n):
    return "~/.local/lib/fleet/fleet-node-probe" if n["kind"] == "phone" else "/usr/local/bin/fleet-node-probe"


def probe(n):
    """Run the node's probe; groot probes itself locally."""
    if n["kind"] == "boat":
        result = subprocess.run([sys.executable, str(REPO / "scripts/boat"), "limits"],
                                capture_output=True, text=True, timeout=90)
        try:
            return {"boat_limits": json.loads(result.stdout)}
        except ValueError:
            return {"error": "Boat limits unavailable"}
    try:
        if n["role"] == "server":
            out = subprocess.run([sys.executable, str(REPO / "scripts/fleet-node-probe")],
                                 capture_output=True, text=True, timeout=60).stdout
        else:
            out = subprocess.run(ssh_cmd(n) + [f"python3 {probe_path(n)}"], capture_output=True,
                                 text=True, timeout=90).stdout
        return json.loads(out.strip().splitlines()[-1])
    except (subprocess.TimeoutExpired, IndexError, ValueError) as e:
        return {"error": f"probe failed: {type(e).__name__}"}


def kc(*args, check=True):
    return subprocess.run(["kubectl", *args], env={**os.environ, "KUBECONFIG": KUBECONFIG},
                          capture_output=True, text=True, check=check)


def k8s_nodes():
    try:
        items = json.loads(kc("get", "nodes", "-o", "json").stdout)["items"]
    except (subprocess.CalledProcessError, ValueError):
        return {}
    out = {}
    for it in items:
        conds = {c["type"]: c["status"] for c in it["status"].get("conditions", [])}
        out[it["metadata"]["name"]] = {
            "conditions": conds,
            "unschedulable": bool(it["spec"].get("unschedulable")),
            "cordoned_by": it["metadata"].get("annotations", {}).get(ANNOT),
        }
    return out


def tailnet_online():
    try:
        st = json.loads(subprocess.run(["tailscale", "status", "--json"], capture_output=True,
                                       text=True, timeout=20).stdout)
    except (ValueError, subprocess.TimeoutExpired):
        return {}
    self_ips = st.get("Self", {}).get("TailscaleIPs") or []
    out = {self_ips[0]: True} if self_ips else {}
    for p in st.get("Peer", {}).values():
        if p.get("TailscaleIPs"):
            out[p["TailscaleIPs"][0]] = bool(p.get("Online"))
    return out


# ---------------------------------------------------------------- phone keep-alive

def tern_doctor(n):
    """`tern remote doctor` from groot: does the phone's `tern remote serve` accept us?"""
    tern = shutil.which("tern") or str(Path.home() / ".local/bin/tern")
    try:
        r = subprocess.run([tern, "remote", "doctor", f"{n['ssh_user']}@{n['tailnet_ip']}"],
                           capture_output=True, text=True, timeout=45, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"failed: {type(e).__name__}"
    lines = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()]
    if any(l.startswith("ok") and " auth " in f"{l} " for l in lines):
        return "ok"
    bad = [l for l in lines if not l.startswith(("ok", "warn", "skip"))]
    return " ".join((bad[0] if bad else f"exit {r.returncode}").split())[:160]


def adb_device(host):
    """groot's adb serial for a phone's Android tailnet IP (the port changes), or None."""
    try:
        out = subprocess.run(["adb", "devices"], capture_output=True, text=True, timeout=15).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in out.splitlines()[1:]:
        f = line.split()
        if len(f) >= 2 and f[1] == "device" and f[0].startswith(host + ":"):
            return f[0]
    return None


def android_state(n):
    """Read-only: is Omalauncher's foreground service (it holds the guest) up, is the screen on?"""
    host = (n.get("android") or {}).get("adb_host")
    serial = adb_device(host) if host else None
    if not serial:
        return None

    def sh(cmd):
        return subprocess.run(["adb", "-s", serial, "shell", cmd], capture_output=True, text=True,
                              timeout=20).stdout
    try:
        svc = sh("dumpsys activity services dev.omalauncher")
        wake = sh("dumpsys power | grep -m1 mWakefulness=").strip()
    except (OSError, subprocess.TimeoutExpired):
        return {"adb": serial, "error": "adb timeout"}
    return {"adb": serial, "omalauncher_fgs": "isForeground=true" in svc,
            "wakefulness": wake.split("=")[-1] or None}


def maybe_revive(n, st, s, pr):
    """Opt-in (`android.revive: true`): reopen Omalauncher, whose MainActivity is the only
    thing that starts the Linux guest, but only when the guest is truly down: the probe
    could not reach it over ssh, `tern remote doctor` failed too, and Omalauncher's
    foreground service is gone (process killed). A guest whose services merely restart
    is the supervisor's job (it restarts them within a second, inside the guest).
    Only while the screen is off and at most every 15 min, so it never takes over a
    screen in use. Linux startup runs the guest's PulseAudio hook, which starts the
    supervisor, so no window has to open."""
    if not (n.get("android") or {}).get("revive") or not st or "error" in st:
        return None
    if "error" not in pr or pr.get("tern_doctor") == "ok":
        return None
    if st.get("omalauncher_fgs") or st.get("wakefulness") in (None, "Awake"):
        return None
    if time.time() - s.get("revived_ts", 0) < 900:
        return None
    subprocess.run(["adb", "-s", st["adb"], "shell", "am start -n dev.omalauncher/.MainActivity"],
                   capture_output=True, text=True, timeout=20)
    s["revived_ts"] = int(time.time())
    return "revived"


# ---------------------------------------------------------------- health

def judge(n, p, k8s, online, overrides):
    """Return a list of failure reasons (empty = healthy) and a list of warnings."""
    h = merge(n["health"], overrides)
    if n["kind"] == "boat":
        limits = p.get("boat_limits", {})
        return ([] if limits.get("canStart") else [p.get("error", "Boat cannot start")]), []
    bad, warn = [], []
    # The probe crossing the tailnet is the stronger signal; a peer's Online flag can lag.
    if "error" in p and not online.get(n["tailnet_ip"], False):
        bad.append("tailscale offline")
    if n["kind"] == "phone":
        if p.get("tern_doctor") not in (None, "ok"):
            bad.append(f"tern remote doctor: {p['tern_doctor']}")
        if (p.get("android") or {}).get("omalauncher_fgs") is False:
            bad.append("omalauncher service not running (app process killed)")
    if "error" in p:
        bad.append(p["error"])
        return bad, warn
    if n["kind"] == "phone" and p.get("supervisor_session") not in (None, "audio"):
        warn.append(f"supervisor runs in the {p['supervisor_session']} session, not Omalauncher's audio one")
    if p["mem_available_mb"] < int(h["min_mem_available_mb"]):
        bad.append(f"memory {p['mem_available_mb']}MiB < {h['min_mem_available_mb']}MiB")
    for key in ("disk_root", "disk_k3s", "disk_lane"):
        d = p.get(key)
        if d and d["free_gb"] < float(h["min_disk_free_gb"]):
            bad.append(f"{key} {d['free_gb']}GiB free < {h['min_disk_free_gb']}GiB")
    if p.get("services"):
        for unit, state in p["services"].items():
            if unit.startswith("k3s") and not n["k8s"]:
                continue
            if state != "active":
                bad.append(f"{unit} {state}")
    pw = p.get("power") or {}
    profile = p.get("phone_profile") or {"mode": "light"}
    worker = n["kind"] == "phone" and profile.get("mode") == "worker"
    if not worker and p.get("max_temp_c") and p["max_temp_c"] > float(h["max_temp_c"]):
        bad.append(f"temperature {p['max_temp_c']}C")
    floor = int(profile.get("min_battery_pct", 0)) if worker else 50
    if pw.get("source") == "unreadable" and n["kind"] == "phone" and (not worker or floor):
        bad.append("battery unreadable (fail closed)")
    for b in pw.get("batteries", []):
        charging = pw.get("on_ac") or b.get("status") in ("Charging", "Full")
        minimum = floor if n["kind"] == "phone" else int(h["min_battery_pct_on_battery"])
        if (worker or not charging) and b.get("pct") is not None and b["pct"] < minimum:
            bad.append(f"battery {b['pct']}% < {minimum}%")
        elif not charging:
            warn.append(f"on battery ({b.get('pct')}%)")
    if n["kind"] == "phone" and not worker:
        if (pw.get("battery_temp_c") or 0) > 40:
            bad.append(f"battery {pw['battery_temp_c']}C")
        if (pw.get("android_thermal_status") or 0) > int(h.get("max_android_thermal_status", 1)):
            bad.append(f"android thermal status {pw['android_thermal_status']}")
    if p.get("maintenance"):
        bad.append("maintenance")
    if n["k8s"]:
        kn = k8s.get(n["name"])
        if not kn:
            bad.append("not a k8s node")
        else:
            c = kn["conditions"]
            if c.get("Ready") != "True":
                bad.append(f"k8s Ready={c.get('Ready')}")
            for t in ("MemoryPressure", "DiskPressure", "PIDPressure"):
                if c.get(t) == "True":
                    bad.append(f"k8s {t}")
    up = p.get("updates") or {}
    if up.get("pending"):
        warn.append(f"{up['pending']} updates pending ({up.get('core_pending', 0)} core)")
    if p.get("reboot_required") or up.get("reboot_required"):
        warn.append("reboot required (kernel updated)")
    return bad, warn


def cmd_health(args):
    reg, nodes = registry()
    sel = [nodes[args.node]] if args.node else list(nodes.values())
    overrides = {}
    for kv in args.set or []:
        k, v = kv.split("=", 1)
        overrides[k] = v
    k8s = k8s_nodes()
    online = tailnet_online()
    with cf.ThreadPoolExecutor(8) as ex:
        probes = dict(zip([n["name"] for n in sel], ex.map(probe, sel)))
        phones = [n for n in sel if n["kind"] == "phone"]
        doctors = dict(zip([n["name"] for n in phones], ex.map(tern_doctor, phones)))
    for n in phones:  # adb is one server; ask it serially
        probes[n["name"]]["tern_doctor"] = doctors[n["name"]]
        st = android_state(n)
        if st:
            probes[n["name"]]["android"] = st
    hdir = STATE / "health"
    hdir.mkdir(parents=True, exist_ok=True)
    state_f = hdir / "state.json"
    state = json.loads(state_f.read_text()) if state_f.exists() else {}
    rc = 0
    for n in sel:
        name = n["name"]
        bad, warn = judge(n, probes[name], k8s, online, overrides)
        s = state.setdefault(name, {"bad": 0, "good": 0, "paused": False})
        if bad:
            s["bad"] += 1; s["good"] = 0
        else:
            s["good"] += 1; s["bad"] = 0
        strikes = int(args.strikes or n["health"]["strikes"])
        action = "none"
        mode = n["health"]["on_unhealthy"]
        kn = k8s.get(name)
        # Placement gate closes on the FIRST bad sample, independently of strike
        # hysteresis used for cordon/uncordon. Kueue CPU flavors require this label.
        if n["role"] == "worker" and n["k8s"] and kn:
            thermal = probes[name].get("max_temp_c")
            safe = not bad and isinstance(thermal, (int, float)) and not isinstance(thermal, bool) and math.isfinite(thermal) and thermal > 0
            kc("label", "--overwrite", "node", name, f"z0.dev/cpu-admit={str(safe).lower()}")
        if bad and s["bad"] >= strikes and n["kind"] == "phone":
            action = maybe_revive(n, probes[name].get("android"), s, probes[name]) or action
        if bad and s["bad"] >= strikes:
            if mode == "cordon" and kn and not kn["unschedulable"]:
                kc("cordon", name)
                kc("annotate", "--overwrite", "node", name, f"{ANNOT}=fleet-health",
                   f"z0.dev/unhealthy-reason={'; '.join(bad)[:250]}")
                action = "cordoned"
            elif mode == "pause" and not s["paused"]:
                action = "paused"
            s["paused"] = True
        elif not bad and s["good"] >= strikes and s.get("paused"):
            if mode == "cordon" and kn and kn["unschedulable"] and kn["cordoned_by"] == "fleet-health":
                kc("uncordon", name)
                kc("annotate", "node", name, f"{ANNOT}-", "z0.dev/unhealthy-reason-", check=False)
                action = "uncordoned"
            elif mode == "pause":
                action = "resumed"
            s["paused"] = False
        rec = {"node": name, "ts": int(time.time()), "healthy": not bad, "reasons": bad, "warnings": warn,
               "strikes": s["bad"], "action": action, "paused": s["paused"], "probe": probes[name]}
        (hdir / f"{name}.json").write_text(json.dumps(rec, indent=1) + "\n")
        with open(hdir / "history.jsonl", "a") as f:
            f.write(json.dumps({k: rec[k] for k in ("node", "ts", "healthy", "reasons", "action")}) + "\n")
        if n["kind"] == "phone":  # keep-alive log: services, doctor, Android side
            pr = probes[name]
            with open(hdir / "phone-keepalive.jsonl", "a") as f:
                f.write(json.dumps({"node": name, "ts": rec["ts"], "reachable": "error" not in pr,
                                    "services": pr.get("services"), "tern_doctor": pr.get("tern_doctor"),
                                    "android": pr.get("android"), "action": action}) + "\n")
        flag = "OK " if not bad else "BAD"
        print(f"{flag} {name:14} action={action:10} {'; '.join(bad) or '-'}"
              + (f"  [warn: {'; '.join(warn)}]" if warn else ""))
        rc |= bool(bad)
    state_f.write_text(json.dumps(state, indent=1) + "\n")
    for hist in (hdir / "history.jsonl", hdir / "phone-keepalive.jsonl"):
        lines = hist.read_text().splitlines() if hist.exists() else []
        if len(lines) > 20000:
            hist.write_text("\n".join(lines[-10000:]) + "\n")
    return rc


# ---------------------------------------------------------------- run

def eligible(n, args, state):
    if not n["lane_enabled"]:
        return "no host lane"
    if args.cls and args.cls not in n["classes"] + n["capabilities"]:
        return f"not class/capability {args.cls}"
    if args.arch and n.get("arch") != args.arch:
        return f"arch {n.get('arch')}"
    if args.node in (None, "auto") and any(t not in (args.tolerate or []) for t in n["taints"]):
        return f"taint {n['taints']} not tolerated"
    if state.get(n["name"], {}).get("paused"):
        return "paused by fleet health"
    return None


def cmd_run(args):
    reg, nodes = registry()
    if not args.cmd:
        die("usage: fleet run [opts] -- CMD...")
    def queued_mbp():
        worker = nodes["mbp"]
        if (args.arch and args.arch != worker["arch"]) or (args.cls and args.cls not in worker["classes"] + worker["capabilities"]):
            die("mbp: incompatible architecture or job capability", 75)
        argv = [sys.executable, str(REPO / "scripts/fleet-kueue"),
                "--src", args.src or os.getcwd(), "--mem", args.mem or worker["lane"]["default_mem"],
                "--cpus", args.cpus or "2", "--timeout", str(args.timeout), "--wait", "0"]
        if args.node == "mbp-host":
            argv += ["--host"]
        for option in ("no_src", "keep"):
            if getattr(args, option):
                argv += ["--" + option.replace("_", "-")]
        for option in ("fetch", "input"):
            for value in getattr(args, option) or []:
                argv += ["--" + option, value]
        return subprocess.run(argv + ["--", *args.cmd]).returncode
    if args.node in ("mbp", "mbp-host", "k3s-mbp"):
        return queued_mbp()
    if args.node == "boat":
        if (args.arch and args.arch != "amd64") or (args.cls and args.cls not in nodes["boat"]["classes"] + nodes["boat"]["capabilities"]):
            die("boat: incompatible architecture or job capability", 75)
        argv = [sys.executable, str(REPO / "scripts/fleet-boat"),
                "--mem-mb", str(mb(args.mem or "512M")),
                "--timeout", str(min(args.timeout, 450))]
        for option, value in (("--src", args.src), ("--cpus", args.cpus)):
            if value:
                argv += [option, value]
        for option in ("no_src", "keep"):
            if getattr(args, option):
                argv += ["--" + option.replace("_", "-")]
        for option in ("fetch", "input"):
            for value in getattr(args, option) or []:
                argv += ["--" + option, value]
        return subprocess.run(argv + ["--", *args.cmd]).returncode
    st_f = STATE / "health/state.json"
    state = json.loads(st_f.read_text()) if st_f.exists() else {}
    if args.node and args.node != "auto":
        if args.node not in nodes:
            die(f"unknown node {args.node}")
        cands = [nodes[args.node]]
        why = eligible(cands[0], args, state)
        if why and not why.startswith("taint"):
            die(f"{args.node}: {why}", 75)
    else:
        cands, skipped = [], []
        for n in nodes.values():
            why = eligible(n, args, state)
            (skipped.append(f"{n['name']}({why})") if why else cands.append(n))
        if not cands:
            die("no eligible node: " + ", ".join(skipped), 75)
    k8s = k8s_nodes()
    with cf.ThreadPoolExecutor(8) as ex:
        probes = dict(zip([n["name"] for n in cands], ex.map(probe, cands)))
    best, notes = None, []
    for n in cands:
        p = probes[n["name"]]
        need = int(n["lane"]["mem_floor_mb"]) + mb(args.mem or n["lane"]["default_mem"])
        if "error" in p:
            notes.append(f"{n['name']}: {p['error']}"); continue
        # The health timer's strike window is NOT launch admission. A fresh unsafe
        # probe must hold immediately, even for an explicitly pinned worker.
        thermal = p.get("max_temp_c")
        if n["kind"] == "linux" and (not isinstance(thermal, (int, float)) or isinstance(thermal, bool) or not math.isfinite(thermal) or thermal <= 0):
            notes.append(f"{n['name']}: thermal telemetry unavailable (fail closed)"); continue
        bad, _ = judge(n, p, k8s, {n["tailnet_ip"]: True}, {})
        if bad:
            notes.append(f"{n['name']}: {'; '.join(bad)}"); continue
        if n["k8s"] and k8s.get(n["name"], {}).get("unschedulable"):
            notes.append(f"{n['name']}: cordoned"); continue
        if p["mem_available_mb"] < need:
            notes.append(f"{n['name']}: {p['mem_available_mb']}MiB available < floor+job {need}MiB"); continue
        score = p["load1"] / max(p["ncpu"], 1) + (1 if n["kind"] == "phone" else 0)
        if best is None or score < best[0]:
            best = (score, n, p)
    if not best:
        die("no node has room now: " + "; ".join(notes), 75)
    _, n, p = best
    if n["name"] == "mbp":
        return queued_mbp()
    jid = time.strftime("%Y%m%d-%H%M%S-") + f"{random.randrange(16**4):04x}"
    base = "~/fleet-jobs" if n["kind"] == "phone" else "~/jobs"
    jdir = f"{base}/{jid}"
    logdir = STATE / "runs"
    logdir.mkdir(parents=True, exist_ok=True)
    log = logdir / f"{jid}-{n['name']}.log"
    print(f"fleet: job {jid} -> {n['name']} (load {p['load1']}/{p['ncpu']} cpu, "
          f"{p['mem_available_mb']}MiB available); log {log}", file=sys.stderr)
    ssh = ssh_cmd(n)
    subprocess.run(ssh + [f"mkdir -p {jdir}/src"], check=True)
    if not args.no_src:
        src = Path(args.src or os.getcwd()).resolve()
        if (src / ".git").exists():
            files = subprocess.run(["git", "-C", str(src), "ls-files", "-co", "--exclude-standard", "-z"],
                                   capture_output=True, check=True).stdout
            tar = subprocess.Popen(["tar", "-C", str(src), "--null", "-T", "-", "-czf", "-"],
                                   stdin=subprocess.PIPE, stdout=subprocess.PIPE)
            send = subprocess.Popen(ssh + [f"tar -xzf - -C {jdir}/src"], stdin=tar.stdout)
            tar.stdin.write(files); tar.stdin.close(); tar.stdout.close()
            send.wait(); tar.wait()
        else:
            tar = subprocess.Popen(["tar", "-C", str(src), "-czf", "-", "."], stdout=subprocess.PIPE)
            send = subprocess.Popen(ssh + [f"tar -xzf - -C {jdir}/src"], stdin=tar.stdout)
            tar.stdout.close(); send.wait(); tar.wait()
        # Both ends must succeed: a sender that hits "Cannot stat" (e.g. a checkout
        # switching under it) still yields a valid gzip the receiver accepts, so
        # checking only the receiver would run tests on a partial or mixed tree.
        if send.returncode or tar.returncode:
            die(f"source transfer failed (local tar exit {tar.returncode}, remote tar exit {send.returncode})")
    # Exact artifact inputs are staged only AFTER health admission, never by
    # recursively scanning a render store. Relative destinations cannot escape src.
    for item in getattr(args, 'input', []) or []:
        source, sep, relative = item.rpartition(':')
        rel = Path(relative)
        if not sep or rel.is_absolute() or '..' in rel.parts or not rel.parts or not Path(source).is_file():
            die(f"invalid artifact input {item!r}")

        parent = str(Path(relative).parent)
        with open(source, 'rb') as stream:
            subprocess.run(ssh + [f"mkdir -p {jdir}/src/{shlex.quote(parent)} && cat > {jdir}/src/{shlex.quote(relative)}"],
                           stdin=stream, check=True)
    cmd = " ".join(shlex.quote(c) for c in args.cmd)
    mem = mb(args.mem or n["lane"]["default_mem"])
    floor = int(n["lane"]["mem_floor_mb"])
    if n["kind"] == "phone":
        inner = (f"cd {jdir}/src && exec ~/.local/lib/fleet/polite-run --mem-mb {mem} --floor-mb {floor} "
                 f"--cpus {n['lane'].get('cpus', '0-1')} --timeout {args.timeout} -- "
                 f"env HOME=$HOME/{jdir[2:]} TMPDIR=$HOME/{jdir[2:]} bash -c {shlex.quote(cmd)}")
    else:
        cpu = f"{int(float(args.cpus) * 100)}%" if args.cpus else n["lane"]["cpu_quota"]
        # /etc/fleet/toolchain.env (scripts/fleet-toolchain.sh) puts JAVA_HOME, ANDROID_HOME and
        # GRADLE_USER_HOME in place. Stopping the scope afterwards reaps what the job left
        # running (Gradle and Kotlin daemons), so nothing outlives the job and its memory cap.
        # Re-check on the worker after transfer too: a large source archive can
        # outlive the controller's probe. Missing thermal data holds, never runs.
        gate = ("import json,subprocess,sys,math; "
                "p=json.loads(subprocess.check_output(['python3','/usr/local/bin/fleet-node-probe'])); "
                "t=p.get('max_temp_c'); m=p.get('mem_available_mb',0); "
                f"ok=isinstance(t,(int,float)) and not isinstance(t,bool) and math.isfinite(t) and 0<t<={float(n['health']['max_temp_c'])}; "
                f"why=('temperature %sC > {float(n['health']['max_temp_c'])}C' % t if not ok else 'maintenance' if p.get('maintenance') "
                f"else 'only %sMiB available' % m if m<{floor + mem} else ''); "
                "why and print('fleet: worker gate held: '+why, file=sys.stderr); sys.exit(75 if why else 0)")
        inner = (f"python3 -c {shlex.quote(gate)} || exit 75; "
                 f"avail=$(awk '/^MemAvailable:/{{print int($2/1024)}}' /proc/meminfo); "
                 f"if [ $avail -lt {floor + mem} ]; then echo \"fleet: only ${{avail}}MiB available\" >&2; exit 75; fi; "
                 # Jobs share the lane slice's root-owned MemoryMax: two 6 GiB builds in a 7 GiB
                 # lane OOM each other. Admit only when the slice's anonymous memory leaves room.
                 f"sl=/sys/fs/cgroup/user.slice/user-$(id -u).slice; smax=$(cat $sl/memory.max 2>/dev/null || echo max); "
                 f"if [ \"$smax\" != max ]; then left=$(( (smax - $(awk '/^anon /{{print $2}}' $sl/memory.stat)) / 1048576 )); "
                 f"if [ $left -lt {mem} ]; then echo \"fleet: lane has ${{left}}MiB left for a {mem}MiB job (other jobs running)\" >&2; exit 75; fi; fi; "
                 f"[ -r /etc/fleet/toolchain.env ] && . /etc/fleet/toolchain.env; "
                 f'export UV_CACHE_DIR="$HOME/.cache/uv" npm_config_cache="$HOME/.cache/npm" npm_config_store_dir="$HOME/.local/share/pnpm/store"; '
                 f'mkdir -p "$UV_CACHE_DIR" "$npm_config_cache" "$npm_config_store_dir"; '
                 f"mkdir -p {jdir}/tmp && cd {jdir}/src && TMPDIR=$HOME/{jdir[2:]}/tmp systemd-run --user --scope --quiet "
                 f"--unit=fleet-{jid} -p MemoryMax={mem}M -p MemorySwapMax=512M -p CPUQuota={cpu} "
                 f"-- timeout --kill-after=30 {args.timeout} nice -n 5 bash -c {shlex.quote(cmd)}; rc=$?; "
                 f"systemctl --user stop fleet-{jid}.scope 2>/dev/null; exit $rc")
    with open(log, "w") as lf:
        lf.write(f"# fleet job {jid} node={n['name']} cmd={cmd}\n")
        proc = subprocess.Popen(ssh + [inner], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for line in proc.stdout:
            sys.stdout.buffer.write(line); sys.stdout.flush()
            lf.write(line.decode(errors="replace"))
        rc = proc.wait()
        lf.write(f"# exit {rc}\n")
    for path in args.fetch or []:
        dest = logdir / jid
        dest.mkdir(exist_ok=True)
        t = subprocess.Popen(ssh + [f"tar -C {jdir} -czf - {shlex.quote(path)}"], stdout=subprocess.PIPE)
        subprocess.run(["tar", "-xzf", "-", "-C", str(dest)], stdin=t.stdout)
        t.wait()
        print(f"fleet: fetched {path} -> {dest}", file=sys.stderr)
    if not args.keep:
        subprocess.run(ssh + [f"rm -rf {jdir}"], check=False)
    print(f"fleet: job {jid} on {n['name']} exited {rc}", file=sys.stderr)
    return rc


def cmd_kill(args):
    _, nodes = registry()
    if args.node in ("mbp", "mbp-host", "k3s-mbp"):
        unit = shlex.quote(f"fleet-{args.job}.scope")
        stop = f"if systemctl --user is-active --quiet {unit}; then systemctl --user stop {unit}; fi"
        result = subprocess.run(ssh_cmd(nodes["mbp"]) + ["bash -c " + shlex.quote(stop)])
        if result.returncode:
            return result.returncode  # Never release host quota before host work stops.
        return subprocess.run(["kubectl", "--kubeconfig", str(Path.home() / ".kube/k3s.yaml"),
                               "-n", "fleet-mbp", "delete", "job", args.job,
                               "--cascade=foreground", "--wait=true"]).returncode
    n = nodes[args.node]
    if n["kind"] == "phone":
        r = subprocess.run(ssh_cmd(n) + [f"pkill -TERM -f -- 'fleet-jobs/{args.job}/' ; true"])
    else:
        r = subprocess.run(ssh_cmd(n) + [f"systemctl --user stop fleet-{args.job}.scope"])
    return r.returncode


def cmd_nodes(args):
    reg, nodes = registry()
    k8s = k8s_nodes()
    online = tailnet_online()
    with cf.ThreadPoolExecutor(8) as ex:
        probes = dict(zip(nodes, ex.map(probe, nodes.values())))
    print(f"{'NODE':14} {'KIND':6} {'ARCH':6} {'CLASSES':22} {'ONLINE':6} {'K8S':14} {'LOAD':9} {'MEM_AVAIL':9} {'POWER':14} CAPABILITIES")
    for name, n in nodes.items():
        p = probes[name]
        kn = k8s.get(name)
        ks = "-" if not kn else ("cordoned" if kn["unschedulable"] else "Ready" if kn["conditions"].get("Ready") == "True" else "NotReady")
        pw = p.get("power") or {}
        b = (pw.get("batteries") or [{}])[0]
        pws = "mains" if not pw.get("batteries") else f"{b.get('pct')}% {b.get('status')}"
        load = f"{p.get('load1', '?')}/{p.get('ncpu', '?')}"
        print(f"{name:14} {n['kind']:6} {n.get('arch', '?'):6} {','.join(n['classes']) or '-':22} "
              f"{'yes' if (p.get('boat_limits', {}).get('canStart') if n['kind'] == 'boat' else online.get(n['tailnet_ip'])) else 'no':6} {ks:14} {load:9} "
              f"{str(p.get('mem_available_mb', p.get('error', '?'))):9} {pws:14} {','.join(n['capabilities']) or '-'}")
    for name, c in reg.get("candidates", {}).items():
        print(f"{name:14} (candidate) {c['note']}")


def cmd_labels(args):
    reg, nodes = registry()
    k8s = k8s_nodes()
    caps = sorted({c for n in nodes.values() for c in n["capabilities"]})
    for name, n in nodes.items():
        if not n["k8s"] or name not in k8s:
            continue
        labels = [f"z0.dev/class-{c}={'true' if c in n['classes'] else 'false'}" for c in reg["classes"]]
        # Host-lane toolchains, informational for pods (k3s pods do not see the host toolchain).
        labels += [f"z0.dev/cap-{c}={'true' if c in n['capabilities'] else 'false'}" for c in caps]
        kc("label", "--overwrite", "node", name, *labels)
        for t in n["taints"]:
            kc("taint", "node", name, t, "--overwrite")
        print(f"{name}: {' '.join(labels)} {' '.join(n['taints'])}")


def cmd_enroll(args):
    reg, nodes = registry()
    if args.node not in nodes:
        die(f"{args.node} is not under nodes in {REGISTRY}; add it there first")
    n = nodes[args.node]
    if n["kind"] == "phone":
        return subprocess.run([str(REPO / "scripts/fleet-phone-setup.sh"), f"{n['ssh_user']}@{n['tailnet_ip']}",
                               "--port", str(n["ssh_port"])] + (["--model", n["model"]] if n.get("model") else [])).returncode
    root = ssh_cmd(n, user="root", port=args.port or n["ssh_port"])
    _, server = next((k, v) for k, v in nodes.items() if v["role"] == "server")
    kl = n.get("kubelet", {})
    kargs = []
    for flag, key in (("system-reserved", "system_reserved"), ("kube-reserved", "kube_reserved"),
                      ("eviction-hard", "eviction_hard"), ("eviction-soft", "eviction_soft"),
                      ("eviction-soft-grace-period", "eviction_soft_grace"),
                      ("eviction-minimum-reclaim", "eviction_minimum_reclaim")):
        if kl.get(key):
            kargs += ["--kubelet-arg", f"{flag}={kl[key]}"]
    lane = n["lane"]
    remote = ["bash", "/opt/dotfiles-k3s/scripts/fleet-harden.sh", "worker",
              "--controller-ip", server["tailnet_ip"], "--controller-key", "/opt/dotfiles-k3s/controller.pub",
              "--lane-mem-max", lane["mem_max"], "--lane-cpu-quota", lane["cpu_quota"],
              "--lane-tasks-max", str(lane["tasks_max"]), *kargs]
    tar = subprocess.Popen(["tar", "-C", str(REPO), "-cf", "-", "scripts/fleet-harden.sh", "scripts/fleet-node-probe",
                            "scripts/fleet-toolchain.sh", "scripts/setup-k3s.sh", "config/k3s"], stdout=subprocess.PIPE)
    r = subprocess.run(root + ["install -d -m 0700 /opt/dotfiles-k3s && tar -xf - -C /opt/dotfiles-k3s"], stdin=tar.stdout)
    tar.wait()
    if r.returncode:
        die("copy to node failed")
    pub = Path(KEY + ".pub").read_text()
    subprocess.run(root + ["install -m 0644 /dev/stdin /opt/dotfiles-k3s/controller.pub"], input=pub.encode(), check=True)
    rc = subprocess.run(root + [" ".join(shlex.quote(a) for a in remote)]).returncode
    if rc == 0 and n["toolchains"]:
        rc = subprocess.run(root + ["bash /opt/dotfiles-k3s/scripts/fleet-toolchain.sh install "
                                    + " ".join(map(shlex.quote, n["toolchains"]))]).returncode
    return rc


def cmd_toolchain(args):
    """Install/check registry toolchains using Linux root SSH or admitted phone jobs."""
    _, nodes = registry()
    n = nodes.get(args.node) or die(f"unknown node {args.node}")
    if n["kind"] == "phone":
        packages = n.get("phone_packages", [])
        if not packages:
            die(f"{args.node}: no phone_packages in {REGISTRY}")
        if args.check:
            return subprocess.run(ssh_cmd(n) + ["pacman -Q " + " ".join(map(shlex.quote, packages))]).returncode
        return subprocess.run([sys.executable, str(REPO / "scripts/fleet"), "run",
            "--node", args.node, "--no-src", "--mem", "1G", "--timeout", "1800", "--",
            "pacman", "-S", "--needed", "--noconfirm", *packages]).returncode
    if n["kind"] != "linux" or not n["lane_enabled"]:
        die(f"{args.node}: toolchains are for Linux workers")
    if not n["toolchains"]:
        die(f"{args.node}: no `toolchains` in {REGISTRY}")
    root = ssh_cmd(n, user="root", port=args.port or n["ssh_port"])
    tar = subprocess.Popen(["tar", "-C", str(REPO), "-cf", "-", "scripts/fleet-toolchain.sh"], stdout=subprocess.PIPE)
    r = subprocess.run(root + ["install -d -m 0700 /opt/dotfiles-k3s && tar -xf - -C /opt/dotfiles-k3s"], stdin=tar.stdout)
    tar.wait()
    if r.returncode:
        die("copy to node failed")
    mode = "check" if args.check else "install"
    return subprocess.run(root + [f"bash /opt/dotfiles-k3s/scripts/fleet-toolchain.sh {mode} "
                                  + " ".join(map(shlex.quote, n["toolchains"]))]).returncode


def cmd_update(args):
    _, nodes = registry()
    n = nodes[args.node]
    if n["kind"] != "linux" or n["role"] != "worker":
        die("fleet update handles Linux workers; update groot and phones by hand")
    p = probe(n)
    print(json.dumps(p.get("updates"), indent=1))
    if not args.apply:
        return 0
    root = ssh_cmd(n, user="root")
    kc("cordon", n["name"])
    kc("annotate", "--overwrite", "node", n["name"], f"{ANNOT}=fleet-update")
    kc("drain", n["name"], "--ignore-daemonsets", "--delete-emptydir-data", "--timeout=600s", check=False)
    r = subprocess.run(root + ["touch /var/lib/fleet/maintenance; pacman -Syu --noconfirm; rc=$?; "
                               "rm -f /var/lib/fleet/maintenance; /usr/local/lib/fleet/updates-check; exit $rc"])
    if r.returncode == 0:
        kc("uncordon", n["name"])
        kc("annotate", "node", n["name"], f"{ANNOT}-", check=False)
    else:
        print("fleet: upgrade failed; node stays cordoned for a look", file=sys.stderr)
    print(json.dumps(probe(n).get("updates"), indent=1))
    return r.returncode


def cmd_install_timer(args):
    d = Path.home() / ".config/systemd/user"
    d.mkdir(parents=True, exist_ok=True)
    (d / "fleet-health.service").write_text(f"""[Unit]
Description=fleet: probe workers, cordon unhealthy ones ({REPO}/scripts/fleet)

[Service]
Type=oneshot
Nice=10
Environment=KUBECONFIG={KUBECONFIG}
ExecStart={sys.executable} {REPO}/scripts/fleet health
TimeoutStartSec=240
MemoryMax=256M
""")
    (d / "fleet-health.timer").write_text("""[Unit]
Description=fleet: health check every 2 minutes

[Timer]
OnBootSec=2min
OnUnitInactiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
""")
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={env['XDG_RUNTIME_DIR']}/bus")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True, env=env)
    subprocess.run(["systemctl", "--user", "enable", "--now", "fleet-health.timer"], check=True, env=env)
    print("fleet-health.timer enabled; reports in", STATE / "health")


def cmd_phone_mode(args):
    """Persist one explicit phone profile. This never weakens Android permissions."""
    _, nodes = registry()
    n = nodes.get(args.node)
    if not n or n["kind"] != "phone":
        die("phone-mode requires a registered phone")
    if args.mode:
        profile = n.get("phone_modes", {}).get(args.mode)
        if not profile:
            die(f"{args.node}: no {args.mode} profile in the registry")
        payload = json.dumps({**profile, "mode": args.mode, "runtime": n.get("phone_runtime", {})})
        script = ("import json,os,sys; from pathlib import Path; "
                  "p=Path.home()/'.config/fleet/phone-mode.json'; "
                  "v=json.load(sys.stdin); p.parent.mkdir(parents=True,exist_ok=True); "
                  "t=p.with_suffix('.tmp'); t.write_text(json.dumps(v)+'\\n'); "
                  "t.chmod(0o600); os.replace(t,p); print(p.read_text(),end='')")
        return subprocess.run(ssh_cmd(n) + ["python3 -c " + shlex.quote(script)],
                              input=payload, text=True).returncode
    return subprocess.run(ssh_cmd(n) + ["cat ~/.config/fleet/phone-mode.json"]).returncode


def main():
    ap = argparse.ArgumentParser(prog="fleet", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd_name", required=True)
    sub.add_parser("nodes")
    r = sub.add_parser("run")
    r.add_argument("--node"); r.add_argument("--class", dest="cls"); r.add_argument("--arch")
    r.add_argument("--tolerate", action="append"); r.add_argument("--mem"); r.add_argument("--cpus")
    r.add_argument("--timeout", type=int, default=3600); r.add_argument("--src"); r.add_argument("--no-src", action="store_true")
    r.add_argument("--fetch", action="append"); r.add_argument("--keep", action="store_true")
    r.add_argument("--input", action="append", default=[], metavar="FILE:RELATIVE_PATH",
                   help="stage an exact artifact under job src after health admission (no directory scans)")
    r.add_argument("cmd", nargs=argparse.REMAINDER)
    k = sub.add_parser("kill"); k.add_argument("node"); k.add_argument("job")
    h = sub.add_parser("health"); h.add_argument("--node"); h.add_argument("--strikes", type=int)
    h.add_argument("--set", action="append", help="override a health threshold, e.g. min_disk_free_gb=99999")
    sub.add_parser("labels")
    e = sub.add_parser("enroll"); e.add_argument("node"); e.add_argument("--port", type=int)
    u = sub.add_parser("update"); u.add_argument("node"); u.add_argument("--apply", action="store_true")
    t = sub.add_parser("toolchain"); t.add_argument("node"); t.add_argument("--check", action="store_true")
    t.add_argument("--port", type=int)
    m = sub.add_parser("phone-mode"); m.add_argument("node")
    m.add_argument("mode", nargs="?", choices=("light", "worker"))
    sub.add_parser("install-timer")
    argv = sys.argv[1:]
    nodes = registry()[1]
    # `fleet run mbp [opts] -- CMD` is shorthand for `fleet run --node mbp [opts] -- CMD`.
    if len(argv) > 1 and argv[0] == "run" and resolve(nodes, argv[1]) in nodes:
        argv = ["run", "--node", argv[1], *argv[2:]]
    args = ap.parse_args(argv)
    if getattr(args, "node", None) and args.node != "auto":
        args.node = resolve(nodes, args.node)
    if args.cmd_name == "run" and args.cmd and args.cmd[0] == "--":
        args.cmd = args.cmd[1:]
    fn = {"nodes": cmd_nodes, "run": cmd_run, "kill": cmd_kill, "health": cmd_health, "labels": cmd_labels,
          "enroll": cmd_enroll, "update": cmd_update, "toolchain": cmd_toolchain,
          "phone-mode": cmd_phone_mode, "install-timer": cmd_install_timer}[args.cmd_name]
    sys.exit(fn(args) or 0)


if __name__ == "__main__":
    main()
