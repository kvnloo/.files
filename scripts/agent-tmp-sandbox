#!/usr/bin/env bash
# Give agent-hosting user units a private, disk-backed /tmp (host /tmp is tmpfs).
#   agent-tmp-sandbox install [UNIT...]   link drop-in, create dirs, restart units
#   agent-tmp-sandbox verify  [UNIT...]   fail unless each running unit sees the sandbox
# Run on the target host (e.g. `ssh mbp ~/workspace/.files/scripts/agent-tmp-sandbox install`).
set -euo pipefail
repo=$(dirname "$(dirname "$(readlink -f "$0")")")
cmd=${1:-verify}; shift || true
units=("$@")
[[ ${#units[@]} -gt 0 ]] || units=(t3code tern-remote hermes-gateway)
base=$HOME/.cache/agent-tmp
udir=$HOME/.config/systemd/user

write_tmpfiles() {
  mkdir -p "$HOME/.config/user-tmpfiles.d"
  {
    echo "# Generated by scripts/agent-tmp-sandbox: per-unit agent /tmp, contents aged after 2 days idle."
    echo "d $base 0700 - - -"
    for u in "${units[@]}"; do echo "d $base/$u 0700 - - 2d"; done
  } > "$HOME/.config/user-tmpfiles.d/agent-tmp.conf"
  systemd-tmpfiles --user --create "$HOME/.config/user-tmpfiles.d/agent-tmp.conf"
}

verify() {
  local bad=0 u pid
  for u in "${units[@]}"; do
    pid=$(systemctl --user show -p MainPID --value "$u")
    if [[ $pid == 0 ]]; then echo "FAIL $u: not running"; bad=1; continue; fi
    if [[ $(stat -Lc %d:%i "/proc/$pid/root/tmp" 2>/dev/null) == $(stat -c %d:%i "$base/$u") ]]; then
      echo "OK   $u (pid $pid): /tmp -> $base/$u"
    else
      echo "FAIL $u (pid $pid): /tmp is the host tmpfs"; bad=1
    fi
  done
  return $bad
}

case $cmd in
  install)
    write_tmpfiles
    for u in "${units[@]}"; do
      mkdir -p "$udir/$u.service.d"
      ln -sfn "$repo/config/systemd/user/agent-private-tmp.conf" "$udir/$u.service.d/agent-private-tmp.conf"
    done
    systemctl --user daemon-reload
    for u in "${units[@]}"; do systemctl --user restart "$u"; done
    sleep 3; verify ;;
  verify) verify ;;
  *) echo "usage: $0 install|verify [UNIT...]" >&2; exit 2 ;;
esac
