#!/usr/bin/env bash
# Sandbox agent-hosting user units (config/systemd/user/agent-private-tmp.conf).
#   agent-tmp-sandbox install [UNIT...]  copy drop-in onto units, restart them, then verify
#   agent-tmp-sandbox verify  [UNIT...]  units carry the exact drop-in AND a canary unit with that
#                                        drop-in fails every escape attempt (exit 1 on any escape)
# Run on the target host: `ssh mbp ~/.local/lib/agent-tmp-sandbox/scripts/agent-tmp-sandbox verify`.
set -euo pipefail
self=$(readlink -f "$0")
repo=$(dirname "$(dirname "$self")")
cmd=${1:-verify}; shift || true
units=("$@")
[[ ${#units[@]} -gt 0 ]] || units=(t3code tern-remote hermes-gateway)
base=$HOME/.cache/agent-tmp
udir=$HOME/.config/systemd/user
dropin=$repo/config/systemd/user/agent-private-tmp.conf
canary=agent-sandbox-canary

# Runs INSIDE the canary unit. Each attempt is something an agent might do without thinking.
probe() {
  local t=$1
  try() { local n=$1; shift; if "$@" >/dev/null 2>&1; then echo "ESCAPED $n"; else echo "blocked $n"; fi; }
  try home-file        touch "$HOME/.escape-$t"
  try home-project     sh -c "mkdir -p $HOME/escape-$t && cd $HOME/escape-$t && git init -q"
  try var-tmp          touch "/var/tmp/escape-$t"
  try host-tmp-via-run touch "/run/user/$(id -u)/escape-$t"
  try user-unit        touch "$udir/escape-$t.service"
  try shell-rc         touch "$(readlink -f "$HOME/.config/fish/config.fish")"
  try dotfiles-repo    touch "$HOME/workspace/.files/escape-$t"
  try local-bin        touch "$HOME/.local/bin/escape-$t"
  try dev-shm-600M     dd if=/dev/zero of="/dev/shm/escape-$t" bs=1M count=600
  try systemd-run      systemd-run --user --unit="escape-$t" touch "$HOME/.escape-sdrun-$t"
  try user-bus         busctl --user list
  try docker           docker ps
  try ssh-localhost    ssh -o BatchMode=yes -o ConnectTimeout=3 localhost true
  setsid bash -c "exec -a escape-$t sleep 300" </dev/null >/dev/null 2>&1 &
  echo private > "/tmp/scratch-$t"
  echo "allowed workspace: $(mkdir -p "$HOME/workspace/.canary-$t" && echo ok || echo FAIL)"
  rmdir "$HOME/workspace/.canary-$t" 2>/dev/null || true
}

write_tmpfiles() {
  mkdir -p "$HOME/.config/user-tmpfiles.d"
  {
    echo "# Generated by scripts/agent-tmp-sandbox: per-unit agent /tmp, contents aged after 2 days idle."
    echo "d $base 0700 - - -"
    for u in "${units[@]}" "$canary"; do echo "d $base/$u 0700 - - 2d"; done
  } > "$HOME/.config/user-tmpfiles.d/agent-tmp.conf"
  systemd-tmpfiles --user --create "$HOME/.config/user-tmpfiles.d/agent-tmp.conf"
}

put_dropin() { mkdir -p "$udir/$1.service.d"; install -m 0644 "$dropin" "$udir/$1.service.d/agent-private-tmp.conf"; }

escape_test() {
  local t bad=0 out
  t=$(date +%s)$$
  mkdir -p "$base/$canary"
  printf '[Service]\nType=oneshot\nStandardOutput=truncate:%s\nExecStart=/usr/bin/bash %s probe %s\n' "$base/$canary.log" "$self" "$t" > "$udir/$canary.service"
  put_dropin "$canary"
  systemctl --user daemon-reload
  systemctl --user start "$canary" || true
  out=$(grep -E '^(ESCAPED|blocked|allowed)' "$base/$canary.log" || true)
  echo "$out" | sed 's/^/  canary: /'
  grep -q ESCAPED <<<"$out" && bad=1
  grep -q '^blocked' <<<"$out" || { echo "FAIL canary produced no probe results"; bad=1; }
  # Host-side truth: nothing the canary tried may exist after it ended.
  for f in "$HOME/.escape-$t" "$HOME/escape-$t" "/var/tmp/escape-$t" "/run/user/$(id -u)/escape-$t" \
           "$udir/escape-$t.service" "$HOME/.local/bin/escape-$t" "$HOME/workspace/.files/escape-$t" "$HOME/.escape-sdrun-$t" "/tmp/scratch-$t" "/dev/shm/escape-$t"; do
    [[ -e $f ]] && { echo "FAIL leftover on host: $f"; rm -rf "$f"; bad=1; }
  done
  pgrep -f "escape-$t" >/dev/null && { echo "FAIL process escape-$t outlived the canary"; pkill -f "escape-$t"; bad=1; }
  [[ -e $base/$canary/scratch-$t ]] && rm -f "$base/$canary/scratch-$t" || { echo "FAIL canary /tmp was not the private dir"; bad=1; }
  return $bad
}

verify() {
  local bad=0 u pid
  for u in "${units[@]}"; do
    pid=$(systemctl --user show -p MainPID --value "$u")
    if [[ $pid == 0 ]]; then echo "FAIL $u: not running"; bad=1; continue; fi
    if ! cmp -s "$dropin" "$udir/$u.service.d/agent-private-tmp.conf"; then echo "FAIL $u: drop-in missing or stale"; bad=1; continue; fi
    if [[ $(stat -Lc %d:%i "/proc/$pid/root/tmp" 2>/dev/null) != $(stat -c %d:%i "$base/$u") ]]; then
      echo "FAIL $u (pid $pid): running without the sandbox (restart it)"; bad=1; continue; fi
    # Every process in the unit, not just MainPID: KillMode=process units keep old children.
    local cg out_pids=() p
    cg=/sys/fs/cgroup$(systemctl --user show -p ControlGroup --value "$u")
    for p in $(cat "$cg"/cgroup.procs "$cg"/*/cgroup.procs 2>/dev/null); do
      [[ $(stat -Lc %d:%i "/proc/$p/root/tmp" 2>/dev/null) == $(stat -c %d:%i "$base/$u") ]] || out_pids+=("$p:$(cat /proc/$p/comm 2>/dev/null)")
    done
    if [[ ${#out_pids[@]} -gt 0 ]]; then echo "FAIL $u: unsandboxed processes ${out_pids[*]}"; bad=1; continue; fi
    echo "OK   $u (pid $pid): sandboxed, all processes"
  done
  escape_test || bad=1
  # Any agent harness on this host that is NOT inside a sandbox (ssh-launched, new unit, ...).
  local host_tmp p rogue=()
  host_tmp=$(stat -c %d:%i /tmp)
  for p in $(pgrep -u "$(id -u)" -f '(^|/)(claude|codex|hermes|omp|opencode)( |$)'); do
    [[ $(stat -Lc %d:%i "/proc/$p/root/tmp" 2>/dev/null) == "$host_tmp" ]] && rogue+=("$p:$(cat /proc/$p/comm 2>/dev/null)")
  done
  [[ ${#rogue[@]} -gt 0 ]] && { echo "FAIL agents running outside any sandbox: ${rogue[*]}"; bad=1; }
  [[ $bad == 0 ]] && echo "PASS: no escapes" || echo "FAIL: sandbox not enforced"
  return $bad
}

case $cmd in
  probe) probe "$1" ;;
  install)
    write_tmpfiles
    for u in "${units[@]}"; do put_dropin "$u"; done
    # Daily re-proof; a failure shows in `systemctl --user --failed`.
    printf '[Service]\nType=oneshot\nExecStart=/usr/bin/bash %s verify %s\n' "$self" "${units[*]}" > "$udir/agent-sandbox-verify.service"
    printf '[Timer]\nOnCalendar=daily\nPersistent=true\n[Install]\nWantedBy=timers.target\n' > "$udir/agent-sandbox-verify.timer"
    systemctl --user daemon-reload
    systemctl --user enable --now agent-sandbox-verify.timer
    for u in "${units[@]}"; do systemctl --user restart "$u"; done
    sleep 3; verify ;;
  verify) verify ;;
  *) echo "usage: $0 install|verify [UNIT...]" >&2; exit 2 ;;
esac
