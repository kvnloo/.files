#!/usr/bin/env bash
# Installed as ~/.local/bin/pass-cli. The Proton Pass session lives with the
# `passvault` system user (scripts/passvault-install.sh), so every call goes
# through sudo and asks for the password. There is no fallback to a session
# owned by the login user: if the gate is missing, refuse.
set -euo pipefail

runner=/usr/local/lib/proton-pass/pass-cli-run
if [[ -x "$runner" ]]; then
  exec sudo -k -u passvault "$runner" "$@"
fi
printf 'pass-cli: vault gate not installed; run: sudo %s\n' \
  "$HOME/workspace/.files/scripts/passvault-install.sh" >&2
exit 126
