#!/usr/bin/env python3
"""Trusted MBP host-toolchain jobs, admitted and bounded by Kubernetes/Kueue."""
import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import shlex
import signal
import subprocess
import sys
import time
import uuid
import socket
from artifact_lease import create as create_artifact_lease, shell_create as artifact_lease_command, terminal_command
from fleet_source import source_snapshot


def checked(argv, **kwargs):
    return subprocess.run(argv, check=True, **kwargs)


def workload_class(explicit, command, cpus, quota):
    if explicit:
        return explicit
    if any(Path(word).name in ('pytest', 'py.test') for word in command):
        return 'test'
    return 'bench' if float(cpus) == quota else 'build'


def workload_evicted(workload):
    conditions = {c['type']: c['status'] for c in workload.get('status', {}).get('conditions', [])}
    return conditions.get('Evicted') == 'True' or (
        not workload.get('status', {}).get('admission')
        and any(conditions.get(key) == 'True' for key in ('Preempted', 'Requeued')))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--src')
    parser.add_argument('--src-include', action='append', default=[])
    parser.add_argument('--attach', metavar='JOB', help='observe an existing job without submitting or replaying it')
    parser.add_argument('--no-src', action='store_true')
    parser.add_argument('--node')
    parser.add_argument('--class', dest='job_class')
    parser.add_argument('--priority-class', choices=('test', 'build', 'bench'))
    parser.add_argument('--checkpoint-safe', action='store_true',
                        help='command resumes atomically checkpointed work in the persistent source stage')
    parser.add_argument('--mem', default='3G')
    parser.add_argument('--cpus', default='2')
    parser.add_argument('--timeout', type=int, default=3600)
    parser.add_argument('--wait', type=int, default=1800)
    parser.add_argument('--keep', action='store_true')
    parser.add_argument('--host', action='store_true',
                        help='reserve Kueue quota, then run in a bounded host systemd scope')
    parser.add_argument('--fetch', action='append', default=[])
    parser.add_argument('--out')
    parser.add_argument('--input', action='append', default=[])
    parser.add_argument('--tolerate', action='append')
    parser.add_argument('cmd', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.cmd[:1] == ['--']:
        args.cmd.pop(0)
    state = Path(os.environ.get('FLEET_STATE', str(Path.home() / '.local/state/fleet')))
    from fleet_paths import runs_dir
    runs = runs_dir()
    kube = ['kubectl', '--kubeconfig', str(Path.home() / '.kube/k3s.yaml'), '-n', 'fleet-mbp']
    if args.attach:
        if not re.fullmatch(r'fleet-mbp-[0-9a-f]{16}', args.attach):
            parser.error('invalid Kueue job id')
        existing = json.loads(checked(kube + ['get', 'job', args.attach, '-o', 'json'], capture_output=True).stdout)
        receipt = runs / f'{args.attach}.json'
        saved = json.loads(receipt.read_text()) if receipt.exists() else {}
        container = existing['spec']['template']['spec']['containers'][0]
        resources = container['resources']['requests']
        labels = existing['metadata'].get('labels', {})
        args.cpus = str(resources['cpu'])
        if args.cpus.endswith('m'):
            args.cpus = str(float(args.cpus[:-1]) / 1000)
        args.mem = str(resources['memory'])
        args.priority_class = labels.get('kueue.x-k8s.io/priority-class', 'build')
        args.checkpoint_safe = saved.get('checkpoint_safe', args.priority_class == 'bench')
        args.host = saved.get('host', existing['metadata'].get('annotations', {}).get('fleet.z0.dev/host') == 'true')
        if args.host and not saved.get('command'):
            parser.error('host attach requires the original durable receipt containing its command')
        args.cmd = saved.get('command', container['command'])
        args.timeout = saved.get('timeout', existing['spec'].get('activeDeadlineSeconds', 3600))
        args.fetch = args.fetch or saved.get('fetch', [])
        args.out = args.out or saved.get('out')
        args.keep |= saved.get('keep', False)
    elif not args.src:
        parser.error('--src is required for submission')
    if (not args.cmd and not args.attach) or args.timeout <= 0 or args.wait < -1:
        parser.error('command, positive --timeout, and --wait >= -1 required')
    # Match fleet's binary memory units, not Kubernetes decimal G/M quantities.
    match = re.fullmatch(r'(\d+(?:\.\d+)?)([KMGT]?)I?B?', args.mem.upper())
    if not match:
        parser.error('invalid --mem')
    memory = int(float(match[1]) * {'': 1, 'K': 1024, 'M': 1024**2, 'G': 1024**3, 'T': 1024**4}[match[2]])
    if memory <= 0 or not re.fullmatch(r'\d+(?:\.\d+)?', args.cpus) or float(args.cpus) <= 0:
        parser.error('positive memory and CPUs required')
    def relative(value):
        path = Path(value)
        if path.is_absolute() or '..' in path.parts or not path.parts:
            parser.error(f'path must remain within source: {value!r}')
        return path
    for value in args.fetch:
        relative(value)
    inputs = []
    for value in args.input:
        source, sep, dest = value.rpartition(':')
        if not sep or not Path(source).is_file():
            parser.error(f'invalid input: {value!r}')
        inputs.append((source, relative(dest)))

    name = args.attach or 'fleet-mbp-' + uuid.uuid4().hex[:16]
    fleet = runpy.run_path(str(Path(__file__).resolve().with_name('fleet')))
    node = fleet['registry']()[1]['mbp']
    ssh = fleet['ssh_cmd'](node)
    def remote(script):
        # The login shell can be fish with functions shadowing rm. Always run
        # transport and cleanup in a clean, non-login Bash command.
        return ssh + ['bash -c ' + shlex.quote(script)]
    # Preserve the existing host-lane identity and warm HOME caches. This is
    # the owner's trusted host-toolchain lane, not an untrusted-code sandbox.
    info = checked(remote('printf "%s\\n" "$HOME"; id -u; id -g'), capture_output=True, text=True).stdout.splitlines()
    home, uid, gid = info[-3:]
    uid, gid = int(uid), int(gid)
    if uid == 0:
        parser.error('MBP SSH account must not be root')
    stage = f'{home}/.local/state/fleet/kueue/{name}'
    qstage = shlex.quote(stage)
    queue = json.loads(checked(kube + ['get', 'clusterqueue', 'lanes', '-o', 'json'], capture_output=True).stdout)
    quotas = {r['name']: r['nominalQuota'] for group in queue['spec']['resourceGroups']
              for flavor in group['flavors'] if flavor['name'] == 'node-mbp' for r in flavor['resources']}
    def quantity(value):
        match = re.fullmatch(r'(\d+(?:\.\d+)?)([KMGT]i|[kMGT]|m)?', str(value))
        if not match:
            raise RuntimeError(f'unsupported lane quota quantity: {value}')
        return float(match[1]) * {'': 1, 'm': .001, 'k': 1000, 'M': 1000**2,
                                  'G': 1000**3, 'T': 1000**4, 'Ki': 1024,
                                  'Mi': 1024**2, 'Gi': 1024**3, 'Ti': 1024**4}[match[2] or '']
    if not args.attach and (memory > quantity(quotas['memory']) or float(args.cpus) > quantity(quotas['cpu'])):
        print(f'fleet: request exceeds MBP lane quota {quotas}; lower --mem/--cpus (exit 75)', file=sys.stderr)
        return 75
    priority = workload_class(args.priority_class, args.cmd, args.cpus, quantity(quotas['cpu']))
    if priority == 'bench' and not args.checkpoint_safe:
        parser.error('bench requires --checkpoint-safe: persist atomic checkpoints in the source stage and resume on restart')
    queue_name = 'bench-lanes' if priority == 'bench' else 'lanes'
    if args.host and priority == 'bench':
        parser.error('bench cannot use --host; host scopes cannot be safely evicted by Kueue')
    logpath = runs / f'{name}-mbp.log'
    runs.mkdir(parents=True, exist_ok=True)
    created = bool(args.attach)
    terminal = False
    terminal_recorded = False
    logs = None
    rc = 1
    detach_code = 130

    def stop(signum, frame):
        nonlocal detach_code
        detach_code = 128 + signum
        raise KeyboardInterrupt
    for signum in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, stop)
    cache_setup = ('export UV_CACHE_DIR="$HOME/.cache/uv" npm_config_cache="$HOME/.cache/npm" '
                   'npm_config_store_dir="$HOME/.local/share/pnpm/store"; '
                   'mkdir -p "$UV_CACHE_DIR" "$npm_config_cache" "$npm_config_store_dir"; ')
    unit = f'fleet-{name}.service'
    def start_host(runtime):
        wrapper = (
            f'[ ! -r /etc/fleet/toolchain.env ] || . /etc/fleet/toolchain.env; {cache_setup}'
            f'cd {qstage}/src || exit 1; export TMPDIR={qstage}/tmp; '
            f'timeout --kill-after=30 {runtime} nice -n 5 {shlex.join(args.cmd)}; '
            f'rc=$?; printf "%s\\n" "$rc" > {qstage}/host.exit.tmp; '
            f'mv {qstage}/host.exit.tmp {qstage}/host.exit; '
            + terminal_command('(exit "$rc")', qstage))
        script = (
            f'if [ ! -f {qstage}/host.exit ] && '
            f'[ "$(systemctl --user show {shlex.quote(unit)} -p LoadState --value)" = not-found ]; then '
            f'systemd-run --user --quiet --unit={shlex.quote(unit)} '
            f'-p MemoryMax={memory} -p MemorySwapMax=512M -p CPUQuota={float(args.cpus) * 100:g}% '
            f'-p StandardOutput=append:{qstage}/host.log -p StandardError=append:{qstage}/host.log '
            f'-- /usr/bin/bash -c {shlex.quote(wrapper)}; fi')
        checked(remote(script))
    def submit():
        nonlocal created
        checked(remote(f'mkdir -p {qstage}/src {qstage}/tmp && chmod 700 {qstage}'))
        checked(remote(artifact_lease_command(qstage, name, 'mbp', 'spool', ['exit', 'stdout', 'stderr'])))
        src = Path(args.src).resolve()
        source_metadata = None
        if not args.no_src:
            with source_snapshot(src, args.src_include) as (archive, source_metadata):
                (runs / f'{name}.json').write_text(json.dumps({
                    'job_id': name, 'phase': 'staging', 'stage': stage,
                    'source_snapshot': source_metadata}, indent=2) + '\n')
                with archive.open('rb') as stream:
                    checked(remote(f'tar -xzf - -C {qstage}/src'), stdin=stream)
        for source, dest in inputs:
            with open(source, 'rb') as stream:
                checked(remote(f'mkdir -p {qstage}/src/{shlex.quote(str(dest.parent))} && cat > {qstage}/src/{shlex.quote(str(dest))}'), stdin=stream)

        mounts = [{'name': 'work', 'mountPath': '/work'}, {'name': 'home', 'mountPath': home}]
        volumes = [{'name': 'work', 'hostPath': {'path': stage, 'type': 'Directory'}},
                   {'name': 'home', 'hostPath': {'path': home, 'type': 'Directory'}}]
        # Reuse the installed MBP toolchain without a second distro image.
        # Toolchains are read-only; the host user's HOME retains warm caches.
        for index, path in enumerate(['/usr', '/lib', '/lib64', '/opt', '/etc/fleet', '/etc/ssl']):
            volume = f'toolchain-{index}'
            volumes.append({'name': volume, 'hostPath': {'path': path, 'type': 'Directory'}})
            mounts.append({'name': volume, 'mountPath': path, 'readOnly': True})
        resources = {'cpu': args.cpus, 'memory': str(memory)}

        command = (['/usr/bin/bash', '-c', 'while :; do sleep 30; done'] if args.host else
                   ['/usr/bin/bash', '-c', '[ ! -r /etc/fleet/toolchain.env ] || . /etc/fleet/toolchain.env; ' +
                    cache_setup + terminal_command('"$@"', '/work'), 'fleet-kueue', *args.cmd])
        manifest = {
            'apiVersion': 'batch/v1', 'kind': 'Job',
            'metadata': {'name': name, 'labels': {'kueue.x-k8s.io/queue-name': queue_name,
                         'kueue.x-k8s.io/priority-class': priority,
                         'app.kubernetes.io/managed-by': 'fleet-build'},
                         'annotations': {'fleet.z0.dev/host': str(args.host).lower()}},
            # Host reservations outlive timeout's forced-stop grace, so quota
            # cannot expire before the bounded host scope after client loss.
            'spec': {'suspend': True, 'backoffLimit': 0, 'activeDeadlineSeconds': args.timeout + (90 if args.host else 0),
                     'ttlSecondsAfterFinished': 86400, 'template': {'metadata': {'labels': {'fleet-job': name}}, 'spec': {
                         'restartPolicy': 'Never', 'automountServiceAccountToken': False,
                         'nodeSelector': {'kubernetes.io/hostname': 'mbp'},
                         'hostname': 'mbp',
                         'securityContext': {'runAsUser': uid, 'runAsGroup': gid, 'runAsNonRoot': True},
                         'containers': [{'name': 'build', 'image': 'busybox:1.37.0',
                             'command': command,
                             'workingDir': '/work/src',
                             'env': [{'name': k, 'value': v} for k, v in {'HOME': home, 'USER': node['ssh_user'], 'LOGNAME': node['ssh_user'], 'TMPDIR': '/work/tmp', 'PATH': '/usr/local/bin:/usr/bin:/bin', 'FLEET_JOB_ID': name}.items()] +
                                    [{'name': 'FLEET_NODE_NAME', 'valueFrom': {'fieldRef': {'fieldPath': 'spec.nodeName'}}}],
                             'securityContext': {'allowPrivilegeEscalation': False, 'capabilities': {'drop': ['ALL']}},
                             'resources': {'requests': resources, 'limits': resources}, 'volumeMounts': mounts}],
                         'volumes': volumes}}}}
        (runs / f'{name}.json').write_text(json.dumps({
            'job_id': name, 'class': priority, 'checkpoint_safe': args.checkpoint_safe,
            'queue': queue_name,
            'stage': stage, 'cpus': args.cpus, 'memory': memory,
            'command': args.cmd, 'host': args.host, 'timeout': args.timeout,
            'fetch': args.fetch, 'out': args.out, 'keep': args.keep,
            'placement': json.loads(os.environ.get('FLEET_TEST_PLACEMENT') or 'null'),
            'source_snapshot': source_metadata,
        }, indent=2) + '\n')
        checked(kube + ['create', '-f', '-'], input=json.dumps(manifest), text=True)
        created = True
        print(f'fleet: job {name} -> mbp (Kueue {queue_name}); log {logpath}; stage {stage}', file=sys.stderr, flush=True)
    try:
        if not args.attach:
            submit()
        else:
            print(f'fleet: attached {name}; observing existing job only', file=sys.stderr, flush=True)
        # Zero preserves fleet's fail-fast contract; allow only a short
        # controller reconciliation grace. Indefinite queueing is explicit.
        admission_deadline = None if args.wait == -1 else time.monotonic() + (args.wait or 5)
        admitted = False
        pod_name = None
        with logpath.open('ab' if args.attach else 'wb') as logfile:
            while True:
                job = json.loads(checked(kube + ['get', 'job', name, '-o', 'json'], capture_output=True).stdout)
                workload_name = job['spec'].get('template', {}).get('metadata', {}).get('annotations', {}).get('kueue.x-k8s.io/workload')
                workload = (json.loads(checked(kube + ['get', 'workload', workload_name, '-o', 'json'], capture_output=True).stdout)
                            if workload_name else {})
                evicted = workload_evicted(workload)
                suspended = job['spec'].get('suspend', False) or evicted
                exit_code = None
                if suspended and admitted:
                    admitted = False
                    if logs is not None:
                        logs.terminate()
                        logs.wait()
                        reader.join(timeout=5)
                        logs = None
                    print(f'fleet: Kueue suspended {name}; preserving checkpoints', file=sys.stderr, flush=True)
                if not suspended and not admitted:
                    admitted = True
                    # --wait bounds initial admission, not Kueue's subsequent
                    # checkpoint-safe eviction/readmission lifecycle.
                    admission_deadline = None
                    print(f'fleet: Kueue admitted {name}', file=sys.stderr, flush=True)
                pods = ([] if suspended else
                        json.loads(checked(kube + ['get', 'pods', '-l', f'job-name={name}', '-o', 'json'], capture_output=True).stdout)['items'])
                if pods:
                    pod = next((p for p in pods if not p['metadata'].get('deletionTimestamp')), None)
                    if pod is None:
                        time.sleep(2)
                        continue
                    if logs is not None and pod_name != pod['metadata']['name']:
                        logs.terminate()
                        logs.wait()
                        reader.join(timeout=5)
                        logs = None
                    pod_name = pod['metadata']['name']
                    statuses = pod.get('status', {}).get('containerStatuses', [])
                    if logs is None and statuses and ('running' in statuses[0]['state'] or (not args.host and 'terminated' in statuses[0]['state'])):
                        if args.host:
                            runtime = args.timeout
                            if job.get('status', {}).get('startTime'):
                                started = datetime.fromisoformat(job['status']['startTime'].replace('Z', '+00:00')).timestamp()
                                remaining = int(job['spec']['activeDeadlineSeconds'] - (time.time() - started) - 35)
                                if remaining <= 0:
                                    time.sleep(2)
                                    continue
                                runtime = min(runtime, remaining)
                            start_host(runtime)
                        log_command = (remote(f'tail -n +1 -F {qstage}/host.log') if args.host else
                                       kube + ['logs', '-f', pod_name, '-c', 'build'])
                        logs = subprocess.Popen(log_command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
                        # A reader thread streams while the controller observes terminal status.
                        import threading
                        def relay():
                            for line in logs.stdout:
                                sys.stdout.buffer.write(line)
                                sys.stdout.buffer.flush()
                                logfile.write(line)
                                logfile.flush()
                        reader = threading.Thread(target=relay, daemon=True)
                        reader.start()
                    if args.host and logs is not None:
                        result = checked(remote(
                            f'if [ -f {qstage}/host.exit ]; then printf "done="; cat {qstage}/host.exit; '
                            f'else systemctl --user show {shlex.quote(unit)} -p ActiveState -p ExecMainStatus; fi'),
                            capture_output=True, text=True).stdout
                        status = dict(line.split('=', 1) for line in result.splitlines() if '=' in line)
                        if 'done' in status or status.get('ActiveState') in ('inactive', 'failed'):
                            rc = int(status.get('done', status.get('ExecMainStatus', '1')))
                            terminal = True
                            break
                    if statuses and 'terminated' in statuses[0]['state']:
                        exit_code = statuses[0]['state']['terminated']['exitCode']
                # Pod termination (including 137) is not Job completion. Kueue
                # owns eviction/readmission; its eviction status wins over
                # temporarily stale Job conditions during reconciliation.
                if evicted:
                    time.sleep(2)
                    continue
                finished = not workload_name or any(
                    c['type'] == 'Finished' and c['status'] == 'True'
                    for c in workload.get('status', {}).get('conditions', []))
                complete = any(c['type'] == 'Complete' and c['status'] == 'True'
                               for c in job.get('status', {}).get('conditions', []))
                if complete and finished:
                    rc = 0
                    terminal = True
                    break
                failed = next((c for c in job.get('status', {}).get('conditions', []) if c['type'] == 'Failed' and c['status'] == 'True'), None)
                if failed and finished:
                    rc = 124 if failed['reason'] == 'DeadlineExceeded' else (exit_code or 1)
                    terminal = True
                    break
                if not admitted and admission_deadline and time.monotonic() >= admission_deadline:
                    print(f'fleet: admission wait expired for {name}', file=sys.stderr)
                    rc = 75
                    break
                time.sleep(2)
            if logs is not None:
                try:
                    logs.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    logs.terminate()
                    logs.wait()
                reader.join(timeout=5)
            logfile.write(f'\n# exit {rc}\n'.encode())
        if terminal:
            receipt = runs / f'{name}.json'
            evidence = json.loads(receipt.read_text()) if receipt.exists() else {'job_id': name}
            evidence['terminal'] = {'exit_code': rc, 'job': job, 'workload': workload, 'pods': pods}
            temporary = receipt.with_suffix('.json.tmp')
            temporary.write_text(json.dumps(evidence, indent=2) + '\n')
            os.replace(temporary, receipt)
            terminal_recorded = True
            reasons = [s['state']['terminated'].get('reason', 'Unknown')
                       for p in pods for s in p.get('status', {}).get('containerStatuses', [])
                       if 'terminated' in s.get('state', {})]
            print(f'fleet: terminal evidence {receipt}; container reasons: {reasons}', file=sys.stderr)
            for value in args.fetch:
                dest = runs / name
                dest.mkdir(exist_ok=True)
                create_artifact_lease(dest, name, socket.gethostname(), 'spool', args.fetch)
                tar = subprocess.Popen(remote(f'tar -C {qstage} -czf - {shlex.quote(value)}'), stdout=subprocess.PIPE)
                receive = subprocess.Popen(['tar', '-xzf', '-', '-C', str(dest)], stdin=tar.stdout)
                tar.stdout.close()
                receive.wait()
                tar.wait()
                if receive.returncode or tar.returncode:
                    raise RuntimeError(f'artifact fetch failed: {value}')
                if args.out:
                    output = Path(args.out)
                    output.mkdir(parents=True, exist_ok=True)
                    create_artifact_lease(output, name, socket.gethostname(), 'spool', [Path(item).name for item in args.fetch])
                    artifact = dest / value
                    target = output / artifact.name
                    if artifact.is_dir():
                        shutil.copytree(artifact, target, dirs_exist_ok=True)
                    else:
                        shutil.copy2(artifact, target)
        print(f'fleet: job {name} on mbp exited {rc}', file=sys.stderr)
        return rc
    except KeyboardInterrupt:
        return detach_code
    finally:
        if args.host and created and terminal:
            # Only confirmed host completion permits releasing its reservation.
            checked(remote(f'systemctl --user stop {shlex.quote(unit)}; '
                           f'systemctl --user reset-failed {shlex.quote(unit)} 2>/dev/null || true'))
        if logs is not None and logs.poll() is None:
            logs.terminate()
            logs.wait()
        # Controller loss is detach, never an implicit remote cancellation.
        if created and terminal and terminal_recorded and (args.host or not args.keep):
            checked(kube + ['delete', 'job', name, '--cascade=foreground', '--wait=true', '--ignore-not-found=true', '--timeout=60s'])
        if created and not terminal:
            print(f'fleet: detached job {name}; retained checkpoint stage {stage}; '
                  f'receipt {runs / (name + ".json")}; reattach: fleet-build --attach {name}', file=sys.stderr)
        elif terminal and terminal_recorded and not args.keep:
            checked(remote(f'rm -rf -- {qstage}'))


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (subprocess.CalledProcessError, RuntimeError, ValueError) as exc:
        print(f'fleet-kueue: {exc}', file=sys.stderr)
        sys.exit(1)
