#!/usr/bin/env python3
"""Snapshot tracked drift sources; dry run unless --apply. Never repairs host drift."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import shlex
import sys
import tempfile
import tomllib

sys.path.insert(0, str(Path(__file__).resolve().parent))
import host_layout  # noqa: E402

CLOSURE = ('scripts/host-drift', 'scripts/service-watch.py', 'scripts/dash-log-watch.py',
           'scripts/dash-log-watch-model.py', 'scripts/service-watch-confirm.ts',
           'scripts/worktree-reaper.py', 'scripts/artifact-leases.py',
           'config/systemd/user/host-drift.service', 'config/systemd/user/host-drift.timer',
           'config/systemd/user/service-watch-failure@.service',
           'config/systemd/user/service-watch-heartbeat.service',
           'config/host/z0-guard-state.json', 'scripts/host_layout.py', 'scripts/host_admission.py', 'fleet.toml')


def install(source, home, apply):
    tracked = set(subprocess.check_output(['git', '-C', str(source), 'ls-files'], text=True).splitlines())
    layout = host_layout.resolve(source, home=home)
    manifest = tomllib.loads((source / layout.manifest).read_text())
    names = set(CLOSURE) | {layout.manifest}
    names.update(row['source'] for scope in ('system', 'user') for row in manifest.get(scope, []))
    for scope in ('system', 'user'):
        for row in manifest.get(scope, []):
            if row['install'] == 'generated':
                argv = shlex.split(row.get('generator', ''))
                if len(argv) != 3 or argv[1] != '--render':
                    raise ValueError('invalid offline render generator')
                names.add(argv[0])
    payload = {}
    for name in sorted(names):
        if name not in tracked or Path(name).is_absolute() or '..' in Path(name).parts:
            raise ValueError(f'not a tracked source: {name}')
        path = source / name
        payload[name] = (path.read_bytes(), path.stat().st_mode & 0o777)
    payload['tracked-files.json'] = (json.dumps(sorted(names)).encode(), 0o644)
    digest = hashlib.sha256()
    for name, (data, mode) in sorted(payload.items()):
        digest.update(f'{name}\0{mode}\0{len(data)}\0'.encode())
        digest.update(data)
    base = home / '.local/lib/files-host-drift'
    release = base / digest.hexdigest()
    print(f'{"APPLY" if apply else "DRY RUN"}: release={release}; link checker/timer; enable timer only; no repairs or watched-service restarts')
    if not apply:
        return 0
    base.mkdir(parents=True, exist_ok=True)
    if not release.exists():
        staging = Path(tempfile.mkdtemp(prefix='.install-', dir=base))
        try:
            for name, (data, mode) in payload.items():
                path = staging / name
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(data)
                path.chmod(mode)
            staging.rename(release)
        finally:
            if staging.exists():
                shutil.rmtree(staging)
    for name, (data, mode) in payload.items():
        path = release / name
        if path.read_bytes() != data or path.stat().st_mode & 0o777 != mode:
            raise ValueError(f'stamp mismatch: {path}')
    links = {home / '.local/bin/host-drift': release / 'scripts/host-drift',
             home / '.local/bin/service-watch': release / 'scripts/service-watch.py',
             home / '.config/z0-guard/state.json': release / 'config/host/z0-guard-state.json',
             base / 'current': release}
    for unit in ('host-drift.service', 'host-drift.timer', 'service-watch-failure@.service',
                 'service-watch-heartbeat.service'):
        links[home / '.config/systemd/user' / unit] = release / 'config/systemd/user' / unit
    backup = home / '.local/state/host-drift/backups' / digest.hexdigest()
    for dest in links:
        host_layout.admit_live(dest, host_layout.Live.ABSENT)
    for dest, target in links.items():
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.is_symlink() and dest.resolve() == target:
            continue
        if dest.exists() or dest.is_symlink():
            saved = backup / dest.relative_to(home)
            saved.parent.mkdir(parents=True, exist_ok=True)
            if not saved.exists() and not saved.is_symlink():
                shutil.copy2(dest, saved, follow_symlinks=False)
        temporary = dest.with_name(dest.name + '.host-drift-new')
        temporary.symlink_to(target)
        os.replace(temporary, dest)
    subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True)
    subprocess.run(['systemctl', '--user', 'enable', '--now', 'host-drift.timer'], check=True)
    print(f'Installed release {release}; backups={backup}')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument('--apply', action='store_true')
    args = parser.parse_args()
    return install(args.source.resolve(), Path.home(), args.apply)


if __name__ == '__main__':
    raise SystemExit(main())
