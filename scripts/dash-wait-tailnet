#!/usr/bin/env python3
"""Wait for the configured tailnet address; never fall back to a public bind."""
import os
import socket
import time

host = os.environ.get('DASH_HOST') or os.environ['REACT_NATIVE_PACKAGER_HOSTNAME']
deadline = time.monotonic() + 100
while True:
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
            probe.bind((host, 0))
        break
    except OSError:
        if time.monotonic() >= deadline:
            raise SystemExit('Dash tailnet address unavailable; systemd will retry')
        time.sleep(2)
