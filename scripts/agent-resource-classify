#!/usr/bin/env python3
"""Route user coding-agent trees out of the compositor cgroup."""
import json, os, pathlib, subprocess, sys

def snapshot(starttimes=None, proc=pathlib.Path('/proc')):
    data = {}
    for p in proc.iterdir():
        if not p.name.isdigit():
            continue
        try:
            if p.stat().st_uid != os.getuid():
                continue
            status = dict(line.split(':', 1) for line in (p/'status').read_text().splitlines() if ':' in line)
            name = (p/'comm').read_text().strip()
            args = (p/'cmdline').read_bytes().split(b'\0')
            # comm alone is not ownership: a renamed browser/compositor must not
            # turn into an agent root. Match the executable or a known CLI entry.
            exe = pathlib.Path(os.readlink(p/'exe')).name
            entry = pathlib.PurePath(args[0].decode(errors='replace')).name if args else ''
            controls = {'hermes', 'claude', 'omp', 'codex', 'pi'}
            known_cli = (name in controls and (exe == name or entry == name or
                (name == 'hermes' and any(b'from hermes_cli.main import main' in a for a in args)) or
                (name == 'claude' and any(b'@anthropic-ai/claude-code/' in a for a in args)) or
                (name in {'omp', 'pi'} and any(b'/pi-coding-agent/' in a or b'/oh-my-pi/' in a for a in args))))
            if known_cli:
                name = 'agent-control'
            if name == 'blender' and b'--background' in args:
                name = 'agent-batch'
            if name in {'python', 'python3'} and any(pathlib.PurePath(a.decode(errors='replace')).name in {'train_sft.py', 'build_index.py'} for a in args[1:]):
                name = 'agent-batch'
            data[int(p.name)] = (int(status['PPid']), name, (p/'cgroup').read_text().strip())
            if starttimes is not None:
                starttimes[int(p.name)] = process_starttime(p)
        except (OSError, ValueError, KeyError):
            continue
    return data

def select(data):
    roots = {pid for pid, (_, name, _) in data.items() if name in {'agent-control', 'agent-batch'}}
    chosen = set(roots)
    while True:
        more = {pid for pid, (parent, name, _) in data.items() if parent in chosen and name not in DESKTOP}
        if more <= chosen:
            break
        chosen |= more
    # Never touch other managers, system services or the compositor itself.
    prefix = '/user.slice/user-%d.slice/user@%d.service/' % (os.getuid(), os.getuid())
    # Hermes control processes (gateway, dashboard, interactive CLI) stay out of the
    # killable scope: systemd-oomd kills a whole cgroup, and one runaway tool must not
    # take the agent that owns it down too. Their children are still routed.
    return sorted(pid for pid in chosen if prefix in data[pid][2] and '/agent.slice/' not in data[pid][2]
                  and data[pid][1] not in PROTECTED)

PROTECTED = {'agent-control'}
DESKTOP = {'Hyprland', 'sway', 'kwin_wayland', 'gnome-shell', 'systemd', 'dbus-broker',
           'chromium', 'chrome', 'firefox', 'brave', 'brave-browser', 'zen', 'zen-bin', 'librewolf',
           'pipewire', 'pipewire-pulse', 'wireplumber', 'pulseaudio',
           'Xwayland', 'hypridle', 'qs', 'Discord', 'tern',
           'kitty', 'alacritty', 'wezterm-gui', 'foot', 'gnome-terminal-', 'konsole'}
CORE_SCOPE = 'hermes-core.scope'
WORKLOADS_SCOPE = 'agent-workloads-v2.scope'

def _bus(*args):
    return subprocess.run(['busctl', '--user', 'call', 'org.freedesktop.systemd1', '/org/freedesktop/systemd1',
                           'org.freedesktop.systemd1.Manager', *args], capture_output=True, text=True, timeout=15)

def place(unit, props, pids):
    """Attach to a running scope, or (re)create it.

    A scope that ended `failed` stays loaded, and StartTransientUnit then refuses the
    name forever ("already loaded"); 2026-10-24 that failed every 10 s tick for hours.
    OOMPolicy=continue: one OOM-killed workload must not stop every other one."""
    pids = [str(p) for p in pids]
    if subprocess.run(['systemctl', '--user', 'is-active', '--quiet', unit]).returncode == 0:
        return _bus('AttachProcessesToUnit', 'ssau', unit, '', str(len(pids)), *pids)
    subprocess.run(['systemctl', '--user', 'reset-failed', unit], capture_output=True, timeout=15)
    props = [*props, ('OOMPolicy', 's', 'continue')]
    flat = [x for prop in props for x in prop]
    return _bus('StartTransientUnit', 'ssa(sv)a(sa(sv))', unit, 'fail', str(len(props) + 1), *flat,
                'PIDs', 'au', str(len(pids)), *pids, '0')

def rescue(data):
    """Move protected processes that an older version swept into the shared workloads scope back out.

    Only the sweep scope counts. A control process in its own agent-<name>-*.scope
    (scripts/agent-launch) or in a service placed with Slice=agent.slice (the Hermes
    gateway) is where it belongs; pulling it out every tick undid that placement and
    left omp uncapped in hermes-core.scope."""
    stuck = [pid for pid, (_, name, cg) in data.items() if name in PROTECTED and cg.endswith('/' + WORKLOADS_SCOPE)]
    if not stuck:
        return []
    owners = {}
    out = subprocess.run(['systemctl', '--user', 'show', '--state=active', '--type=service', '-p', 'Id,MainPID', '*'],
                         capture_output=True, text=True, timeout=15).stdout
    for block in out.strip().split('\n\n'):
        kv = dict(line.split('=', 1) for line in block.splitlines() if '=' in line)
        if kv.get('MainPID', '0') != '0':
            owners[int(kv['MainPID'])] = kv['Id']
    loose = []
    for pid in stuck:
        unit = owners.get(pid)
        if unit and _bus('AttachProcessesToUnit', 'ssau', unit, '', '1', str(pid)).returncode == 0:
            continue
        loose.append(pid)
    if loose:
        # Rescued control processes must not escape every memory limit.
        place(CORE_SCOPE, [('Description', 's', 'Hermes control processes (kept out of agent-workloads)'),
                           ('Slice', 's', 'app.slice'), ('MemoryMax', 't', str(5 << 30)),
                           ('MemorySwapMax', 't', str(1 << 30))], loose)
    return stuck

def process_starttime(path):
    # comm may contain spaces/parentheses; the remaining stat fields start at #3.
    return (path / 'stat').read_text().rsplit(')', 1)[1].split()[19]


def service_owners():
    result = subprocess.run(
        ['systemctl', '--user', 'show', '--type=service',
         '-p', 'Id,MainPID', '*'], capture_output=True, text=True, timeout=15, check=True)
    owners = {}
    for block in result.stdout.strip().split('\n\n'):
        row = dict(line.split('=', 1) for line in block.splitlines() if '=' in line)
        if row.get('MainPID', '0').isdigit() and int(row.get('MainPID', '0')):
            owners[int(row['MainPID'])] = row['Id']
    return owners


def rank_workloads(data, routed, owners, starttimes, proc=pathlib.Path('/proc')):
    """Raise disposable children only; never lower an existing score or rank a control."""
    gateways = {pid for pid, unit in owners.items()
                if unit == 'hermes-gateway.service' or unit.startswith('hermes-gateway-')}
    descendants = set(gateways)
    while True:
        more = {pid for pid, (parent, name, _) in data.items()
                if parent in descendants and name not in DESKTOP}
        if more <= descendants:
            break
        descendants |= more
    prefix = '/user.slice/user-%d.slice/user@%d.service/' % (os.getuid(), os.getuid())
    candidates = sorted(pid for pid in set(routed) | (descendants - gateways)
                        if pid in data and pid not in owners
                        and data[pid][1] not in PROTECTED | DESKTOP and prefix in data[pid][2])
    ranked, failures = [], []
    for pid in candidates:
        path = proc / str(pid)
        try:
            if path.stat().st_uid != os.getuid() or process_starttime(path) != starttimes.get(pid):
                continue
            score = path / 'oom_score_adj'
            if int(score.read_text()) < 800:
                score.write_text('800\n')
            ranked.append(pid)
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as error:
            failures.append({'pid': pid, 'error': str(error)})
    return {'oom_ranked': ranked, 'oom_rank_failures': failures, 'oom_score_adj': 800}


def main():
    starttimes = {}
    data = snapshot(starttimes)
    pids = select(data)
    if '--dry-run' in sys.argv:
        print(json.dumps({'eligible': pids, 'count': len(pids)}))
        return
    owners = service_owners()
    # Existing agent.slice workloads are already routed, but still need ranking.
    already_routed = {pid for pid, (_, name, cg) in data.items()
                      if '/agent.slice/' in cg and name not in PROTECTED | DESKTOP}
    print(json.dumps(rank_workloads(data, set(pids) | already_routed, owners, starttimes)))
    rescued = rescue(data)
    if rescued:
        print(json.dumps({'rescued': rescued}))
    if not pids:
        return
    unit = WORKLOADS_SCOPE
    result = place(unit, [('Description', 's', 'Isolated coding-agent workloads'),
                          ('Slice', 's', 'agent.slice'), ('Delegate', 'b', 'true')], pids)
    if result.returncode:
        raise SystemExit(f'agent-resource-classify: placing {pids} in {unit} failed: {result.stderr.strip()}')
    for pid in pids:
        try:
            os.setpriority(os.PRIO_PROCESS, pid, 10)
        except (ProcessLookupError, PermissionError):
            pass
    print(json.dumps({'routed': pids, 'unit': unit, 'nice': 10}))

if __name__ == '__main__':
    main()
