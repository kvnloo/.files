#!/usr/bin/env bash
# offsite-blobs: work product that is not in git (blends, renders, dream-loop runs, footage) gets an
# off-machine copy in Kevin's Google Drive (canon #16, 2026-11-16). `rclone copy` only: it never
# deletes or overwrites newer files on Drive, so a local delete can't propagate. Daily timer.
# Restore: rclone copy gdrive:groot-offsite/<host>/<path> <path>
set -euo pipefail
remote=${OFFSITE_BLOBS_REMOTE:-gdrive:groot-offsite/$(hostname -s)}
runs=/mnt/zer0models/workspace/zer0/data/operations/storage-maintenance/runs/offsite-$(date +%Y%m%d)
mkdir -p "$runs"
# Personal-data trees (taste, memory-reclaim) and the reap tarballs (.env secrets) wait for an
# rclone crypt remote; they are listed as sole copies in the summary instead of uploaded in plaintext.
src=(/mnt/zer0models/project-artifacts)
excl=(--exclude 'taste/**' --exclude 'memory-reclaim/**' --exclude 'node_modules/**' --exclude '.venv/**'
      --exclude '__pycache__/**' --exclude '.next/**' --exclude '.cache/**')
rc=0
for s in "${src[@]}"; do
  nice -n 19 ionice -c 3 rclone copy "$s" "$remote$s" "${excl[@]}" \
    --transfers 4 --checkers 8 --drive-chunk-size 64M --bwlimit "08:00,25M 23:00,off" \
    --log-level NOTICE --stats 10m --stats-log-level NOTICE --log-file "$runs/blobs.log" || rc=$?
done
printf '{"time":"%s","remote":"%s","sources":"%s","exit":%d}\n' "$(date -Is)" "$remote" "${src[*]}" "$rc" >> "$runs/blobs.jsonl"
exit $rc
