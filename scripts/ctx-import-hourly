#!/bin/bash
# Hourly ctx refresh (runtime-audit-20261025). Auto mode republished a full index generation about
# every 5 min (~80 MB/s of writes). Manual `ctx import` can't read live Hermes state.db files
# (source_changed). So once an hour: switch auto on, let the daemon catch up, switch back to manual.
# 2026-10-26 memory lane: a refresh outlives one hourly window (26 GB of sources), and each failed
# window left one more queued request until the queue hit its 8-request cap ("queue is full").
# Now: if a refresh is already queued/running, keep auto on and WAIT for it instead of enqueuing.
# Success = a new generation was published in this window.
C=${CTX_BIN:-/home/kvn/.local/bin/ctx}; R=/mnt/zer0models/host-offload/home_kvn_.ctx; LOG=${CTX_IMPORT_LOG:-/mnt/zer0models/workspace/zer0/data/operations/runtime-audit-20261025/ctx-import.log}
# 2026-11-15: with the daemon switched off on purpose (ayo 11-06), every run still scanned the index
# (~2 GB read, 2 GB RSS, once 60 GB) before auto mode was refused. Fail before touching ctx; the unit
# stays red and is declared in kvnloo/home map/parked.json until Kevin decides. Absolute path: the
# unit sets HOME to ctx-import-home.
OFF=${CTX_IMPORT_OFF_SWITCH:-/home/kvn/.config/ctx-daemon-off}
if [ -e "$OFF" ]; then
  echo "$(date -Is) wait_rc=2 skipped: ctx daemon off by decision ($OFF); parked in kvnloo/home map/parked.json" >> $LOG
  echo "ctx daemon is off ($OFF exists): nothing to import; parked in kvnloo/home map/parked.json" >&2
  exit 2
fi
state() { $C --data-root $R index --format json 2>/dev/null | python3 -c "import json,sys;d=json.load(sys.stdin);print(d['lexical'].get('generation_id','')[:12], d.get('refresh',{}).get('physical_attempt_state','none'))"; }
# 2026-11-02 memory-heal: the timer fires every 15 min so a refresh happens soon after memory frees up;
# keep the hourly cadence by skipping when the last successful window is under 50 min old.
last=$(grep 'wait_rc=0' $LOG 2>/dev/null | tail -1 | cut -d' ' -f1)
if [ -n "$last" ] && [ $(( $(date +%s) - $(date -d "$last" +%s) )) -lt 3000 ]; then exit 0; fi
read g0 s0 < <(state); t0=$(date +%s)
# UF3 2026-11-15: fail fast when auto mode cannot start. Since the 11-06 ctx daemon off-switch
# (ctx.service.d/95-off-20261106.conf) and a dead zed source root, `index mode auto` failed every run and
# this script then waited ~46 min on a refresh that could never be admitted, holding memory-index.lock and
# starving agentsview-sync (memory-recall-check: AgentsView hours behind disk). Report the real error instead.
if ! err=$($C --data-root $R index mode auto 2>&1); then
  echo "$(date -Is) wait_rc=2 gen $g0 -> $g0 (auto mode refused: $(echo "$err" | tr '\n' ' ' | cut -c1-300))" >> $LOG
  echo "ctx index mode auto failed: $err" >&2
  exit 2
fi
sleep 20
if [ "$s0" = running ] || [ "$s0" = admission_pending ]; then
  # A refresh is in flight: let the daemon finish it (bounded by the unit timeout).
  while [ $(( $(date +%s)-t0 )) -lt 2700 ]; do
    $C --data-root $R search "ctx hourly refresh" --format json >/dev/null 2>&1  # keeps the daemon alive
    read g1 s1 < <(state); [ -n "$g1" ] && [ "$g1" != "$g0" ] && break; sleep 60  # empty = status call failed, keep waiting
  done
  rc=0
else
  timeout 2400 $C --data-root $R search "ctx hourly refresh" --refresh wait --format json >/dev/null 2>&1; rc=$?
fi
sleep 20  # let the daemon finish publishing
$C --data-root $R index mode manual >/dev/null 2>&1
read g2 s2 < <(state)
# Success only when a NEW generation is visible now (an unreadable status is not success).
[ -n "$g2" ] && [ "$g2" != "$g0" ] || rc=1
echo "$(date -Is) wait_rc=$rc gen $g0 -> $g2 (was $s0, now $s2) took $(( $(date +%s)-t0 ))s" >> $LOG
exit $rc
