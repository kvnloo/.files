#!/bin/bash
# Hourly ctx refresh (runtime-audit-20261025). Auto mode republished a full index generation about
# every 5 min (~80 MB/s of writes). Manual `ctx import` can't read live Hermes state.db files
# (source_changed). So once an hour: switch auto on, let the daemon catch up, switch back to manual.
# 2026-10-26 memory lane: a refresh outlives one hourly window (26 GB of sources), and each failed
# window left one more queued request until the queue hit its 8-request cap ("queue is full").
# Now: if a refresh is already queued/running, keep auto on and WAIT for it instead of enqueuing.
# Success = a new generation was published in this window.
C=/home/kvn/.local/bin/ctx; R=/mnt/zer0models/host-offload/home_kvn_.ctx; LOG=/mnt/zer0models/workspace/zer0/data/operations/runtime-audit-20261025/ctx-import.log
state() { $C --data-root $R index --format json 2>/dev/null | python3 -c "import json,sys;d=json.load(sys.stdin);print(d['lexical'].get('generation_id','')[:12], d.get('refresh',{}).get('physical_attempt_state','none'))"; }
read g0 s0 < <(state); t0=$(date +%s)
$C --data-root $R index mode auto >/dev/null 2>&1
sleep 20
if [ "$s0" = running ] || [ "$s0" = admission_pending ]; then
  # A refresh is in flight: let the daemon finish it (bounded by the unit timeout).
  while [ $(( $(date +%s)-t0 )) -lt 2700 ]; do
    $C --data-root $R search "ctx hourly refresh" --format json >/dev/null 2>&1  # keeps the daemon alive
    read g1 s1 < <(state); [ -n "$g1" ] && [ "$g1" != "$g0" ] && break; sleep 60  # empty = status call failed, keep waiting
  done
  rc=0
else
  timeout 2400 $C --data-root $R search "ctx hourly refresh" --refresh wait --format json >/dev/null 2>&1; rc=$?
fi
sleep 20  # let the daemon finish publishing
$C --data-root $R index mode manual >/dev/null 2>&1
read g2 s2 < <(state)
# Success only when a NEW generation is visible now (an unreadable status is not success).
[ -n "$g2" ] && [ "$g2" != "$g0" ] || rc=1
echo "$(date -Is) wait_rc=$rc gen $g0 -> $g2 (was $s0, now $s2) took $(( $(date +%s)-t0 ))s" >> $LOG
exit $rc
