#!/bin/sh
# fleet-phone-autostart: bring an Omalauncher guest's services back after the
# launcher (re)starts. The guest has no systemd, and PRoot kills every process a
# window started when that window's PRoot exits, so nothing survives on its own.
#
# Installed as ~/.local/bin/fleet-phone-autostart by scripts/fleet-phone-clone.sh,
# and started by /etc/profile.d/zz-fleet-autostart.sh from every login shell:
# Omalauncher's home Terminal tile (opens with the launcher), Tern's
# login-environment probe at startup, new Tern panes and interactive ssh logins.
#
#   fleet-phone-autostart          check once: tailscaled, sshd, tern remote serve
#   fleet-phone-autostart --watch  become the single watcher (flock) and re-check
#                                  every 60 s, so a service that died with another
#                                  window comes back; exits at once if one runs
#
# Idempotent: each service starts only when it is not already answering. It
# never touches Android apps or settings. Off switch: touch
# ~/.config/fleet/no-autostart. Log: ~/.local/state/fleet-autostart/log.
set -u
umask 077
state=$HOME/.local/state/fleet-autostart
mkdir -p "$state"
: "${XDG_RUNTIME_DIR:=/run/user/0}"
export XDG_RUNTIME_DIR
log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$state/log"; }
# Size caps: each log keeps at most ~256 KiB plus one rotated copy.
cap_logs() {
    for f in "$state/log" "$state/sshd.log" "$state/tailscaled.log"; do
        [ -f "$f" ] && [ "$(wc -c <"$f")" -gt 262144 ] && mv -f "$f" "$f.1"
    done
    return 0
}

tern_binary() {
    # The launcher's own Tern (S22+) wins; older guests keep it under ~/.local/opt (S25),
    # where the ~/.local/bin/tern wrapper names the one in use.
    if [ -x /opt/tern/tern/tern ]; then echo /opt/tern/tern/tern; return; fi
    b=$(sed -n 's/^TERN_BINARY=//p' "$HOME/.local/bin/tern" 2>/dev/null | head -1)
    if [ -n "$b" ] && [ -x "$b" ]; then echo "$b"; return; fi
    ls -d "$HOME"/.local/opt/tern-*/tern/tern-bin 2>/dev/null | sort -V | tail -1
}

remote_serve_alive() { # any Tern binary: the S25 wrapper and this script may name different ones
    pid=$(cat "$HOME/.local/state/tern-remote/pid" 2>/dev/null)
    case $pid in '' | *[!0-9]*) return 1 ;; esac
    tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q ' remote serve --user '
}

ensure_tailscale() {
    sock=/run/tailscale/tailscaled.sock
    tailscale --socket="$sock" status --json >/dev/null 2>&1 && return 0
    # The S25's own helper also runs the SOCKS5 proxy and syncs /etc/hosts; prefer it.
    if [ -x "$HOME/.local/bin/tern-tailscale-start" ]; then
        if "$HOME/.local/bin/tern-tailscale-start" >>"$state/log" 2>&1 </dev/null 7>&- 8>&-; then
            log "started tailscaled (tern-tailscale-start)"
        else
            log "tern-tailscale-start failed; see ~/.local/state/tailscale/daemon.log"
        fi
        return 0
    fi
    for st in /var/lib/tailscale/tailscaled.state "$HOME/.local/state/tailscale/tailscaled.state"; do
        [ -s "$st" ] || continue
        mkdir -p /run/tailscale
        # Userspace networking: no TUN or routes; the tailnet IP serves sshd and Tern.
        nohup tailscaled --tun=userspace-networking --state="$st" --socket="$sock" \
            >"$state/tailscaled.log" 2>&1 </dev/null 7>&- 8>&- &
        log "started tailscaled pid $! (state $st)"
        return 0
    done
    # Never logged in here: `tailscale up` is the owner's call.
}

ensure_sshd() {
    if [ -r /run/sshd.pid ]; then
        pid=$(cat /run/sshd.pid)
        case $pid in
            '' | *[!0-9]*) ;;
            *) [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = /usr/bin/sshd ] && return 0 ;;
        esac
    fi
    ssh-keygen -A >/dev/null 2>&1
    if ! /usr/bin/sshd -t >>"$state/log" 2>&1; then log "sshd config invalid; not starting"; return 1; fi
    /usr/bin/sshd -E "$state/sshd.log" 7>&- 8>&- && log "started sshd"
}

ensure_tern_remote() {
    remote_serve_alive && return 0
    bin=$(tern_binary)
    [ -n "$bin" ] && [ -x "$HOME/.local/bin/tern-remote-start" ] || return 0
    # Peer-credential shim for sockets across separate PRoot launches (as on the S25).
    shim=""
    for f in "$HOME/.local/lib/proot-peercred.so" "$(dirname "$bin")/proot-peercred.so"; do
        [ -r "$f" ] && { shim=$f; break; }
    done
    before=$(cat "$HOME/.local/state/tern-remote/pid" 2>/dev/null)
    if LD_PRELOAD="$shim${LD_PRELOAD:+:$LD_PRELOAD}" "$HOME/.local/bin/tern-remote-start" "$bin" \
        >>"$state/log" 2>&1 </dev/null 7>&- 8>&-; then
        after=$(cat "$HOME/.local/state/tern-remote/pid" 2>/dev/null)
        [ "$after" = "$before" ] || log "started tern remote serve pid $after"
    else
        log "tern remote serve did not start; see ~/.local/state/tern-remote/service.log"
    fi
}

once() {
    [ -e "$HOME/.config/fleet/no-autostart" ] && return 0
    (
        exec 8>"$state/once.lock"
        flock -w 30 8 || { log "skipped: another check held the lock for 30 s"; exit 0; }
        ensure_tailscale
        ensure_sshd
        ensure_tern_remote
    ) 7>&-
}

case ${1:-} in
    --watch)
        exec 7>"$state/watch.lock"
        flock -n 7 || exit 0 # a watcher is already alive
        echo $$ >"$state/watch.pid"
        log "watcher $$ started"
        while :; do
            once
            cap_logs
            date +%s >"$state/heartbeat" # fleet-node-probe: the watcher is alive
            sleep 60 7>&- # a stray sleep must not keep the watcher lock after the watcher dies
        done
        ;;
    '') once ;;
    *) echo "usage: fleet-phone-autostart [--watch]" >&2; exit 2 ;;
esac
