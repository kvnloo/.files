#!/usr/bin/env python3
"""fx-canon: the only way GPT (fx) runs here. Two jobs.

1. Owner canon. fx v0.0.15 has no global instruction file. It reads the cwd's AGENTS.md and walks
   up only inside $HOME; `--system` replaces its whole base prompt. So the generated canon block
   (owner-canon-sync renders it from OWNER-CANON.md) is prepended to every `fx ask` prompt, from
   argv or stdin.
2. PRIV2 privacy guard, by tier (pol-1.2, /mnt/zer0models/sft-svlm/data/privacy/README.md).
   Kevin 2026-11-10: "personal data can go to paid gpt as long as its not pii or phi" (T1 is allowed).
   a. `ask` briefs are screened with the tier classifier's deterministic detector (pcls/detect.py):
      secrets/ID numbers (T4), contact details/addresses/DOB (PII) or own-health cues (PHI), or a
      brief marked [pii]/[phi]/sensitive, are refused (exit 3) with a content-free receipt line.
      If the detector cannot load, every brief is refused (fail closed).
   b+c. Off by default since 2026-11-10 (Kevin: same access as Claude). FX_PRIVACY_MASK=1 restores bwrap: raw owner stores are masked (directories
      become empty tmpfs, files become /dev/null), and ctx/agentsview/sqlite3 on PATH are shims
      that fail closed. Direct reads from Python or any other tool hit the same masks.
   Without bwrap, fx does not run (exit 4).
~/.local/bin/fx points here; the real binary is FX_BIN.
"""
import glob, hashlib, json, os, re, shutil, sys, time

HOME = os.path.expanduser("~")
FX = os.environ.get("FX_BIN", os.path.join(HOME, ".local/lib/fx/fx"))
BLOCK = os.path.expanduser(os.environ.get("OWNER_CANON_BLOCK", "~/.local/share/owner-canon/CANON.block.md"))
OPS = os.environ.get("FX_PRIVACY_OPS", "/mnt/zer0models/workspace/zer0/data/operations")
LOG = os.environ.get("FX_PRIVACY_LOG", os.path.join(HOME, ".local/state/fx-privacy/refusals.jsonl"))
VALUE_FLAGS = {"--model", "--effort", "--provider-order", "--image", "--system", "--resume", "--resume-id"}
# Account and config commands start no model session; everything else is sandboxed.
UNSANDBOXED = {"login", "logout", "setup", "teams", "provider", "models", "credits", "balance",
               "usage", "status", "doctor", "--help", "-h", "--version", "help"}

# (a) A brief is refused if it carries PII/PHI (T2+), not because it is personal (T1 is allowed).
DETECT = os.environ.get("FX_PRIVACY_DETECT", "/mnt/zer0models/sft-svlm/data/privacy/scripts")
MARKED = re.compile(r"\[(pii|phi|sensitive)\]|^\s*(privacy|data|sensitivity|tier)\s*:\s*(pii|phi|sensitive|t[234])\b", re.I | re.M)
PHI_CUES = ("cue:health_self",)


def refused(brief: str):
    if MARKED.search(brief):
        return "marked_sensitive"
    try:
        sys.path.insert(0, DETECT)
        from pcls.detect import detect
    except Exception:
        return "detector_unavailable"
    hits = detect(brief)["hits"]
    bad = sorted(k for k in hits if k.startswith(("secret:", "id:", "contact:")) or k in PHI_CUES)
    return ",".join(bad) or None


def masked_paths():
    """(c) Owner data paths a GPT session must not read, resolved through symlinks."""
    hermes = os.path.join(HOME, ".hermes")
    files = []
    for pat in ("state.db*", "profiles/*/state.db*"):
        files += glob.glob(os.path.join(hermes, pat))
    files += glob.glob(os.path.join(OPS, "*", "OWNER-MESSAGES*"))
    dirs = [os.path.join(HOME, ".agentsview"), os.path.join(HOME, ".ctx"),
            os.environ.get("AGENTSVIEW_DATA_DIR", "/mnt/zer0models/sft-svlm/data/agentsview"),
            os.environ.get("CTX_DATA_ROOT", "/mnt/zer0models/host-offload/home_kvn_.ctx"),
            os.path.join(OPS, "unified-memory"), "/mnt/zer0models/sft-svlm/data"]
    real = lambda ps, test: sorted({os.path.realpath(p) for p in ps if test(p)})
    return real(dirs, os.path.isdir), real(files, os.path.isfile)


def shim_dir():
    """(b) ctx, agentsview and sqlite3 fail closed inside fx sessions."""
    d = os.path.join(HOME, ".local/share/fx-privacy/shims")
    os.makedirs(d, exist_ok=True)
    for c in ("ctx", "agentsview", "sqlite3"):
        p = os.path.join(d, c)
        if not os.path.exists(p):
            with open(p, "w") as f:
                f.write(f"#!/bin/sh\necho 'PRIV2: {c} is blocked inside fx (owner data stays on Claude or local)' >&2\nexit 126\n")
            os.chmod(p, 0o755)
    return d


def receipt(rule: str, brief: str):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "rule": rule, "cwd": os.getcwd(),
                            "brief_sha256": hashlib.sha256(brief.encode()).hexdigest()[:16],
                            "brief_chars": len(brief)}) + "\n")


def exec_sandboxed(argv, stdin_bytes=None):
    # Kevin 2026-11-10: "just give it access same as yourself" -> no masks unless FX_PRIVACY_MASK=1.
    if os.environ.get("FX_PRIVACY_MASK") != "1":
        if stdin_bytes is not None:
            r, w = os.pipe()
            if os.fork() == 0:
                os.close(r)
                with os.fdopen(w, "wb") as out:
                    out.write(stdin_bytes)
                os._exit(0)
            os.close(w)
            os.dup2(r, 0)
        os.execv(FX, [FX, *argv])
    bwrap = shutil.which("bwrap")
    if not bwrap:
        print("fx-canon: PRIV2 needs bwrap to sandbox fx; refusing to run unsandboxed", file=sys.stderr)
        return 4
    dirs, files = masked_paths()
    args = [bwrap, "--dev-bind", "/", "/"]
    for d in dirs:
        args += ["--tmpfs", d]
    for f in files:
        args += ["--ro-bind", "/dev/null", f]
    path = shim_dir() + ":" + os.environ.get("PATH", "")
    args += ["--setenv", "PATH", path, "--setenv", "FX_PRIVACY_SANDBOX", "1", "--", FX, *argv]
    if stdin_bytes is not None:
        r, w = os.pipe()
        if os.fork() == 0:
            os.close(r)
            with os.fdopen(w, "wb") as out:
                out.write(stdin_bytes)
            os._exit(0)
        os.close(w)
        os.dup2(r, 0)
    os.execv(bwrap, args)


def default_scratch():
    """F22: fx (bun) unpacks a native .so into TMPDIR each run; keep it off RAM-backed /tmp.
    Same default as agent-launch; an explicit TMPDIR (e.g. Hermes profile scratch) wins."""
    if os.environ.get("TMPDIR"):
        return
    d = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "agent-tmp")
    os.makedirs(d, mode=0o700, exist_ok=True)
    os.environ["TMPDIR"] = d


def main(argv):
    default_scratch()
    if argv and argv[0] in UNSANDBOXED:
        os.execv(FX, [FX, *argv])
    if not argv or argv[0] != "ask":
        return exec_sandboxed(argv)  # interactive, session resume, pr, issue, ...
    try:
        block = open(BLOCK, encoding="utf-8").read().strip()
    except OSError:
        block = ""
    if not block:
        print(f"fx-canon: canon block missing at {BLOCK}; run owner-canon-sync", file=sys.stderr)
        return 2
    opts, i, rest = [], 1, None
    while i < len(argv):
        a = argv[i]
        if a == "--":
            rest = argv[i + 1:]; break
        if not a.startswith("-"):
            rest = argv[i:]; break
        opts.append(a)
        if a in VALUE_FLAGS and "=" not in a and i + 1 < len(argv):
            opts.append(argv[i + 1]); i += 1
        i += 1
    brief = " ".join(rest) if rest else sys.stdin.read()
    rule = refused(brief) or refused(" ".join(opts))
    if rule:
        receipt(rule, brief)
        print(f"fx-canon: PRIV2 refused ({rule}): PII/PHI (tier T2+) never goes to GPT. Personal T1 "
              "data is fine; redact the flagged items or run this on Claude/local.", file=sys.stderr)
        return 3
    head = "Owner rules that apply to this whole request (from the owner canon):\n" + block + "\n\n"
    if rest:
        return exec_sandboxed(["ask", *opts, "--", head + brief])
    return exec_sandboxed(["ask", *opts], (head + brief).encode())


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
