#!/usr/bin/env python3
"""Install scoped BWS launchers; optionally remove verified migrated dotenv entries."""
import argparse
from datetime import datetime, timezone
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile


def load_executor(source):
    loader = importlib.machinery.SourceFileLoader('bws_executor', str(source / 'scripts/bws-env-exec'))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def dotenv_entries(text):
    result = {}
    for line in text.splitlines():
        if line.lstrip().startswith('#') or '=' not in line:
            continue
        name, value = line.split('=', 1)
        name = name.strip().removeprefix('export ')
        if re.fullmatch(r'[A-Z][A-Z0-9_]*', name):
            result[name] = value.strip().strip('"').strip("'")
    return result


def migration_plan(home, scopes, values, retired=None):
    plan = []
    # Native OMP already has its own verified login; remove redundant dotenv
    # copies without creating an OMP environment-injection scope.
    scopes = dict(scopes, omp={'TYPESAFE_API_KEY': 'TYPESAFE_API_KEY'})
    targets = [(home / '.omp/.env', 'omp'), (home / '.config/environment.d/typesafe.conf', 'omp')]
    for scope in scopes:
        if scope.startswith('hermes-'):
            profile = scope.removeprefix('hermes-')
            root = home / '.hermes' if profile == 'root' else home / '.hermes/profiles' / profile
            targets.append((root / '.env', scope))
    existing_paths = {path for path, _scope in targets}
    for relative in retired or {}:
        path = home / relative
        if path not in existing_paths:
            scope = 'retired:' + relative
            scopes[scope] = {}
            targets.append((path, scope))
    for path, scope in targets:
        if not path.exists():
            continue
        before = path.read_bytes()
        text = before.decode()
        entries = dotenv_entries(text)
        mappings = dict(scopes[scope])
        mappings.update((retired or {}).get(str(path.relative_to(home)), {}))
        remove = mappings.keys() & entries.keys()
        for name in remove:
            if entries[name] != values[mappings[name]]:
                raise RuntimeError('vault mismatch for ' + scope + ':' + name)
        if not remove:
            continue
        lines = []
        for line in text.splitlines(keepends=True):
            name = line.split('=', 1)[0].strip().removeprefix('export ') if '=' in line else ''
            if name not in remove:
                lines.append(line)
        plan.append((path, before, ''.join(lines).encode()))
    return plan


def provider_json_plan(home, retired, values):
    plan = []
    for relative, providers in retired.items():
        path = home / relative
        if not path.exists():
            continue
        before = path.read_bytes()
        data = json.loads(before)
        changed = False
        for provider in data.get('providers', []):
            for field, source in providers.get(provider.get('id'), {}).items():
                if not provider.get(field):
                    continue
                if provider[field] != values[source]:
                    raise RuntimeError('vault mismatch for native provider credential')
                del provider[field]
                changed = True
        if changed:
            plan.append((path, before, (json.dumps(data, indent=2) + '\n').encode()))
    return plan


def apply_migration(home, plan, backup):
    for path, before, after in plan:
        if path.read_bytes() != before:
            raise RuntimeError('credential file changed during migration')
        saved = backup / path.relative_to(home)
        saved.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        saved.write_bytes(before)
        saved.chmod(0o600)
        fd, temporary = tempfile.mkstemp(prefix='.bws-migration-', dir=path.parent)
        try:
            with os.fdopen(fd, 'wb') as stream:
                stream.write(after)
            os.chmod(temporary, 0o600)
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        print('removed verified plaintext entries: ' + str(path))


def quarantine_files(home, paths, backup):
    for path in paths:
        path = Path(path)
        if path.is_symlink() or not path.is_file():
            raise RuntimeError('quarantine source must be a regular file')
        path.relative_to(home / '.config')
        saved = backup / path.relative_to(home)
        saved.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd = os.open(saved, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as target, path.open('rb') as source:
            shutil.copyfileobj(source, target)
        path.unlink()
        print('quarantined retired credential-bearing file: ' + str(path))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--apply', action='store_true')
    parser.add_argument('--migrate-env', action='store_true')
    parser.add_argument('--quarantine-file', type=Path, action='append', default=[])
    parser.add_argument('--source', type=Path, default=Path(__file__).resolve().parents[1])
    args = parser.parse_args()
    source = args.source.resolve()
    home = Path.home()
    config = json.loads((source / 'config/bws-consumers.json').read_text())
    links = {
        'scripts/bws-env-exec': '.local/bin/bws-env-exec',
        'scripts/bws-apply-local-secrets.sh': '.local/bin/bws-apply-local-secrets',
        'scripts/agent-launch': '.local/bin/agent-launch',
        'scripts/boat': '.local/bin/omp-boat',
        'scripts/hermes': '.local/bin/hermes',
        'scripts/hermes-agent': '.local/bin/hermes-agent',
        'scripts/codexbar': '.local/bin/codexbar',
        'scripts/codexbar-noctalia': '.local/bin/codexbar-noctalia',
        'config/bws-consumers.json': '.local/share/files-bws/consumers.json',
        'config/systemd/user/bws-secrets-sync.service': '.config/systemd/user/bws-secrets-sync.service',
        'config/systemd/user/bws-secrets-sync.timer': '.config/systemd/user/bws-secrets-sync.timer',
    }
    payload = {rel: ((source / rel).read_bytes(), (source / rel).stat().st_mode & 0o777) for rel in links}
    for rel in ('scripts/codexbar-env.sh', 'scripts/codexbar-extra-providers.py', 'scripts/codexbar_credentials.py'):
        payload[rel] = ((source / rel).read_bytes(), (source / rel).stat().st_mode & 0o777)
    policy = 'config/environment.d/typesafe.conf'
    payload[policy] = ((source / policy).read_bytes(), 0o600)
    for unit, scope in config['units'].items():
        rel = 'config/systemd/user/' + unit + '.d/60-bws-secrets.conf'
        payload[rel] = (('[Unit]\nRequires=bws-secrets-sync.service\nAfter=bws-secrets-sync.service\n\n'
                         '[Service]\nEnvironmentFile=%t/bws-secrets/' + scope + '.env\n').encode(), 0o644)
        links[rel] = '.config/systemd/user/' + unit + '.d/60-bws-secrets.conf'
    if not args.apply:
        print('DRY RUN: install scoped vault launchers and ' + str(len(config['units'])) + ' service scopes')
        return
    values = load_executor(source).vault(os.environ)
    plan = migration_plan(home, config['scopes'], values, config.get('retired_dotenv')) if args.migrate_env else []
    if args.migrate_env:
        plan.extend(provider_json_plan(home, config.get('retired_provider_json', {}), values))
    digest = hashlib.sha256()
    for rel, (data, mode) in sorted(payload.items()):
        digest.update(rel.encode() + b'\0' + str(mode).encode() + b'\0' + data)
    releases = home / '.local/lib/files-bws'
    releases.mkdir(parents=True, exist_ok=True)
    release = releases / digest.hexdigest()
    if not release.exists():
        temporary = Path(tempfile.mkdtemp(prefix='.stage-', dir=releases))
        try:
            for rel, (data, mode) in payload.items():
                target = temporary / rel
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(data)
                target.chmod(mode)
            temporary.rename(release)
        finally:
            if temporary.exists():
                shutil.rmtree(temporary)
    subprocess.run([str(release / 'scripts/bws-env-exec'), '--refresh'], check=True)
    backup = home / '.local/state/secret-migration' / datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
    backup.mkdir(parents=True, mode=0o700)
    backup.parent.chmod(0o700)
    for rel, dest in links.items():
        target = home / dest
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists() or target.is_symlink():
            saved = backup / dest
            saved.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            shutil.copy2(target, saved, follow_symlinks=False)
            target.unlink()
        target.symlink_to(release / rel)
    # A migrated Hermes profile uses the explicit consumer map, not the native
    # bulk source (which would inject unrelated secrets from the entire project).
    if args.migrate_env:
        import yaml
        for scope in config['scopes']:
            if not scope.startswith('hermes-'):
                continue
            profile = scope.removeprefix('hermes-')
            root = home / '.hermes' if profile == 'root' else home / '.hermes/profiles' / profile
            path = root / 'config.yaml'
            if not path.exists():
                continue
            cfg = yaml.safe_load(path.read_text()) or {}
            bw = (cfg.get('secrets') or {}).get('bitwarden') or {}
            if not bw.get('enabled'):
                continue
            saved = backup / path.relative_to(home)
            saved.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            shutil.copy2(path, saved)
            saved.chmod(0o600)
            bw['enabled'] = False
            fd, temporary = tempfile.mkstemp(prefix='.bws-config-', dir=path.parent)
            with os.fdopen(fd, 'w') as stream:
                yaml.safe_dump(cfg, stream, sort_keys=False)
            os.replace(temporary, path)
        apply_migration(home, plan, backup)
        global_env = home / '.config/environment.d/typesafe.conf'
        if global_env.exists() and not global_env.read_text().strip():
            global_env.unlink()
            global_env.symlink_to(release / policy)
        subprocess.run(['systemctl', '--user', 'unset-environment', 'TYPESAFE_API_KEY'], check=True)
    quarantine_files(home, args.quarantine_file, backup)
    subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True)
    subprocess.run(['systemctl', '--user', 'enable', '--now', 'bws-secrets-sync.timer'], check=True)
    print('installed release: ' + str(release))
    print('PRIVATE BACKUP (contains credentials; retain until owner authorizes deletion): ' + str(backup))
    print('No consumers restarted. Existing processes retain inherited credentials.')


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print('install-bws-secrets failed (' + type(exc).__name__ + '); no credential values logged', file=__import__('sys').stderr)
        raise SystemExit(1)
