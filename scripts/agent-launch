#!/usr/bin/env bash
# agent-launch NAME CMD...
#
# Start a coding-agent CLI in its own scope under agent.slice from the first byte.
#
# Linux never moves already-charged memory when a process changes cgroup. Agents
# started from a terminal used to be charged to the compositor's cgroup
# (wayland-wm@hyprland.desktop.service) and only their children were moved later,
# so agent.slice's caps barely bound them and the desktop's MemoryLow protected the
# agents' heaps. One scope per agent also lets systemd-oomd stop a single agent
# instead of every agent at once.
#
# Set AGENT_LAUNCH_INLINE=1 to bypass (for example, inside containers).
set -u
name=${1:?usage: agent-launch NAME CMD...}
shift
[ $# -gt 0 ] || { echo "agent-launch: no command" >&2; exit 2; }
executable=$(type -P -- "$1") || { echo "agent-launch: executable not found: $1" >&2; exit 127; }
set -- "$executable" "${@:2}"
case "$name" in
  hermes)
    secrets="$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/bws-env-exec"
    set -- "$secrets" --scope "$name" -- "$@"
    ;;
esac

inline() { exec "$@"; }
[ -n "${AGENT_LAUNCH_INLINE:-}" ] && inline "$@"
command -v systemd-run >/dev/null 2>&1 || { echo 'agent-launch: systemd-run required; refusing unbounded launch' >&2; exit 1; }
grep -q '/agent.slice/' /proc/self/cgroup 2>/dev/null && inline "$@"   # already placed: no nesting
systemctl --user show-environment >/dev/null 2>&1 || { echo 'agent-launch: user manager unavailable; refusing unbounded launch' >&2; exit 1; }

unit="agent-${name//[^A-Za-z0-9_-]/_}-$$-$(date +%s)"

# Harness first: when the scope hits MemoryMax the kernel kills ONE process by
# oom_score. The harness keeps its inherited score; everything else in its scope
# (tools, MCP servers, worker processes) is raised to AGENT_CHILD_OOM_ADJ so it
# dies first. Unprivileged processes may only raise scores, hence children, not
# the harness. The watcher stays outside the scope, is silent (it must never
# write to the agent's tty), and exits when the scope is gone.
main=$$
child_adj=${AGENT_CHILD_OOM_ADJ:-800}
(
  trap '' HUP INT
  exec </dev/null >/dev/null 2>&1
  for _ in $(seq 50); do grep -q "/$unit.scope\$" "/proc/$main/cgroup" && break; sleep 0.1; done
  while cg=$(cut -d: -f3 "/proc/$main/cgroup") && [[ $cg == */"$unit".scope ]]; do
    while read -r p; do
      [[ $p == "$main" ]] && continue
      read -r adj < "/proc/$p/oom_score_adj" && (( adj < child_adj )) && echo "$child_adj" > "/proc/$p/oom_score_adj"
    done < "/sys/fs/cgroup$cg/cgroup.procs"
    sleep 1
  done
) &
disown

# --scope keeps the terminal as the controlling tty; --collect drops the unit after exit.
# No per-scope MemoryHigh: throttling one harness stalls it and all of its
# in-process subagents instead of failing the one tool that is too big.
# OOMPolicy=continue: the default (DefaultOOMPolicy=stop) makes systemd stop the
# WHOLE scope, harness included, after the kernel kills any one child. Measured
# 2026-10-24 on systemd 262: stop -> harness SIGTERM; continue -> harness lives.
exec systemd-run --user --scope --quiet --collect --slice=agent.slice --unit="$unit" \
  --property=MemoryHigh=infinity --property=MemoryMax=6G --property=MemorySwapMax=1G --property=ManagedOOMPreference=none \
  --property=OOMPolicy=continue \
  --description="coding agent: $name" -- "$@"
