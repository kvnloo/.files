#!/usr/bin/env python3
"""Trusted native Android jobs. Runs on groot with the SDK adb, never in a guest."""
import argparse
import fcntl
import json
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import subprocess
import sys
import tempfile
import time
import uuid
import socket
from artifact_lease import create as create_artifact_lease, shell_create as artifact_lease_command
from fleet_source import source_snapshot
from fleet_paths import runs_dir

ROOT = "/data/local/tmp/fleet-jobs"
TOOLBOX = "/data/local/tmp/fleet-bin"
HARDWARE = {"s22": "RFCTA1RZAQY", "galaxy-s22plus": "RFCTA1RZAQY",
            "localhost-0": "RFCTA1RZAQY", "s25": "R5CY93G2WNH", "omarchy-phone": "R5CY93G2WNH"}


class Device:
    def __init__(self, node):
        self.hardware = HARDWARE[node]
        self.node = "s22" if self.hardware == HARDWARE["s22"] else "s25"
        self.adb = str(Path.home() / "android/sdk/platform-tools/adb")
        if not Path(self.adb).is_file():
            raise RuntimeError("native phone lane requires ~/android/sdk/platform-tools/adb")
        self.env = {**os.environ, "ANDROID_ADB_SERVER_PORT": "5037"}
        self.env.pop("ADB_SERVER_SOCKET", None)
        self.serial = None
        connected = [f[0] for line in self.call("devices", "-l").stdout.splitlines()
                     if len(f := line.split()) >= 2 and f[1] == "device"]
        # Check every authenticated entry by hardware identity, preferring USB.
        connected.sort(key=lambda s: (":" in s or "._tcp" in s, s))
        for candidate in connected:
            if self.matches(candidate):
                self.serial = candidate
                break
        if self.serial is None:
            mdns = self.call("mdns", "services").stdout
            advertised = [f[-1] for line in mdns.splitlines()
                          if len(f := line.split()) >= 3
                          and f[0].startswith(f"adb-{self.hardware}-")
                          and f[1] == "_adb-tls-connect._tcp"]
            for candidate in dict.fromkeys(advertised):
                self.call("connect", candidate, check=False)
                if self.matches(candidate):
                    self.serial = candidate
                    break
        if self.serial is None:
            raise RuntimeError(f"authenticated adb hardware {self.hardware} unavailable (no guest fallback)")

    def call(self, *args, check=True, timeout=30, **kwargs):
        kwargs.setdefault("stdin", subprocess.DEVNULL)
        return subprocess.run([self.adb, "-P", "5037", *args], env=self.env,
                              capture_output=True, text=True, check=check, timeout=timeout, **kwargs)

    def matches(self, candidate):
        try:
            r = self.call("-s", candidate, "shell", "getprop ro.serialno", check=False, timeout=10)
            return r.returncode == 0 and r.stdout.strip() == self.hardware
        except subprocess.TimeoutExpired:
            return False

    def shell(self, command, **kwargs):
        return self.call("-s", self.serial, "shell", command, **kwargs).stdout.strip()

    def push(self, source, destination):
        self.call("-s", self.serial, "push", str(source), destination, timeout=600)

    def guest_running(self):
        services = self.shell("dumpsys activity services dev.omalauncher")
        return bool(re.search(r"LinuxService\b", services)
                    and re.search(r"isForeground=true\b", services))

    def restore_guest(self):
        """Fail closed on owner/call evidence; serialize launch with all UI users."""
        with open(f"/tmp/{self.node}-ui.lock", "a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return "ui_busy"
            if self.guest_running():
                return "already_running"
            ledger_path = Path(f"/tmp/{self.node}-agent-opened.json")
            retry_path = Path(f"/tmp/{self.node}-guest-restore.json")
            for _ in range(2):
                try:
                    facts = self.shell(
                        "cat /proc/uptime; cat /proc/sys/kernel/random/boot_id; "
                        "dumpsys power; dumpsys activity activities; "
                        "dumpsys telephony.registry; dumpsys audio")
                    lines = facts.splitlines()
                    uptime = int(float(lines[0].split()[0]) * 1000)
                    boot = lines[1].strip()
                    activity = re.search(r"mLastUserActivityTime(?:\(excludingAttention\))?=(\d+)", facts)
                    foreground = re.search(r"(?:topResumedActivity=|mResumedActivity:).*?\bu\d+\s+([^/\s]+)/", facts)
                    calls = re.findall(r"\bmCallState=(\d+)", facts)
                    modes = re.findall(r"\bmMode=(MODE_[A-Z_]+)", facts)
                    if not boot or not activity or not foreground or not calls or not modes:
                        return "owner_evidence_unavailable"
                    last = int(activity[1])
                    ledger = json.loads(ledger_path.read_text()) if ledger_path.exists() else {}
                    opened = ledger.get(foreground[1], {})
                    if (not 0 <= uptime - last or uptime - last < 60_000
                            or opened.get("boot_id") != boot
                            or not last <= opened.get("opened_uptime_ms", -1) <= uptime):
                        return "owner_busy"
                    if any(c != "0" for c in calls) or any(m != "MODE_NORMAL" for m in modes):
                        return "in_call"
                    retry = json.loads(retry_path.read_text()) if retry_path.exists() else {}
                    # At most two attempts per boot, including later health ticks.
                    attempts = retry.get("attempts", 0) if retry.get("boot_id") == boot else 0
                    if attempts >= 2:
                        return "retry_exhausted"
                    retry_path.write_text(json.dumps({"boot_id": boot, "attempts": attempts + 1}) + "\n")
                    # Record before input: even a transport timeout may have launched it.
                    ledger["dev.omalauncher"] = {"boot_id": boot, "opened_uptime_ms": uptime,
                                                "opened_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
                    ledger_path.write_text(json.dumps(ledger) + "\n")
                    self.shell("monkey -p dev.omalauncher -c android.intent.category.LAUNCHER 1")
                    for _ in range(3):
                        time.sleep(2)
                        if self.guest_running():
                            return "restored"
                except (OSError, ValueError, IndexError, TypeError, AttributeError, subprocess.SubprocessError):
                    return "restore_evidence_unavailable"
            return "retry_exhausted"

    def probe(self):
        kv = {}
        for line in self.shell("dumpsys battery").splitlines():
            if ":" in line:
                key, value = line.split(":", 1)
                kv[key.strip()] = value.strip()
        if "level" not in kv:
            raise RuntimeError("adb battery telemetry unavailable")
        scale = int(kv.get("scale", "100"))
        pct = int(kv["level"]) * 100 / scale
        charging = any(kv.get(k) == "true" for k in ("AC powered", "USB powered", "Wireless powered", "Dock powered")) or kv.get("status") in ("2", "5")
        thermal = self.shell("dumpsys thermalservice")
        status = re.search(r"Thermal Status:\s*(\d+)", thermal)
        load = self.shell("cat /proc/loadavg").split()
        cpus = self.shell("cat /sys/devices/system/cpu/online")
        ncpu = sum(int(b) - int(a) + 1 if sep else 1
                   for part in cpus.split(",") for a, sep, b in [part.partition("-")])
        running = self.guest_running()
        recovery = None if running else self.restore_guest()
        if not running:
            running = self.guest_running()
        return {"ts": int(time.time()), "transport": "adb", "adb_serial": self.serial,
                "hardware_serial": self.hardware, "online": True, "ncpu": ncpu,
                "status": "ok" if running else "guest_down",
                "android": {"omalauncher_fgs": running}, "guest_recovery": recovery,
                **({} if running else {"error": "guest_down: Omalauncher LinuxService missing"}),
                "load1": float(load[0]), "load5": float(load[1]),
                "power": {"source": "adb dumpsys battery", "on_ac": charging,
                          "batteries": [{"pct": pct, "status": "Charging" if charging else "Discharging"}],
                          "battery_temp_c": int(kv.get("temperature", "0")) / 10,
                          "android_thermal_status": int(status[1]) if status else None},
                "thermal_source": "adb dumpsys thermalservice", "thermalservice": thermal,
                "host_lane_supported": True, "kubernetes_member": False}


def jobdir(job):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,95}", job):
        raise RuntimeError("invalid job id")
    return f"{ROOT}/{job}"


def relative(path):
    rel = PurePosixPath(path)
    if rel.is_absolute() or ".." in rel.parts or not rel.parts or any(ord(c) < 32 for c in path):
        raise RuntimeError("artifact paths must stay inside the job directory")
    return str(rel)


def identity(device, directory):
    # Read cmdline and stat in one shell. A reused PID or reboot cannot match.
    script = f'''d={shlex.quote(directory)}
[ -f "$d/pid" ] || exit 0
p=$(cat "$d/pid")
case "$p" in ''|*[!0-9]*) exit 1;; esac
[ -r /proc/$p/stat ] || exit 0
cat /proc/sys/kernel/random/boot_id
cat /proc/$p/stat
tr '\\000' '\\n' < /proc/$p/cmdline
'''
    lines = device.shell(script).splitlines()
    if len(lines) < 3:
        return None
    fields = lines[1].rsplit(")", 1)[1].split()
    pid = int(lines[1].split("(", 1)[0])
    if fields[0] == "Z" or directory + "/runner.sh" not in lines[2:]:
        return None
    if int(fields[2]) != pid or int(fields[3]) != pid:
        raise RuntimeError("job does not own its process group/session")
    return {"pid": pid, "start": fields[19], "boot": lines[0]}


def status(device, job):
    directory = jobdir(job)
    result = device.shell(f"cat {directory}/exit 2>/dev/null; cat {directory}/identity.json 2>/dev/null", check=False).splitlines()
    if not result:
        raise RuntimeError("unknown job or launch identity unavailable")
    code = int(result[0]) if result[0].lstrip("-").isdigit() else None
    saved = json.loads(result[-1])
    current = identity(device, directory)
    running = current == saved
    return {"job": job, "directory": directory, "pid": saved["pid"],
            "state": "running" if running else "exited" if code is not None else "interrupted",
            "exit_code": code, "identity_matches": running}


def kill(device, job):
    directory = jobdir(job)
    saved = json.loads(device.shell(f"cat {directory}/identity.json"))
    current = identity(device, directory)
    if current != saved:
        if current is not None:
            raise RuntimeError("refusing to signal a changed process identity")
        return status(device, job)
    # Check cmdline AND start time again at the signal boundary on the device.
    guard = f'''p={saved['pid']}; d={shlex.quote(directory)}
[ "$(cat /proc/sys/kernel/random/boot_id)" = {shlex.quote(saved['boot'])} ] || exit 1
set -- $(cat /proc/$p/stat); [ "${{22}}" = {shlex.quote(saved['start'])} ] || exit 1
tr '\\000' '\\n' < /proc/$p/cmdline | /system/bin/grep -Fx "$d/runner.sh" >/dev/null || exit 1
'''
    device.shell(guard + 'kill -TERM -- -$p')
    for _ in range(30):
        if identity(device, directory) != saved:
            return status(device, job)
        time.sleep(0.1)
    device.shell(guard + 'kill -KILL -- -$p')
    return status(device, job)


def fetch(device, job, paths, destination):
    directory = jobdir(job)
    destination.mkdir(parents=True, exist_ok=True)
    create_artifact_lease(destination, job, socket.gethostname(), "spool", paths)
    for path in paths:
        rel = relative(path)
        target = destination / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        device.call("-s", device.serial, "pull", f"{directory}/{rel}", str(target), timeout=600)
        print(f"fleet-adb: fetched {rel} -> {target}", file=sys.stderr)


def run(device, args):
    if not args.argv:
        raise RuntimeError("run requires -- CMD...")
    if args.timeout <= 0:
        raise RuntimeError("timeout must be positive")
    facts = device.probe()
    power = facts["power"]
    if power["batteries"][0]["pct"] < 2 and not power["on_ac"]:
        raise RuntimeError("battery below 2% and not charging")
    job = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:12]
    directory = jobdir(job)
    device.shell(f"mkdir -p {directory}/src {directory}/home {directory}/tmp")
    device.shell(artifact_lease_command(shlex.quote(directory), job, device.hardware, "spool",
                                       ["exit", "identity.json", "stdout", "stderr"]))
    if not args.no_src:
        source = Path(args.src or os.getcwd()).resolve()
        if not source.is_dir():
            raise RuntimeError("--src must be a directory")
        with source_snapshot(source, getattr(args, "src_include", []) or []) as (archive, metadata):
            receipts = runs_dir()
            receipts.mkdir(parents=True, exist_ok=True)
            (receipts / f"{job}.json").write_text(json.dumps(
                {"job_id": job, "node": device.hardware, "source_snapshot": metadata}, indent=2) + "\n")
            device.push(archive, directory + "/source.tar.gz")
            device.shell(f"tar -xzf {directory}/source.tar.gz -C {directory}/src && rm {directory}/source.tar.gz")
    for item in args.input:
        source, sep, path = item.rpartition(":")
        if not sep or not Path(source).is_file():
            raise RuntimeError("--input requires FILE:RELATIVE_PATH")
        rel = relative(path)
        device.shell(f"mkdir -p {shlex.quote(directory + '/src/' + str(PurePosixPath(rel).parent))}")
        device.push(source, directory + "/src/" + rel)
    env = f"export PATH={shlex.quote(directory + '/src:' + TOOLBOX)}:/system/bin:/system/xbin; "
    first = shlex.quote(args.argv[0])
    device.shell(f"cd {directory}/src; {env} command -v {first} >/dev/null || "
                 f"{{ echo {shlex.quote('Native command not found: ' + args.argv[0] + '. Android has no Linux python/bash/git. Push a static Android/aarch64 binary or use fleet run --guest.')} >&2; exit 127; }}")
    # The session leader stays as runner.sh, so its cmdline identifies the group.
    runner = f'''#!/system/bin/sh
cd {directory}/src || exit 1
{env}
export HOME={directory}/home TMPDIR={directory}/tmp FLEET_JOB_ID={job}
echo $$ > {directory}/pid
attempt=0
while [ ! -f {directory}/go ]; do
  attempt=$((attempt + 1))
  [ "$attempt" -lt 600 ] || exit 125
  sleep 0.05
done
finish() {{
  trap '' TERM INT HUP
  echo "$1" > {directory}/exit
  kill -TERM -- -$$ 2>/dev/null
  sleep 0.2
  kill -KILL -- -$$ 2>/dev/null
}}
trap 'if [ -f {directory}/timed-out ]; then finish 124; else finish 143; fi' TERM HUP
trap 'finish 130' INT
( sleep {args.timeout}; touch {directory}/timed-out; kill -TERM -- -$$ ) &
{shlex.join(args.argv)} &
child=$!
wait "$child"
finish $?
'''
    with tempfile.TemporaryDirectory(prefix="fleet-adb-") as tmp:
        path = Path(tmp) / "runner.sh"
        path.write_text(runner)
        device.push(path, directory + "/runner.sh")
    device.shell(f"nohup setsid /system/bin/sh {directory}/runner.sh </dev/null >{directory}/stdout 2>{directory}/stderr &")
    owned = None
    for _ in range(100):
        owned = identity(device, directory)
        if owned:
            break
        time.sleep(0.05)
    if not owned:
        raise RuntimeError(f"job {job} failed to create owned session; inspect {directory}/stderr")
    device.shell(f"printf '%s\\n' {shlex.quote(json.dumps(owned))} > {directory}/identity.json.tmp"
                 f" && mv {directory}/identity.json.tmp {directory}/identity.json && touch {directory}/go")
    print(job, flush=True)
    if args.fetch:
        while status(device, job)["state"] == "running":
            time.sleep(0.5)
        fetch(device, job, args.fetch, Path(args.dest or Path.home() / '.local/state/fleet/runs' / job))
        result = status(device, job)
        return result["exit_code"] if result["exit_code"] is not None else 255
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["discover", "probe", "run", "status", "logs", "kill", "fetch"])
    parser.add_argument("node", choices=HARDWARE)
    parser.add_argument("job", nargs="?")
    parser.add_argument("--src")
    parser.add_argument("--src-include", action="append", default=[])
    parser.add_argument("--no-src", action="store_true")
    parser.add_argument("--input", action="append", default=[])
    parser.add_argument("--timeout", type=int, default=3600)
    parser.add_argument("--fetch", action="append", default=[])
    parser.add_argument("--dest")
    argv = sys.argv[1:]
    split = argv.index("--") if "--" in argv else len(argv)
    args = parser.parse_args(argv[:split])
    args.argv = argv[split + 1:]
    try:
        device = Device(args.node)
        if args.action == "discover":
            print(json.dumps({"serial": device.serial, "hardware_serial": device.hardware}))
        elif args.action == "probe":
            print(json.dumps(device.probe()))
        elif args.action == "run":
            return run(device, args)
        else:
            if not args.job:
                raise RuntimeError("job id required")
            directory = jobdir(args.job)
            if args.action == "logs":
                for name, stream in (("stdout", sys.stdout), ("stderr", sys.stderr)):
                    stream.write(device.call("-s", device.serial, "shell", f"cat {directory}/{name}").stdout)
            elif args.action == "kill":
                print(json.dumps(kill(device, args.job)))
            elif args.action == "status":
                print(json.dumps(status(device, args.job)))
            if args.fetch or args.action == "fetch":
                if not args.fetch:
                    raise RuntimeError("fetch requires --fetch PATH")
                fetch(device, args.job, args.fetch, Path(args.dest or Path.home() / '.local/state/fleet/runs' / args.job))
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as exc:
        detail = exc.stderr.strip() if isinstance(exc, subprocess.CalledProcessError) and exc.stderr else str(exc)
        print(f"fleet-adb: {detail}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
