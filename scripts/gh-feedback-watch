#!/usr/bin/env python3
"""gh-feedback-watch: catch human replies to our GitHub contributions within ~1 minute.

  gh-feedback-watch poll            one poll (systemd timer, every 60 s; 304s are free)
  gh-feedback-watch backfill HOURS  scan the last HOURS of participating threads, no phone pings
  gh-feedback-watch status [--json] open backoffs + recent feedback
  gh-feedback-watch followups        queue replies needing a recheck/answer for the HUP loop
  gh-feedback-watch ack REPO --lesson "what we change"   lift a backoff, record the lesson

Source: ghcache (127.0.0.1:18090, no token, never the GitHub host directly; law O17)\nGET /notifications?participating=true (mention/comment/author/review threads only,
not the watched-repo noise). Each updated thread is read back through the issue-comment,
review-comment and review endpoints; only human (non-bot, non-kvnloo) bodies are kept.

Classes:
  complaint   reply objects to how we contribute (AI/bot/spam/noise/volume/tone).
              Writes BACKOFF.json for that repo; the ~/.local/bin/gh shim then refuses
              writes to the repo until `ack` records a lesson. Phone ping class=critical.
  correction  reply says our analysis/patch is wrong, duplicate, by design, changes requested.
              Phone ping class=decision.
  feedback    every other human reply. Logged to feedback.jsonl / digest.md only.
Keyword classes are a triage hint: read the full body before acting.
"""
import json, os, re, subprocess, sys, time, urllib.error, urllib.parse, urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

ME = "kvnloo"
DIR = Path.home() / ".z0int/state/gh-feedback"
STATE, LOG, BACKOFF = DIR / "state.json", DIR / "feedback.jsonl", DIR / "BACKOFF.json"
LESSONS, DIGEST = DIR / "lessons.md", DIR / "digest.md"
NOTIFY = Path.home() / ".local/bin/z0-phone-notify"

COMPLAINT = re.compile(
    r"\b((ai|llm|gpt|claude|machine)[- ]?(generated|written|authored|slop|spam)|"
    r"generated by (an? )?(ai|llm|bot|agent)|slop|"
    r"(are|is) (this|you|these) (an? )?(bot|ai|llm|agent|automated)|automated (prs?|comments?|issues?|replies)|"
    r"low[- ]effort|too many (prs|pull requests|issues|comments|pings)|"
    r"please (don'?t ping|do not ping)|stop (opening|sending|posting|pinging|tagging)|"
    r"(this is|so much|pure|just) noise|wall of text|tl;?dr(?!\s*(\*\*)?\s*[:\-\u2014*])|((comment|review|reply|message|post|write-?up|pr|this|it)('?s| is| was) (way |far |much )?too (long|verbose))|unsolicited|drive[- ]by|"
    r"wast(e|ing) (of )?(my|our|maintainers?'?|everyone'?s) time|code of conduct|"
    # 11-09: a "**TL;DR:**" summary heading (BearHuddleston review on #151577) is not a complaint; a bare tl;dr still is.
    r"did you (even )?(test|read|run))",
    re.I)
# 11-10: generic irritation ("Same here. Very annoying." on #152330 was about the bug) is a complaint only
# when the reply is aimed at us; it no longer trips the repo-wide backoff from a bystander thread.
# 11-13: words that also describe product behaviour ("stops spamming the home chat", "bot-authored Discord
# messages", "agent-written tests", "Please stop editing core's allowlist" to another author, "follow CONTRIBUTING"
# to another author) held a repo-wide backoff for two days on hermes-agent; they count only when aimed at us.
COMPLAINT_AIMED = re.compile(r"\b(not helpful|annoying|disrespect\w*|unprofessional|spam\b|spammy|stop spamming (us|me|our|the (repo|thread|issue|maintainers))|(bot|agent)[- ]?(generated|written|authored|slop|spam)|"
                             r"please stop|stop spamming|(read|see|follow|check) (the |our )?(contributing|guidelines)(\.md)?)", re.I)
CORRECTION = re.compile(
    r"\b(incorrect|wrong|not (true|correct|accurate|the case|a bug|the issue)|misunderst\w*|misread|"
    r"mistaken|that'?s not|isn'?t (right|true|the)|doesn'?t (work|fix|solve)|does not (work|fix|solve)|"
    r"you missed|you'?re (wrong|mistaken)|already (fixed|exists|handled|supported|implemented|merged)|"
    r"duplicate|by design|intended behaviou?r|won'?t fix|wontfix|not planned|superseded|"
    r"can'?t reproduce|cannot reproduce|unable to reproduce|root cause is|the real (issue|problem|cause))",
    re.I)


def now():
    return datetime.now(timezone.utc)


def iso(dt):
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


def load(p, default):
    try:
        return json.loads(p.read_text())
    except Exception:
        return default


def save(p, obj):
    tmp = p.with_suffix(f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(obj, indent=1, sort_keys=True))
    tmp.replace(p)


GHCACHE = os.environ.get("GHCACHE_URL", "http://127.0.0.1:18090").rstrip("/")


class CacheDown(RuntimeError):
    hold = False    # True: ghcache answered 503 on purpose (budget held / no fresh copy yet)


class CacheHold(CacheDown):
    hold = True


# A held budget is ghcache backing off by design, so the 60 s poll skips quietly (exit 0) instead of
# failing the unit (11-17: each hold tripped OnFailure and the fix-replay tape). Past this age the
# skips stop being quiet: a stuck hold must still surface as a failed unit.
HOLD_QUIET = timedelta(hours=2)


def get(path):
    """Read through ghcache (no token here, by construction). Never falls back to GitHub itself:
    if the proxy is down or holding the budget, this poll fails and the next tick retries."""
    url = path if path.startswith("http") else GHCACHE + path
    if not url.startswith(GHCACHE):
        raise CacheDown(f"refusing a non-ghcache URL: {url[:80]}")
    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json"})
    try:
        with urllib.request.urlopen(req, timeout=90) as r:
            h = {k.lower(): v for k, v in r.headers.items()}
            return r.status, h, json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        h = {k.lower(): v for k, v in e.headers.items()}
        if e.code == 503:
            raise CacheHold(f"ghcache holding the budget ({h.get('x-ghcache')})")
        raise
    except (urllib.error.URLError, OSError) as e:
        raise CacheDown(f"ghcache not reachable at {GHCACHE}: {e}")


def validated_at(h):
    """When ghcache last confirmed this body with GitHub (X-Ghcache-Age)."""
    return now() - timedelta(seconds=int(h.get("x-ghcache-age") or 0))


def pages(path):
    """All pages; returns (items, oldest validation time across pages)."""
    out, fresh, url = [], now(), path
    while url:
        _, h, body = get(url)
        out += body or []
        fresh = min(fresh, validated_at(h))
        m = re.search(r'<([^>]+)>;\s*rel="next"', h.get("link", ""))
        url = None
        if m:   # ghcache passes GitHub's Link through; keep only the path+query
            nxt = urllib.parse.urlsplit(m.group(1))
            url = nxt.path + ("?" + nxt.query if nxt.query else "")
    return out, fresh


def human(user):
    login = (user or {}).get("login", "")
    return (login and login != ME and (user or {}).get("type") != "Bot"
            and not re.search(r"(\[bot\]|-bot|bot)$", login, re.I))


def classify(body, review_state=None, ours=False):
    """ours: the reply is aimed at us (thread we opened, or it @-mentions us)."""
    text = re.sub(r"```.*?```", " ", body or "", flags=re.S)       # ignore quoted code/logs
    text = "\n".join(l for l in text.splitlines() if not l.lstrip().startswith(">"))  # and quotes of us
    # 11-11: an author's own AI-disclosure footer ("(Generated by AI)" on #143288) is not a complaint about us.
    text = re.sub(r"(^|\n)[ \t(\[_*\u2014-]*(this (comment|reply|review|post) (was )?)?(generated|written|drafted) (by|with) (an? )?(ai|llm)[ \t.)\]_*]*$", " ", text.strip(), flags=re.I)
    if COMPLAINT.search(text):
        return "complaint", COMPLAINT.search(text).group(0)
    ours = ours or re.search(rf"@{ME}\b", body or "", re.I)
    if ours and COMPLAINT_AIMED.search(text):
        return "complaint", COMPLAINT_AIMED.search(text).group(0)
    if not ours:
        return "feedback", ""
    if review_state == "CHANGES_REQUESTED":
        return "correction", "changes requested"
    if CORRECTION.search(text):
        return "correction", CORRECTION.search(text).group(0)
    return "feedback", ""


def day(dt):
    """`since` rounded down to the UTC day: a stable cache key for ghcache all day long."""
    return dt.strftime("%Y-%m-%dT00:00:00Z")


def thread_items(n, since):
    """Human comments/reviews on a notification thread newer than `since`, plus the oldest
    time ghcache validated any page we read (to tell fresh reads from cached ones)."""
    subj, repo = n["subject"], n["repository"]["full_name"]
    m = re.search(r"/repos/([^/]+/[^/]+)/(issues|pulls)/(\d+)$", subj.get("url") or "")
    if not m:
        return [], now()
    num, kind = m.group(3), m.group(2)
    q = f"per_page=100&since={day(since)}"
    items, fresh = [], now()
    got, f = pages(f"/repos/{repo}/issues/{num}/comments?{q}")
    fresh = min(fresh, f)
    items += [("comment", c, c.get("updated_at") or c["created_at"], None) for c in got]
    if kind == "pulls":
        got, f = pages(f"/repos/{repo}/pulls/{num}/comments?{q}")
        fresh = min(fresh, f)
        items += [("review_comment", c, c.get("updated_at") or c["created_at"], None) for c in got]
        got, f = pages(f"/repos/{repo}/pulls/{num}/reviews?per_page=100")
        fresh = min(fresh, f)
        items += [("review", r, r["submitted_at"], r.get("state")) for r in got
                  if r.get("submitted_at") and (r.get("body") or r.get("state") == "CHANGES_REQUESTED")]
    out = []
    for kind_, c, ts, state in items:
        if parse(ts) <= since or not human(c.get("user")):
            continue
        cls, hit = classify(c.get("body"), state, ours=n.get("reason") == "author")
        out.append({
            "id": f"{kind_}:{c['id']}", "at": ts, "repo": repo, "number": int(num),
            "title": subj.get("title"), "reason": n.get("reason"), "kind": kind_,
            "author": c["user"]["login"], "author_association": c.get("author_association"),
            "class": cls, "hit": hit, "review_state": state,
            "url": c.get("html_url"), "body": (c.get("body") or "")[:4000],
        })
    return out, fresh


def notify(item):
    cls = "critical" if item["class"] == "complaint" else "decision"
    title = f"GH {item['class']}: {item['repo']}#{item['number']} @{item['author']}"
    text = re.sub(r"\s+", " ", item["body"])[:220] + f"  {item['url']}"
    if NOTIFY.exists():
        subprocess.run([str(NOTIFY), "gh-feedback", title, text], timeout=60,
                       env=dict(os.environ, CIRCADIAN_CLASS=cls), capture_output=True)


def record(items, ping):
    if not items:
        return
    state = load(STATE, {})
    seen = set(state.get("seen", []))
    backoff = load(BACKOFF, {})
    fresh = [i for i in items if i["id"] not in seen]
    with LOG.open("a") as f:
        for i in sorted(fresh, key=lambda x: x["at"]):
            f.write(json.dumps(i) + "\n")
            seen.add(i["id"])
            if i["class"] == "complaint" and not i["repo"].startswith(ME + "/"):
                backoff.setdefault(i["repo"], {"since": i["at"], "items": []})["items"].append(
                    {"url": i["url"], "author": i["author"], "hit": i["hit"], "at": i["at"]})
            if ping and i["class"] in ("complaint", "correction"):
                notify(i)
    save(BACKOFF, backoff)
    state = load(STATE, {})          # re-read: cursor may have been saved meanwhile
    state["seen"] = sorted(seen)[-5000:]
    save(STATE, state)
    write_digest()
    for i in fresh:
        print(f"{i['class']:10} {i['repo']}#{i['number']} @{i['author']} {i['url']}")


def scan(since, ping):
    # One stable query string, so ghcache keeps one entry and revalidates it (free 304s).
    # Newest first: stop paging once a page reaches threads older than `since`, else every
    # poll would walk the account's whole notification history.
    notes, url = [], "/notifications?all=true&participating=true&per_page=50"
    while url:
        _, h, body = get(url)
        notes += body or []
        m = re.search(r'<([^>]+)>;\s*rel="next"', h.get("link", ""))
        url = None
        if m and body and parse(body[-1]["updated_at"]) > since:
            nxt = urllib.parse.urlsplit(m.group(1))
            url = nxt.path + ("?" + nxt.query if nxt.query else "")
    items = []
    state = load(STATE, {})
    cursors = state.get("cursor", {})
    for n in notes:
        if n.get("reason") in ("ci_activity", "security_alert"):
            continue
        if parse(n["updated_at"]) <= since and n["id"] not in cursors:
            continue
        if cursors.get(n["id"]) == n["updated_at"]:
            continue                                   # already read at this thread version
        cur = parse(cursors[n["id"]]) if n["id"] in cursors else since
        try:
            got, fresh = thread_items(n, cur)
        except urllib.error.HTTPError as e:
            print(f"skip {n['repository']['full_name']}: HTTP {e.code}", file=sys.stderr)
            continue
        items += got
        # Advance only if ghcache confirmed the comments after the thread last changed;
        # otherwise the cached copy may predate the new reply, so re-read next tick.
        if fresh >= parse(n["updated_at"]):
            cursors[n["id"]] = n["updated_at"]
    state = load(STATE, {})
    state["cursor"] = dict(sorted(cursors.items(), key=lambda kv: kv[1])[-2000:])
    save(STATE, state)
    record(items, ping)
    return items


def cmd_poll():
    state = load(STATE, {})
    t0 = now()
    last = parse(state["last_poll"]) if state.get("last_poll") else t0 - timedelta(hours=2)
    try:
        scan(last - timedelta(minutes=10), ping=True)
    except CacheDown as e:
        msg = f"gh-feedback-watch: {e}; not polling GitHub directly, retry next tick"
        if e.hold and t0 - last < HOLD_QUIET:
            print(msg)
            return
        sys.exit(msg + f" (last good poll {iso(last)})" if e.hold else msg)
    state = load(STATE, {})
    state["last_poll"] = iso(t0)
    save(STATE, state)


def cmd_backfill(hours):
    items = scan(now() - timedelta(hours=float(hours)), ping=False)
    c = {}
    for i in items:
        c[i["class"]] = c.get(i["class"], 0) + 1
    print(f"backfill {hours}h: {len(items)} human replies {c}")


def write_digest():
    rows = [json.loads(l) for l in LOG.read_text().splitlines()] if LOG.exists() else []
    cutoff = iso(now() - timedelta(days=7))
    rows = [r for r in rows if r["at"] >= cutoff]
    backoff = load(BACKOFF, {})
    out = ["# GitHub feedback (last 7 days)", "",
           f"Generated {iso(now())} by gh-feedback-watch. Read full bodies before acting.", ""]
    out.append("## Backoff (writes refused by the gh shim until `gh-feedback-watch ack`)")
    out += [f"- {repo} since {v['since']}: " + ", ".join(f"@{x['author']} \"{x['hit']}\" {x['url']}" for x in v["items"])
            for repo, v in backoff.items()] or ["- none"]
    for cls in ("complaint", "correction", "feedback"):
        out += ["", f"## {cls}"]
        sel = [r for r in rows if r["class"] == cls]
        out += [f"- {r['at']} {r['repo']}#{r['number']} @{r['author']} ({r.get('author_association')}) "
                f"{'\"' + r['hit'] + '\" ' if r['hit'] else ''}{r['url']}\n  > "
                + re.sub(r"\s+", " ", r["body"])[:300] for r in reversed(sel)] or ["- none"]
    DIGEST.write_text("\n".join(out) + "\n")


def cmd_status(as_json):
    backoff = load(BACKOFF, {})
    rows = [json.loads(l) for l in LOG.read_text().splitlines()] if LOG.exists() else []
    state = load(STATE, {})
    if as_json:
        print(json.dumps({"last_poll": state.get("last_poll"), "backoff": backoff,
                          "recent": rows[-20:]}, indent=1))
        return
    print(f"last poll {state.get('last_poll')}; {len(rows)} replies logged; digest {DIGEST}")
    for repo, v in backoff.items():
        print(f"BACKOFF {repo} since {v['since']} ({len(v['items'])} item(s))")


def cmd_ack(repo, lesson):
    if not lesson or len(lesson) < 20:
        sys.exit("ack needs --lesson '<what we will do differently>' (>= 20 chars)")
    backoff = load(BACKOFF, {})
    # The gh shim prints the repo lowercased; BACKOFF keys keep GitHub's casing.
    repo = next((k for k in backoff if k.lower() == repo.lower()), repo)
    v = backoff.pop(repo, None)
    if v is None:
        sys.exit(f"no backoff for {repo}")
    with LESSONS.open("a") as f:
        f.write(f"\n## {iso(now())} {repo}\n")
        for x in v["items"]:
            f.write(f"- trigger: @{x['author']} \"{x['hit']}\" {x['url']}\n")
        f.write(f"- lesson: {lesson}\n")
    save(BACKOFF, backoff)
    write_digest()
    print(f"backoff lifted for {repo}; lesson appended to {LESSONS}")


# ---- followups: replies to us that need a recheck or an answer, queued for the HUP ChatGPT loop ----
# A free fast model (vllm-sr router, free_pool.fanout) sorts each reply; recheck/answer become
# hermes-upstream-01 state.json pending_followups, which planner.py turns into `followup` briefs.
FU_SEEN = DIR / "followups-seen.json"
FU_HUP = Path("/mnt/zer0models/workspace/zer0/data/operations/chatgpt-driver/hermes-upstream-01")
FU_UP, FU_SINCE = "NousResearch/hermes-agent", "2026-11-05"
Q = """A maintainer or contributor replied on a GitHub thread where we (kvnloo) had left a review finding.
Their reply:
<<<
{body}
>>>
Classify what WE should do. Reply JSON {{"need": "recheck|answer|ack_only|none", "why": "<one sentence>"}}.
recheck = they say they fixed/changed something and ask us (or would benefit from us) to verify it;
answer = they ask us a direct question; ack_only = thanks or info, nothing to verify; none = not about our finding."""


def _gh(*a):
    r = subprocess.run(["gh", *a], capture_output=True, text=True, timeout=60)
    return r.stdout if r.returncode == 0 else ""


def cmd_followups():
    # The live checkout (detached at origin/live): it reads VLLM_SR_URL / the stable NodePort. A side
    # worktree kept a ClusterIP the k3s rebuild retired, so every call hung in connect (11-15).
    sys.path.insert(0, "/mnt/zer0models/z0-wt/z0int-sr-lanes/deploy/vllm-sr")
    from free_pool import FAST, fanout
    seen = json.loads(FU_SEEN.read_text()) if FU_SEEN.exists() else {}
    rows = []
    for line in (LOG.open() if LOG.exists() else ()):
        try:  # poll may be appending this very line; it is read whole next run
            rows.append(json.loads(line))
        except ValueError:
            pass
    rows = [r for r in rows if r.get("repo") == FU_UP and r.get("at", "") >= FU_SINCE and r.get("author") != "kvnloo"]
    latest = {}
    for r in rows:
        latest[str(r["number"])] = r  # newest reply per thread wins
    new = []
    for n, r in latest.items():
        key = f"{n}@{r['at']}"
        if key in seen:
            continue
        mine = _gh("api", f"repos/{FU_UP}/issues/{n}/comments", "--paginate", "-q",
                  f'.[]|select(.user.login=="kvnloo" and .created_at>"{r["at"]}")|.id')
        ours_before = _gh("api", f"repos/{FU_UP}/issues/{n}/comments", "--paginate", "-q",
                         f'.[]|select(.user.login=="kvnloo" and .created_at<"{r["at"]}")|.id')
        if mine.strip() or not (ours_before.strip() or "@kvnloo" in (r.get("body") or "")):
            seen[key] = "skip"
            continue
        got, _ = fanout(Q.format(body=(r.get("body") or "")[:4000]), models=FAST, n=1)
        need = got[0]["json"].get("need", "none") if got else "unclassified"
        seen[key] = need
        if need in ("recheck", "answer", "unclassified"):
            new.append({"number": int(n), "url": r["url"], "author": r.get("author"), "at": r["at"], "need": need,
                        "model": got[0]["model"] if got else None, "excerpt": (r.get("body") or "")[:600]})
        print(n, r.get("author"), need, got[0]["model"] if got else "-", flush=True)
        _fu_save(seen, new[-1:] if new and new[-1]["number"] == int(n) else [])
    _fu_save(seen, [])
    print(json.dumps({"queued": len(new)}))


def _fu_save(seen, add):
    """Checkpoint after every thread: a run killed by the caller's timeout must not lose its progress,
    or the next run redoes the same slow API/model calls and times out again (crash loop 2026-11-10)."""
    tmp = FU_SEEN.with_suffix(".tmp"); tmp.write_text(json.dumps(seen, indent=1)); tmp.replace(FU_SEEN)
    if add:  # runs serially inside hermes_loop.tick() before load_state, so no lock is needed
        st = FU_HUP / "state.json"
        s = json.loads(st.read_text())
        have = {(p["number"], p["at"]) for p in s.get("pending_followups", [])}
        s.setdefault("pending_followups", []).extend(p for p in add if (p["number"], p["at"]) not in have)
        tmp = st.with_suffix(".tmp"); tmp.write_text(json.dumps(s, indent=1)); tmp.replace(st)



def main(a):
    DIR.mkdir(parents=True, exist_ok=True)
    import fcntl
    # followups makes model calls that can take minutes; it has its own lock so the 60 s poll never
    # queues behind it (318 polls died at their 240 s limit that way, 11-13..11-15). It only reads
    # feedback.jsonl, which poll appends to, and writes its own files.
    name = ".followups.lock" if a[:1] == ["followups"] else ".lock"
    lock = open(DIR / name, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)        # timer and manual runs of one kind never interleave
    if not a or a[0] == "poll":
        cmd_poll()
    elif a[0] == "backfill":
        cmd_backfill(a[1] if len(a) > 1 else 48)
    elif a[0] == "status":
        cmd_status("--json" in a)
    elif a[0] == "followups":
        cmd_followups()
    elif a[0] == "ack" and len(a) >= 2:
        lesson = a[a.index("--lesson") + 1] if "--lesson" in a else ""
        cmd_ack(a[1], lesson)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
