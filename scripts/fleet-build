#!/usr/bin/env bash
# fleet-build: run verification OFF groot. Public committed heavy work prefers
# --node avrea; local-data/native jobs use the host fleet. Routing policy:
# docs/fleet/README.md, "Default routing".
#
#   fleet-build [opts] [--] CMD...        run from anywhere inside the repo
#
#   --android        Gradle/Android build: class android-build (mbp), --mem 6G, 4 CPUs, JDK 17.
#                    Implied when CMD starts with ./gradlew or gradle.
#   --jdk 17|21      JAVA_HOME for the job (Lawnchair needs 21; NOOP uses 17)
#   --gradle-args S  flags put after ./gradlew to fit the job's memory cap (default
#                    below: one JVM, Kotlin in-process, 4 GiB heap, 4 workers; a
#                    Gradle 2 GiB + Kotlin 4 GiB daemon pair peaked at 6.5 GiB and was
#                    OOM-killed in a 6 GiB scope). --gradle-args '' keeps the repo's own.
#   --light          lint / pure-Python tests / scans / git work: phones allowed
#                    (--tolerate phone, --mem 512M: fits the S25's ~2.1 GiB free over
#                    its 1200 MiB floor); mbp still wins unless it is busier
#   --phone          like --light but only on a phone (arm64)
#   --node NAME      pin a node (avrea, mbp, k3s-mbp, s22, omarchy-phone, boat)
#   --mem 4G --cpus 4 --timeout 3600   requests/limits (defaults per mode)
#   --wait SECS      0 = don't wait; Kueue allows a 5s controller admission grace.
#                    Positive = bounded wait (default 1800); k3s-mbp -1 = indefinite.
#                    Oversized Kueue requests exit 75; never fall back to groot.
#   --fetch PATH     copy PATH back (relative to the directory you ran from); repeatable
#   --out DIR        put fetched files in DIR (default: ~/.local/state/fleet/runs/<job>/)
#   --src DIR        repo to ship (default: the git toplevel of the cwd)
#   --public         reviewed public source; allow Boat overflow before queueing
#   --x86|--docker   prefer Boat (implies --public); install job dependencies explicitly
#   --local-data     never send this job to Boat, even with --public
#   --repo OWNER/REPO --sha SHA  Avrea: public exact head (otherwise clean local origin/HEAD)
#   --runner LABEL --matrix FILE --parallel N --snapshot FILE  Avrea options
#
# Examples:
#   cd noop-oura/android && fleet-build --fetch app/build/outputs/apk/debug --out /tmp/apk -- ./gradlew assembleFullDebug
#   cd lawnchair && fleet-build --jdk 21 -- ./gradlew assembleLawnWithQuickstepPlayDebug
#   fleet-build -- bun test
#   fleet-build --light -- python3 -m pytest tests/unit
#
# Exit codes are the job's; 75 = no worker has room right now. Then wait and retry,
# lower --mem, or try --light. Do not fall back to a groot build unless the toolchain
# exists only there (GPU), and say so.
set -euo pipefail
FLEET="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/fleet"
# One brace group: bash parses the whole script before running it, so editing this file
# while a long build runs cannot break the running copy.
{

mode=build; jdk=""; node=""; mem=""; cpus=""; timeout=""; src=""; out=""; fetch=(); inputs=(); avrea_opts=(); keep=0; wait_s=1800; public=0; local_data=0; prefer_boat=0
gradle_args="-Pkotlin.compiler.execution.strategy=in-process -Dorg.gradle.jvmargs=-Xmx4g\ -XX:MaxMetaspaceSize=768m\ -Dfile.encoding=UTF-8 --max-workers=4"
while [ $# -gt 0 ]; do
  case $1 in
    --android) mode=android; shift ;;
    --light) mode=light; shift ;;
    --phone) mode=phone; shift ;;
    --public) public=1; shift ;;
    --x86|--docker) public=1; prefer_boat=1; shift ;;
    --local-data) local_data=1; shift ;;
    --jdk) jdk=$2; shift 2 ;;
    --gradle-args) gradle_args=$2; shift 2 ;;
    --node) node=$2; shift 2 ;;
    --repo|--sha|--runner|--matrix|--parallel|--snapshot) avrea_opts+=("$1" "$2"); shift 2 ;;
    --mem) mem=$2; shift 2 ;;
    --cpus) cpus=$2; shift 2 ;;
    --timeout) timeout=$2; shift 2 ;;
    --wait) wait_s=$2; shift 2 ;;
    --src) src=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --fetch) fetch+=("$2"); shift 2 ;;
    --input) inputs+=("$2"); shift 2 ;;
    --keep) keep=1; shift ;;
    -h|--help) sed -n '2,32p' "$0"; exit 0 ;;
    --) shift; break ;;
    -*) echo "fleet-build: unknown option $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
if [ "$node" = avrea ]; then
  [ "$local_data" = 0 ] || { echo "fleet-build: --local-data cannot use Avrea" >&2; exit 2; }
  [ ${#inputs[@]} -eq 0 ] && [ "$keep" = 0 ] && [ -z "$jdk" ] && [ "$mode" = build ] && [ -z "$mem" ] && [ -z "$cpus" ] || {
    echo "fleet-build: Avrea uses public exact commits and --runner; local input/keep/JDK/mode/resource flags are host-only." >&2; exit 2;
  }
  [ -z "$src" ] || avrea_opts+=(--src "$src")
  [ -z "$out" ] || avrea_opts+=(--out "$out")
  [ -z "$timeout" ] || avrea_opts+=(--timeout "$timeout")
  avrea_opts+=(--wait "$wait_s")
  for f in "${fetch[@]}"; do avrea_opts+=(--fetch "$f"); done
  exec "$(dirname "$FLEET")/fleet-avrea" "${avrea_opts[@]}" -- "$@"
fi
[ ${#avrea_opts[@]} -eq 0 ] || { echo "fleet-build: Avrea-only flags require --node avrea" >&2; exit 2; }
[ $# -gt 0 ] || { sed -n '2,32p' "$0"; exit 2; }
case $1 in ./gradlew|gradlew|gradle) [ "$mode" = build ] && mode=android ;; esac
[ -n "$jdk" ] && [ "$mode" = build ] && mode=android
if [ "$prefer_boat" = 1 ] && [ -z "$node" ] && [ "$local_data" = 0 ]; then node=boat; fi
if [ "$node" = boat ] && [ "$local_data" = 1 ]; then
  echo "fleet-build: --local-data cannot use Boat" >&2; exit 2
fi

# Ship the whole repo, run from the same subdirectory the caller is in.
if [ -z "$src" ]; then
  src=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
fi
src=$(cd "$src" && pwd)
here=$(pwd)
case $here/ in "$src"/*) rel=${here#"$src"}; rel=${rel#/} ;; *) rel="" ;; esac
rel=${rel:-.}

args=(run --src "$src")
case $mode in
  android) args+=(--class android-build --mem "${mem:-6G}" --cpus "${cpus:-4}"); jdk=${jdk:-17} ;;
  build)   args+=(--class build --mem "${mem:-3G}"); [ -n "$cpus" ] && args+=(--cpus "$cpus") ;;
  light)   args+=(--tolerate phone --mem "${mem:-512M}"); [ -n "$cpus" ] && args+=(--cpus "$cpus") ;;
  phone)   args+=(--arch arm64 --tolerate phone --mem "${mem:-512M}") ;;
esac
[ -n "$node" ] && args+=(--node "$node")
[ -n "$timeout" ] && args+=(--timeout "$timeout")
[ "$keep" = 0 ] || args+=(--keep)
for input in "${inputs[@]}"; do args+=(--input "$input"); done
pre=src/; [ "$rel" = . ] || pre=src/$rel/
for f in "${fetch[@]}"; do args+=(--fetch "$pre$f"); done

# Remote side: cd to the same subdirectory, pick the JDK, run CMD unchanged.
# JAVA17_HOME/JAVA21_HOME come from the node's /etc/fleet/toolchain.env.
script='cd "$1" && shift
case ${FLEET_BUILD_JDK:-} in
  17) [ -n "${JAVA17_HOME:-}" ] || { echo "fleet-build: no JDK 17 on $(hostname)" >&2; exit 3; }; export JAVA_HOME=$JAVA17_HOME ;;
  21) [ -n "${JAVA21_HOME:-}" ] || { echo "fleet-build: no JDK 21 on $(hostname)" >&2; exit 3; }; export JAVA_HOME=$JAVA21_HOME ;;
esac
[ -n "${JAVA_HOME:-}" ] && export PATH=$JAVA_HOME/bin:$PATH
case $1 in
  ./gradlew|gradlew|gradle)
    g=$1; shift
    # FLEET_GRADLE_ARGS is word-split on purpose; "\ " keeps a space inside one flag.
    eval "set -- $FLEET_GRADLE_ARGS \"\$@\""
    set -- "$g" "$@"
    echo "fleet-build: $*" >&2 ;;
esac
exec "$@"'
[ "$mode" = android ] || gradle_args=""
args+=(-- env "FLEET_BUILD_JDK=$jdk" "FLEET_GRADLE_ARGS=$gradle_args" bash -c "$script" fleet-build "$rel" "$@")
use_kueue=0
runner=("$FLEET"); run_args=("${args[@]}")
if [ "$node" = k3s-mbp ]; then
  use_kueue=1
  runner=(python3 "$(dirname "$FLEET")/fleet-kueue" --wait "$wait_s")
  [ -z "$out" ] || runner+=(--out "$out")
  run_args=("${args[@]:1}")
fi

err=$(mktemp); trap 'rm -f "$err"' EXIT
deadline=$(( $(date +%s) + wait_s ))
while :; do
  set +e
  "${runner[@]}" "${run_args[@]}" 2> >(tee "$err" >&2)
  rc=$?
  set -e
  wait 2>/dev/null || true
  # Only reviewed public jobs may overflow to Boat. No allocated job is replayed.
  if [ $rc -eq 75 ] && [ "$public" = 1 ] && [ "$local_data" = 0 ] && [ -z "$node" ] && ! grep -q '^fleet: job ' "$err"; then
    set +e
    "$FLEET" run --node boat "${args[@]:1}" 2> >(tee "$err" >&2)
    rc=$?
    set -e
    wait 2>/dev/null || true
  fi
  # Admission holds are retryable. Once a job ID was allocated, a 75 might
  # come from a partially executed workflow; never replay side effects blindly.
  [ "$use_kueue" = 0 ] && [ $rc -eq 75 ] && ! grep -q '^fleet: job ' "$err" && [ "$(date +%s)" -lt "$deadline" ] || break
  echo "fleet-build: no room yet; retrying in 60 s (until $(date -d @$deadline +%H:%M))" >&2
  sleep 60
done
jid=$(sed -n 's/^fleet: job \([0-9a-f-]*\) -> .*/\1/p' "$err" | head -1)
if [ $rc -eq 75 ]; then
  echo "fleet-build: no worker has room now (exit 75). Retry later or lower --mem; do not queue it on groot." >&2
fi
if [ -n "$out" ] && [ -n "$jid" ] && [ ${#fetch[@]} -gt 0 ]; then
  state=${FLEET_STATE:-$HOME/.local/state/fleet}
  mkdir -p "$out"
  for f in "${fetch[@]}"; do
    p="$state/runs/$jid/$pre$f"
    [ -e "$p" ] && cp -a "$p" "$out/" && echo "fleet-build: $f -> $out/$(basename "$f")" >&2
  done
fi
exit $rc
}
