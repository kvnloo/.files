#!/usr/bin/env python3
"""Measure real CPU busy % per phone from two /proc/stat samples over adb (not loadavg).

  fleet-phone-util [--seconds 10] [--json] NAME=SERIAL...
Load average on Android counts uninterruptible waits and reads ~10 while the CPUs idle,
so busy % = 1 - idle_delta / total_delta, aggregated across all cores.
"""
import argparse
import json
import subprocess
import sys
import time


def stat(serial):
    res = subprocess.run(["adb", "-P", "5037", "-s", serial, "shell", "head -1 /proc/stat; nproc"],
                         capture_output=True, text=True, timeout=20)
    if res.returncode:
        raise RuntimeError((res.stderr or res.stdout).strip() or f"adb exit {res.returncode}")
    out = res.stdout.split("\n")
    fields = [int(x) for x in out[0].split()[1:]]
    return sum(fields), fields[3] + fields[4], int(out[1])


def safe(fn, serial):
    try:
        return fn(serial)
    except (OSError, ValueError, IndexError, RuntimeError, subprocess.SubprocessError) as e:
        return {"error": f"{type(e).__name__}: {e}"[:200]}


def busy(a, b):
    total, idle = b[0] - a[0], b[1] - a[1]
    return round(100 * (1 - idle / total), 1) if total > 0 else None


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--seconds", type=float, default=10)
    p.add_argument("--json", action="store_true")
    p.add_argument("phones", nargs="+", help="NAME=SERIAL")
    args = p.parse_args()
    phones = dict(x.split("=", 1) for x in args.phones)
    first = {n: safe(stat, s) for n, s in phones.items()}
    time.sleep(args.seconds)
    rows = {}
    for n, s in phones.items():
        second = safe(stat, s) if "error" not in first[n] else first[n]
        rows[n] = (second if "error" in second  # one offline phone must not void the others' sample
                   else {"busy_pct": busy(first[n], second), "cores": first[n][2]})
    rows = {"at": time.time(), "seconds": args.seconds, "phones": rows}
    print(json.dumps(rows) if args.json else "\n".join(
        (f"{n}: {r['error']}" if "error" in r else f"{n}: {r['busy_pct']}% of {r['cores']} cores") for n, r in rows["phones"].items()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
