#!/usr/bin/env python3
"""Append one JSON receipt per memory-unit run (ExecStopPost). Never fails the unit.

The user journal rotates within hours on groot, so run outcomes for the memory units were lost
(memory-services-20261027 step 0b). This writes them to a durable JSONL file instead:
  ~/.local/state/memory-services/receipts.jsonl   (override: MEMORY_RECEIPTS)
Usage: memory-unit-receipt UNIT [COUNTS_JSON]
Fields: ts, unit, result ($SERVICE_RESULT), exit_code, exit_status, start/exit timestamps, seconds,
and the unit's own counts file (if given, newer than the run start, and valid JSON; else counts=null).
"""
import json, os, pathlib, subprocess, sys, time


def show(unit):
    try:
        out = subprocess.run(['systemctl', '--user', 'show', unit, '--timestamp=unix',
                              '-p', 'ExecMainStartTimestamp', '-p', 'ExecMainExitTimestamp', '-p', 'InvocationID'],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return dict(line.split('=', 1) for line in out.splitlines() if '=' in line)


def epoch(value):
    value = (value or '').strip().lstrip('@')
    try:
        return float(value)
    except ValueError:
        return None


def main(argv):
    if not argv:
        return 0
    unit = argv[0]
    props = show(unit)
    start, end = epoch(props.get('ExecMainStartTimestamp')), epoch(props.get('ExecMainExitTimestamp'))
    counts = None
    if len(argv) > 1:
        path = pathlib.Path(os.path.expanduser(argv[1]))
        try:
            if start is None or path.stat().st_mtime >= start - 1:
                counts = json.loads(path.read_text()[:65536])
        except (OSError, ValueError):
            counts = None
    row = {'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'unit': unit,
           'invocation': props.get('InvocationID') or None,
           'result': os.environ.get('SERVICE_RESULT'), 'exit_code': os.environ.get('EXIT_CODE'),
           'exit_status': os.environ.get('EXIT_STATUS'),
           'seconds': round(end - start, 1) if start and end and end >= start else None, 'counts': counts}
    target = pathlib.Path(os.environ.get('MEMORY_RECEIPTS') or
                          pathlib.Path.home() / '.local/state/memory-services/receipts.jsonl')
    target.parent.mkdir(parents=True, exist_ok=True)
    with open(target, 'a') as f:
        f.write(json.dumps(row, separators=(',', ':')) + '\n')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:  # a receipt must never change the unit's result
        print(f'memory-unit-receipt: {type(exc).__name__}: {exc}', file=sys.stderr)
        sys.exit(0)
