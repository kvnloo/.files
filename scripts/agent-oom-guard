#!/usr/bin/env python3
"""Bias kernel OOM scoring and relieve Normal-zone pressure before desktop failure.

Protect roots and desktop infrastructure independently of live agent ancestry;
terminate at most one positively classified substantial tool/batch process at a
time using pidfds. Scores and proactive relief are not an OOM survival guarantee.
It is the only writer of agent oom_score_adj values (agent-launch and
agent-resource-classify no longer write them).

Every kernel OOM kill is appended to ~/.local/state/agent-oom/kills.jsonl with the
class the victim had at its last observation. A protected victim is logged at
CRITICAL priority and sent to the desktop: scoring was insufficient, not immunity.

  agent-oom-guard            run (systemd user service agent-oom-guard.service)
  agent-oom-guard --once     one pass, print the JSON result
  agent-oom-guard --dry-run  with --once: classify only, write nothing
  agent-oom-guard --check    exit 1 and list every way root protection is broken now
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import threading

sys.path.insert(0, str(Path(__file__).resolve().parent))
import agent_oom_policy as policy  # noqa: E402

STATE = Path(os.environ.get('AGENT_OOM_STATE', Path.home() / '.local/state/agent-oom'))
TICK = 1.0
FULL = 5.0           # re-read every /proc/PID/stat; in between only new or young processes
YOUNG = 5.0          # a process may still exec into its final identity this long after appearing
REFRESH = 15.0       # re-read cgroups/cmdlines, re-check every score, refresh unit mains
KILL_POLL = 20.0
SUMMARY = 300.0
HISTORY = 900.0      # how long a vanished PID keeps its last class for kill attribution
KILLED = re.compile(r'Killed process (\d+) \((.*?)\).*?anon-rss:(\d+)kB.*?oom_score_adj:(-?\d+)')


def log(message: str, priority: int = 6) -> None:
    # <N> prefixes are journald priorities (2 = critical, 4 = warning, 6 = info).
    print(f'<{priority}>{message}', flush=True)


def unit_mains() -> dict:
    try:
        out = subprocess.run(['systemctl', '--user', 'show', '--type=service', '--state=active',
                              '-p', 'Id', '-p', 'MainPID', '*'],
                             capture_output=True, text=True, timeout=15).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    mains = {}
    for block in out.strip().split('\n\n'):
        row = dict(line.split('=', 1) for line in block.splitlines() if '=' in line)
        if row.get('MainPID', '0').isdigit() and int(row.get('MainPID', '0')):
            mains[row['Id']] = int(row['MainPID'])
    return mains


def load(path: Path) -> dict:
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def save(path: Path, value) -> None:
    tmp = path.with_name(path.name + '.tmp')
    tmp.write_text(json.dumps(value, sort_keys=True))
    os.replace(tmp, path)


def record_kills(history: dict) -> None:
    """Append new kernel OOM kills; attribute each to the victim's last known class."""
    try:
        out = subprocess.run(['journalctl', '-k', '--no-pager', '-o', 'short-unix', '-q',
                              f'--cursor-file={STATE / "kmsg.cursor"}', '-g', 'Killed process'],
                             capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError) as error:
        log(f'kill log unavailable: {error}', 4)
        return
    rows = []
    for line in out.splitlines():
        match = KILLED.search(line)
        if not match:
            continue
        pid, comm, anon_kb, adj = int(match[1]), match[2], int(match[3]), int(match[4])
        seen = history.get(pid)
        kind = seen[1] if seen and seen[0] == comm[:15] else 'unknown'
        row = {'ts': float(line.split()[0]), 'pid': pid, 'comm': comm, 'anon_mb': anon_kb // 1024,
               'oom_score_adj': adj, 'class': kind}
        rows.append(row)
        if kind == 'protected':
            log(f'OOM killed PROTECTED {comm} pid={pid} adj={adj}: root protection failed', 2)
            subprocess.run(['notify-send', '-u', 'critical', 'OOM killed a protected agent process',
                            f'{comm} (pid {pid}, adj {adj}); see {STATE / "kills.jsonl"}'],
                           capture_output=True, timeout=10, check=False)
    if rows:
        with (STATE / 'kills.jsonl').open('a') as handle:
            for row in rows:
                handle.write(json.dumps(row) + '\n')
        log(f'recorded {len(rows)} OOM kill(s): '
            + ', '.join(f"{r['comm']}({r['class']},adj={r['oom_score_adj']})" for r in rows), 4)


def check(state: dict | None = None) -> list:
    """Report score/cgroup hazards; success is not a global OOM survival guarantee."""
    state = state or {'cache': {}, 'mains': unit_mains()}
    problems = []
    procs = policy.scan(cache=state['cache'])
    protected, _, _ = policy.decide(procs, state['mains'] or unit_mains())
    for pid in sorted(protected):
        try:
            value = int(Path(f'/proc/{pid}/oom_score_adj').read_text())
        except (OSError, ValueError):
            continue
        if value > policy.FLOOR_ADJ:
            problems.append(f'protected {procs[pid].comm} pid={pid} at oom_score_adj {value}')
    legacy = [pid for pid, p in procs.items()
              if p.comm == 'bash' and len(p.args) > 1 and Path(p.args[1]).name == 'agent-launch']
    if legacy:
        problems.append(f'legacy agent-launch watchers raising scores: {legacy}')
    units = sorted({policy.unit_of(procs[pid].cgroup) for pid in protected} - {''})
    if units:
        out = subprocess.run(['systemctl', '--user', 'show', '-p', 'Id', '-p', 'OOMPolicy', *units],
                             capture_output=True, text=True, timeout=15).stdout
        for block in out.strip().split('\n\n'):
            row = dict(line.split('=', 1) for line in block.splitlines() if '=' in line)
            if row.get('OOMPolicy') == 'stop':
                problems.append(f"{row.get('Id')} holds a protected process but has OOMPolicy=stop")
    try:
        dump = subprocess.run(['oomctl', 'dump'], capture_output=True, text=True, timeout=15).stdout
        watched = [line.split(':', 1)[1].strip() for line in dump.splitlines()
                   if line.strip().startswith('Path:')]
        for pid in protected:
            cg = procs[pid].cgroup
            hit = [w for w in watched if w != '/' and (cg == w or cg.startswith(w.rstrip('/') + '/'))]
            if hit:
                problems.append(f'systemd-oomd can kill cgroup {hit[0]} holding {procs[pid].comm} pid={pid}')
                break
    except (OSError, subprocess.SubprocessError):
        pass
    if subprocess.run(['systemctl', '--user', 'is-active', '--quiet', 'agent-oom-guard.service'],
                      timeout=5).returncode:
        problems.append('agent-oom-guard.service is not active')
    try:
        # Report only kills newer than the last summary so one protected kill
        # is logged once, not re-logged on every SUMMARY pass.
        kills_path = STATE / 'kills.jsonl'
        offset_path = STATE / 'kills-reported.offset'
        text = kills_path.read_text()
        offset = 0
        try:
            offset = int(offset_path.read_text().strip())
        except (OSError, ValueError):
            offset = 0
        if offset > len(text):        # rotated or truncated: re-report from start
            offset = 0
        for line in text[offset:].splitlines():
            if not line.strip():
                continue
            row = json.loads(line)
            if row.get('class') == 'protected':
                problems.append(f"protected process was OOM-killed: {row}")
        offset_path.write_text(str(len(text)))
    except (OSError, ValueError):
        pass
    pressure = policy.read_pressure()
    if not pressure['available']:
        problems.append('Normal-zone pressure telemetry unavailable')
    elif pressure['threatened']:
        problems.append(f'Normal-zone reserve threatened: {pressure["zones"]}')
    if not hasattr(os, 'pidfd_open') or not hasattr(policy.signal, 'pidfd_send_signal'):
        problems.append('pidfd relief unavailable')
    return problems


def tick(state: dict, dry_run: bool = False) -> dict:
    now = time.monotonic()
    if now - state['refreshed'] >= REFRESH:
        state['cache'].clear()
        state['checked'].clear()
        # Unit discovery runs in housekeeping, never on the protection path.
        state['refreshed'] = now
    pressure = policy.read_pressure()
    relief = state.setdefault('relief', policy.Relief())
    full = now - state['full'] >= FULL or pressure['threatened'] or relief.pending is not None
    if pressure['threatened'] or relief.pending is not None:
        state['cache'].clear()
    if full:
        state['full'] = now
        state['foreign'].clear()
    first = state['first_seen']
    reuse = None if full else {pid: p for pid, p in state['procs'].items()
                               if now - first.get((pid, p.start), now) >= YOUNG}
    procs = policy.scan(cache=state['cache'], reuse=reuse, foreign=state['foreign'])
    for key in [k for k in first if k[0] not in procs or procs[k[0]].start != k[1]]:
        del first[key]
    for p in procs.values():
        first.setdefault((p.pid, p.start), now)
    state['procs'] = procs
    protected, disposable, batch = policy.decide(procs, state['mains'])
    if not state['mains']:
        # Discovery may still be blocked. Preserve prior protection by PID/start
        # identity instead of restoring generic service roots during startup.
        protected |= {pid for pid, p in procs.items()
                      if f'{pid}:{p.start}' in state['lowered']}
        disposable -= protected
        batch -= protected
    lowered = dict(state['lowered']) if dry_run else state['lowered']
    before = dict(lowered)
    result = policy.apply(procs, protected, disposable, lowered, state['checked'], dry_run=dry_run,
                          batch=batch)
    result['pressure'] = pressure
    if not state['mains']:
        result['relief'] = {'action': 'unit-discovery-unavailable'}
    else:
        result['relief'] = relief.step(procs, protected, disposable, batch, pressure, now,
                                       dry_run=dry_run, unit_mains=state['mains'])
    cache_relief = state.setdefault('cache_relief', policy.CacheRelief())
    fallback = result['relief']['action'] in {'no-candidate', 'unavailable',
                                             'unit-discovery-unavailable', 'changed'}
    if (pressure['threatened'] and fallback) or cache_relief.thread is not None:
        result['cache_relief'] = cache_relief.step(now, dry_run=dry_run)
    if not dry_run and lowered != before:
        save(STATE / 'lowered.json', lowered)
    wall = time.time()
    for pid in protected:
        state['history'][pid] = (procs[pid].comm[:15], 'protected', wall)
    for pid in disposable:
        state['history'][pid] = (procs[pid].comm[:15], 'disposable', wall)
    for pid in batch:
        state['history'][pid] = (procs[pid].comm[:15], 'batch', wall)
    for pid in [pid for pid, (_, _, ts) in state['history'].items() if wall - ts > HISTORY]:
        del state['history'][pid]
    return result


def housekeeping(state):
    """Blocking service/journal/notification helpers never delay the urgent loop.

    One daemon thread bounds subprocess concurrency and avoids unbounded work
    queues. A stalled helper delays diagnostics only; timeouts still bound it.
    """
    last_kills = last_check = float('-inf')
    while True:
        try:
            state['mains'] = unit_mains()
            now = time.monotonic()
            if now - last_kills >= KILL_POLL:
                record_kills(dict(state['history']))
                last_kills = now
            if now - last_check >= SUMMARY:
                snapshot = {'cache': {}, 'mains': dict(state['mains'])}
                for problem in check(snapshot):
                    log(f'PROTECTION HAZARD: {problem}', 2)
                last_check = now
        except Exception as error:
            log(f'housekeeping failed: {type(error).__name__}: {error}', 4)
        time.sleep(REFRESH)


def main() -> int:
    once = '--once' in sys.argv
    dry_run = '--dry-run' in sys.argv
    STATE.mkdir(parents=True, exist_ok=True)
    state = {'cache': {}, 'checked': set(), 'mains': {}, 'refreshed': float('-inf'),
             'full': float('-inf'), 'procs': {}, 'first_seen': {}, 'foreign': set(),
             'lowered': load(STATE / 'lowered.json'), 'history': {}}
    if '--check' in sys.argv:
        problems = check()
        print(json.dumps({'ok': not problems, 'problems': problems}, indent=1))
        return 1 if problems else 0
    if once:
        state['mains'] = unit_mains()
        result = tick(state, dry_run)
        print(json.dumps(result))
        return 1 if result['failures'] else 0
    threading.Thread(target=housekeeping, args=(state,), daemon=True,
                     name='oom-housekeeping').start()
    log(f'started; protected={policy.FLOOR_ADJ} disposable={policy.DISPOSABLE_ADJ} '
        f'batch={policy.BATCH_ADJ} tick={TICK}s')
    totals = {'raised': 0, 'handed_back': 0, 'failures': 0}
    last_summary = float('-inf')
    protected = 0
    while True:
        try:
            result = tick(state)
            protected = len(result['protected'])
            for key in ('lowered', 'restored'):
                for row in result[key]:
                    log(f'{key} {row}')
            for key in totals:
                totals[key] += len(result[key])
            for failure in result['failures']:
                log(f'write failed {failure}', 4)
            if result['relief']['action'] not in {'none', 'waiting', 'cooldown'}:
                log(f'pressure relief: {json.dumps(result["relief"])}', 4)
            cache_action = result.get('cache_relief')
            if cache_action and cache_action['action'] not in {
                    'cache-reclaim-pending', 'cache-reclaim-cooldown'}:
                log(f'file-cache relief: {json.dumps(cache_action)}', 4)
            now = time.monotonic()
            # All blocking diagnostics run in the bounded housekeeping thread.
            if now - last_summary >= SUMMARY:
                log(f'protected={protected} since-last: {totals}')
                totals = dict.fromkeys(totals, 0)
                last_summary = now
        except Exception as error:  # one bad snapshot must not stop the guard
            log(f'tick failed: {type(error).__name__}: {error}', 3)
        time.sleep(TICK)


if __name__ == '__main__':
    raise SystemExit(main())
