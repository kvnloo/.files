#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${DOTFILES_ENV_FILE:-${repo_root}/secrets/.env}"
keys_file="${DOTFILES_ENV_KEYS_FILE:-${repo_root}/secrets/.env.keys}"

if (( $# == 0 )); then
  printf 'usage: %s COMMAND [ARG ...]\n' "${0##*/}" >&2
  exit 64
fi

command -v dotenvx >/dev/null 2>&1 || {
  printf 'with-secrets: dotenvx is not installed\n' >&2
  exit 127
}

[[ -r "$env_file" ]] || {
  printf 'with-secrets: encrypted env not found: %s\n' "$env_file" >&2
  exit 66
}

[[ -r "$keys_file" ]] || {
  printf 'with-secrets: local key not found: %s\n' "$keys_file" >&2
  exit 66
}

exec dotenvx run --strict -f "$env_file" -fk "$keys_file" -- "$@"
