#!/usr/bin/env bash
# Dual-path onboarding for .files
#
# Paths:
#   1) Interactive installer:  ./install   or  ./scripts/onboard install
#   2) LLM harness guided:     agents read AGENTS.md / CLAUDE.md, run
#                              ./scripts/onboard status --json, then walk modules
#
# Usage:
#   onboard status [--json]
#   onboard detect-harness
#   onboard doctor
#   onboard install [--interactive] [--all] [--yes] [--module NAME ...]
#   onboard run MODULE [--yes]
#   onboard list-modules
#   onboard offer   # ask whether to start onboarding (for harness hooks)

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/onboard-common.sh
source "${SCRIPT_DIR}/lib/onboard-common.sh"

REPO_ROOT="$(onboard_repo_root)"
REPO_ROOT="$(readlink -f "$REPO_ROOT" 2>/dev/null || printf '%s\n' "$REPO_ROOT")"
export ONBOARD_REPO_ROOT="$REPO_ROOT"

MODULES=(
  core-links
  agent-skills
  agent-tools
  tailnet-ssh
  nix-home
  audio-evolution
  nvidia-pair
  ai-dev-tools
)

MODULE_HELP=(
  "core-links:Symlink shell, tmux, git, Hyprland, nvim, noctalia, and CLI helpers"
  "agent-skills:Install workspace-copilot skill into Claude/Codex/OpenCode/Gemini skill dirs"
  "agent-tools:Install Agent Reach, yt-dlp, and shared mcporter MCP config"
  "tailnet-ssh:Enable Tailscale + SSH for private remote access (Linux)"
  "nix-home:Bootstrap Nix + Home Manager on CachyOS/Arch hosts"
  "audio-evolution:Install PipeWire Aural Evolution headphone DSP chain"
  "nvidia-pair:NVIDIA Personal AI Router (PAIR) — local AI inference router"
  "ai-dev-tools:AI/ML development stack (ollama, cursor, opencode, docker, python-pipx, node)"
)

usage() {
  cat <<'EOF'
Usage: onboard <command> [options]

Commands:
  status [--json]              Show onboarding completion state
  detect-harness               Print detected LLM harness (or unknown)
  doctor                       Quick health checks for this machine
  list-modules                 List installable modules
  offer                        Prompt to start interactive onboarding
  install [options]            Interactive or batch installer
  run <module> [--yes]         Run a single module

Install options:
  --interactive                Menu-driven TTY installer (default when stdin is a TTY)
  --all                        Run every recommended module with prompts
  --yes                        Assume yes for prompts (non-destructive skips still apply)
  --module NAME                Run only the named module (repeatable)
  --noninteractive             Never prompt; use defaults / --yes

Examples:
  ./install
  ./scripts/onboard install --interactive
  ./scripts/onboard status --json
  ./scripts/onboard run agent-tools --yes
EOF
}

cmd_detect_harness() {
  onboard_detect_harness
}

cmd_list_modules() {
  local entry name desc
  for entry in "${MODULE_HELP[@]}"; do
    name="${entry%%:*}"
    desc="${entry#*:}"
    printf '%-18s  %s\n' "$name" "$desc"
  done
}

module_description() {
  local want="$1" entry
  for entry in "${MODULE_HELP[@]}"; do
    if [[ "${entry%%:*}" == "$want" ]]; then
      printf '%s\n' "${entry#*:}"
      return 0
    fi
  done
  printf '%s\n' "$want"
}

is_known_module() {
  local want="$1" m
  for m in "${MODULES[@]}"; do
    [[ "$m" == "$want" ]] && return 0
  done
  return 1
}

# --- module implementations -------------------------------------------------

run_core_links() {
  local repo="$REPO_ROOT"
  printf '\n==> core-links\n'

  mkdir -p "$HOME/.local/bin" "$HOME/.config"

  # Workspace convenience link used throughout this repo
  if [[ -d "/workspace" && ! -e "$HOME/workspace" ]]; then
    ln -s /workspace "$HOME/workspace"
    printf '  linked ~/workspace -> /workspace\n'
  fi

  onboard_link "$repo/.gitconfig" "$HOME/.gitconfig"
  onboard_link "$repo/config/zsh/.zshrc" "$HOME/.zshrc"
  onboard_link "$repo/config/.tmux.conf" "$HOME/.tmux.conf"
  onboard_link "$repo/config/fish" "$HOME/.config/fish"

  if [[ -d "$repo/config/hyprland" ]]; then
    mkdir -p "$HOME/.config/hypr"
    onboard_link "$repo/config/hyprland/hyprland.conf" "$HOME/.config/hypr/hyprland.conf"
    onboard_link "$repo/config/hyprland/hyprlock.conf" "$HOME/.config/hypr/hyprlock.conf"
    onboard_link "$repo/config/hyprland/hypridle.conf" "$HOME/.config/hypr/hypridle.conf"
    if [[ -f "$HOME/.config/hypr/hyprland.lua" ]]; then
      mkdir -p "$HOME/.config/hypr/config"
      onboard_link "$repo/config/hyprland/config/binds.lua" "$HOME/.config/hypr/config/binds.lua"
      local host_binds="$repo/config/hyprland/hosts/$(hostname -s)/binds.lua"
      [[ -f "$host_binds" ]] && onboard_link "$host_binds" "$HOME/.config/hypr/config/device-binds.lua"
    elif [[ -d "$repo/config/hyprland/config" ]]; then
      onboard_link "$repo/config/hyprland/config" "$HOME/.config/hypr/config"
    fi
  fi

  onboard_link "$repo/config/nvim" "$HOME/.config/nvim"
  onboard_link "$repo/config/noctalia" "$HOME/.config/noctalia"
  onboard_link "$repo/config/codexbar/config.json" "$HOME/.config/codexbar/config.json"
  onboard_link "$repo/config/waybar" "$HOME/.config/waybar"
  onboard_link "$repo/config/rofi" "$HOME/.config/rofi"
  onboard_link "$repo/config/dunst" "$HOME/.config/dunst"
  onboard_link "$repo/config/agent-deck/config.toml" "$HOME/.config/agent-deck/config.toml"
  onboard_link "$repo/config/awatcher/config.toml" "$HOME/.config/awatcher/config.toml"
  onboard_link "$repo/config/zed/settings.json" "$HOME/.config/zed/settings.json"

  # PipeWire user configs (non-destructive link of tracked fragments)
  if [[ -d "$repo/config/pipewire" ]]; then
    mkdir -p "$HOME/.config/pipewire/pipewire.conf.d" \
             "$HOME/.config/pipewire/pipewire-pulse.conf.d"
    [[ -f "$repo/config/pipewire/pipewire.conf" ]] && \
      onboard_link "$repo/config/pipewire/pipewire.conf" "$HOME/.config/pipewire/pipewire.conf"
    local f
    for f in "$repo"/config/pipewire/pipewire.conf.d/*.conf; do
      [[ -e "$f" ]] || continue
      onboard_link "$f" "$HOME/.config/pipewire/pipewire.conf.d/$(basename "$f")"
    done
    for f in "$repo"/config/pipewire/pipewire-pulse.conf.d/*.conf; do
      [[ -e "$f" ]] || continue
      onboard_link "$f" "$HOME/.config/pipewire/pipewire-pulse.conf.d/$(basename "$f")"
    done
  fi

  # Sunshine phone-desktop (config only; credentials stay in ~/.config/sunshine)
  if [[ -d "$repo/config/sunshine" ]]; then
    mkdir -p "$HOME/.config/sunshine"
    onboard_link "$repo/config/sunshine/apps.json" "$HOME/.config/sunshine/apps.json"
    onboard_link "$repo/config/sunshine/sunshine.conf" "$HOME/.config/sunshine/sunshine.conf"
  fi

  # Nested Sway agent canvas (named seats). Host compositor stays Hyprland.
  if [[ -f "$repo/config/sway/agent-seat/config" ]]; then
    mkdir -p "$HOME/.config/sway/agent-seat"
    onboard_link "$repo/config/sway/agent-seat/config" "$HOME/.config/sway/agent-seat/config"
  fi

  # CLI helpers on PATH
  local bin command_name
  for bin in workspace-copilot phone-display.sh audio-sink audio-evolve codexbar codexbar-noctalia \
             codexbar-sync-credentials.sh bar-mode.sh \
             desktop-app-launcher.sh desktop-wallpaper-picker.sh wallpaper-mode.sh \
             performance-mode.sh performance-pressure.py taildrop-phone.sh \
             taildrop-portal.py tmux-agent-launcher.sh tmux-fleet-switcher.sh \
             tmux-task-menu.sh tmux-widget-grid.sh theme-switcher.sh \
             reload-desktop.sh keybind-cheatsheet.py agent-seat.sh; do
    if [[ -e "$repo/scripts/$bin" ]]; then
      command_name="${bin%.sh}"
      command_name="${command_name%.py}"
      onboard_link "$repo/scripts/$bin" "$HOME/.local/bin/$command_name"
      # keep .sh name too when helpful
      if [[ "$bin" == *.sh || "$bin" == *.py ]]; then
        onboard_link "$repo/scripts/$bin" "$HOME/.local/bin/$bin"
      fi
    fi
  done

  # The hardened Taildrop unit requires its writable bind path to exist before
  # systemd creates the service mount namespace.
  mkdir -p "$HOME/Downloads/Taildrop"

  mkdir -p "$HOME/.config/systemd/user"
  for unit in agent.slice performance-pressure.service taildrop-portal.service taildrop-receive.service; do
    [[ -e "$repo/config/systemd/user/$unit" ]] && \
      onboard_link "$repo/config/systemd/user/$unit" "$HOME/.config/systemd/user/$unit"
  done

  chmod +x "$repo"/scripts/* 2>/dev/null || true
  onboard_mark_module "core-links" "done"
  printf 'core-links complete.\n'
}

run_agent_skills() {
  local repo="$REPO_ROOT"
  local skill_src="$repo/config/agent-skills/workspace-copilot"
  printf '\n==> agent-skills\n'
  if [[ ! -d "$skill_src" ]]; then
    printf '  workspace-copilot skill missing at %s\n' "$skill_src" >&2
    return 1
  fi

  onboard_link "$skill_src" "$HOME/.agents/skills/workspace-copilot"
  onboard_link "$skill_src" "$HOME/.claude/skills/workspace-copilot"
  onboard_link "$skill_src" "$HOME/.codex/skills/workspace-copilot"
  onboard_link "$skill_src" "$HOME/.config/opencode/skills/workspace-copilot"
  onboard_link "$skill_src" "$HOME/.gemini/skills/workspace-copilot"
  onboard_link "$skill_src" "$HOME/.omp/skills/workspace-copilot"
  onboard_link "$skill_src" "$HOME/.cursor/skills/workspace-copilot"

  if command -v agent-deck >/dev/null 2>&1; then
    agent-deck codex-hooks install >/dev/null 2>&1 || true
    agent-deck gemini-hooks install >/dev/null 2>&1 || true
  fi

  onboard_mark_module "agent-skills" "done"
  printf 'agent-skills complete.\n'
}

run_agent_tools() {
  printf '\n==> agent-tools\n'
  "$REPO_ROOT/scripts/setup-agent-tools.sh"
  onboard_mark_module "agent-tools" "done"
  printf 'agent-tools complete.\n'
}

run_tailnet_ssh() {
  printf '\n==> tailnet-ssh\n'
  if [[ "$(uname -s)" != "Linux" ]]; then
    printf '  skipped (Linux only)\n'
    onboard_mark_module "tailnet-ssh" "skipped"
    return 0
  fi
  "$REPO_ROOT/scripts/setup-tailnet-ssh.sh"
  onboard_mark_module "tailnet-ssh" "done"
  printf 'tailnet-ssh complete.\n'
}

run_nix_home() {
  printf '\n==> nix-home\n'
  if [[ ! -f /etc/os-release ]] || ! grep -qiE 'cachyos|arch' /etc/os-release; then
    printf '  skipped (CachyOS/Arch Home Manager bootstrap only)\n'
    onboard_mark_module "nix-home" "skipped"
    return 0
  fi
  if ! onboard_prompt_yn "Bootstrap Nix + Home Manager for this host?" default_n; then
    onboard_mark_module "nix-home" "skipped"
    return 0
  fi
  ONBOARD_NESTED=1 "$REPO_ROOT/config/nix/bootstrap-cachyos.sh"
  onboard_mark_module "nix-home" "done"
  printf 'nix-home complete.\n'
}

run_audio_evolution() {
  printf '\n==> audio-evolution\n'
  if [[ ! -x "$REPO_ROOT/scripts/install-audio-evolution.sh" ]]; then
    printf '  install-audio-evolution.sh missing\n' >&2
    return 1
  fi
  if ! onboard_prompt_yn "Install PipeWire Aural Evolution DSP?" default_n; then
    onboard_mark_module "audio-evolution" "skipped"
    return 0
  fi
  "$REPO_ROOT/scripts/install-audio-evolution.sh"
  onboard_mark_module "audio-evolution" "done"
  printf 'audio-evolution complete.\n'
}

run_nvidia_pair() {
  printf '\n==> nvidia-pair\n'
  "$REPO_ROOT/scripts/nvidia-pair-setup.sh"
  onboard_mark_module "nvidia-pair" "done"
  printf 'nvidia-pair complete.\n'
}


