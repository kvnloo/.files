#!/usr/bin/env bash
# Live, focus-safe proof for the native Hyprland Lua candidate.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
CONTROLLER="$ROOT/scripts/gui-e2e-display.sh"
PHONE="$ROOT/scripts/phone-display.sh"
CONFIG="$ROOT/config/hyprland/hyprland.lua"
WORKSPACE=${HYPR_LUA_NESTED_WORKSPACE:-99}
OUTPUT=${HYPR_LUA_NESTED_OUTPUT:-E2E-LUA}
LEASE=${HYPR_LUA_NESTED_LEASE:-hypr-lua-nested-$$}
EVIDENCE=${HYPR_LUA_EVIDENCE_DIR:-"$ROOT/.artifacts/hypr-lua-nested-$(date +%Y%m%d-%H%M%S)-$$"}
RUNTIME=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
HOST_WAYLAND=${WAYLAND_DISPLAY:-wayland-1}
HOST_HISS=${HYPRLAND_INSTANCE_SIGNATURE:-}
NESTED_HISS=""
NESTED_WAYLAND=""
NESTED_PID=""
started=0

usage() {
  printf '%s\n' \
    'usage: verify-hypr-lua-nested [--help]' \
    'Creates a host headless output on workspace 99, launches nested Lua Hyprland,' \
    'captures parity/readback evidence, tests both dynamic display lifecycles, and' \
    'cleans up. It refuses protected workspaces 1, 2, and 8.'
}
[[ ${1:-} == --help ]] && { usage; exit 0; }
[[ $WORKSPACE =~ ^[0-9]+$ ]] || { printf 'workspace must be numeric\n' >&2; exit 2; }
case " $WORKSPACE " in ' 1 '|' 2 '|' 8 ') printf 'refusing protected workspace %s\n' "$WORKSPACE" >&2; exit 3;; esac
command -v Hyprland >/dev/null
command -v hyprctl >/dev/null
command -v jq >/dev/null
mkdir -p "$EVIDENCE"

host_hypr() {
  HYPRLAND_INSTANCE_SIGNATURE="$HOST_HISS" WAYLAND_DISPLAY="$HOST_WAYLAND" hyprctl "$@"
}
nested_hypr() {
  HYPRLAND_INSTANCE_SIGNATURE="$NESTED_HISS" WAYLAND_DISPLAY="$NESTED_WAYLAND" hyprctl "$@"
}
cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ -n $NESTED_PID ]]; then
    kill "$NESTED_PID" 2>/dev/null || true
    for _ in $(seq 1 50); do kill -0 "$NESTED_PID" 2>/dev/null || break; sleep .1; done
    kill -9 "$NESTED_PID" 2>/dev/null || true
  fi
  GUI_E2E_LEASE_DIR="$EVIDENCE/leases" "$CONTROLLER" --tier hypr-headless --workspace "$WORKSPACE" --output "$OUTPUT" --lease-id "$LEASE" stop >/dev/null 2>&1 || true
  host_hypr -j monitors all >"$EVIDENCE/host-after.json" 2>/dev/null || true
  jq -n --argjson status "$status" --arg nested "$NESTED_HISS" --arg socket "$NESTED_WAYLAND" \
    '{exit_status:$status,nested_instance:$nested,nested_socket:$socket,cleanup_complete:true}' >"$EVIDENCE/result.json"
  printf 'evidence: %s\n' "$EVIDENCE"
  exit "$status"
}
trap cleanup EXIT INT TERM

host_hypr -j monitors all >"$EVIDENCE/host-before.json"
host_hypr -j workspaces >"$EVIDENCE/host-workspaces-before.json"
GUI_E2E_LEASE_DIR="$EVIDENCE/leases" "$CONTROLLER" --tier hypr-headless --workspace "$WORKSPACE" --output "$OUTPUT" --lease-id "$LEASE" start
started=1

launcher="$EVIDENCE/launch-nested.sh"
printf '#!/usr/bin/env bash\nexec env -u HYPRLAND_INSTANCE_SIGNATURE -u DISPLAY XDG_RUNTIME_DIR=%q WAYLAND_DISPLAY=%q HYPR_LUA_TEST_MODE=1 AQ_NO_MODIFIERS=1 Hyprland -c %q >%q 2>&1\n' \
  "$RUNTIME" "$HOST_WAYLAND" "$CONFIG" "$EVIDENCE/nested.log" >"$launcher"
chmod +x "$launcher"
host_hypr dispatch exec "[workspace $WORKSPACE silent] $launcher" >/dev/null

for _ in $(seq 1 100); do
  row=$(hyprctl -j instances 2>/dev/null | jq -r --arg host "$HOST_HISS" '.[] | select(.instance != $host) | [.instance,.wl_socket,.pid] | @tsv' | tail -n 1)
  if [[ -n $row ]]; then IFS=$'\t' read -r NESTED_HISS NESTED_WAYLAND NESTED_PID <<<"$row"; break; fi
  sleep .1
done
[[ -n $NESTED_HISS && -n $NESTED_WAYLAND ]] || { printf 'nested socket did not become addressable\n' >&2; exit 1; }
for _ in $(seq 1 50); do nested_hypr systeminfo >"$EVIDENCE/systeminfo.txt" 2>/dev/null && break; sleep .1; done
grep -q 'configProvider: lua' "$EVIDENCE/systeminfo.txt"
grep -qi 'backend: wayland' "$EVIDENCE/systeminfo.txt"
nested_hypr configerrors >"$EVIDENCE/configerrors.txt"
[[ -z $(tr -d '[:space:]' <"$EVIDENCE/configerrors.txt") ]] || { printf 'nested configerrors are non-empty\n' >&2; exit 1; }

for category in monitors workspaces workspacerules clients binds devices; do
  nested_hypr -j "$category" >"$EVIDENCE/nested-$category.json"
  jq -e 'type == "array" or type == "object"' "$EVIDENCE/nested-$category.json" >/dev/null
done
plugin_readback=$(nested_hypr plugin list)
jq -n --arg readback "$plugin_readback" '{plugins:$readback}' >"$EVIDENCE/nested-plugins.json"
# Hyprland's IPC command is lower-case `workspacerules`; the evidence category is
# documented as workspaceRules to match the public JSON/API name.
for option in general:gaps_in general:gaps_out decoration:rounding animations:enabled; do
  safe=${option//:/-}
  nested_hypr -j getoption "$option" >"$EVIDENCE/config-$safe.json"
done
"$ROOT/scripts/check-hypr-lua-parity" >"$EVIDENCE/static-parity.txt"

# Exercise the controller against the exact nested socket, then prove cleanup.
GUI_E2E_HYPRCTL=hyprctl HYPRLAND_INSTANCE_SIGNATURE="$NESTED_HISS" WAYLAND_DISPLAY="$NESTED_WAYLAND" \
  GUI_E2E_LEASE_DIR="$EVIDENCE/nested-leases" "$CONTROLLER" --tier hypr-headless --workspace 97 --output E2E-INNER --lease-id inner start
nested_hypr -j monitors all | jq -e 'any(.[]; .name == "E2E-INNER")' >/dev/null
GUI_E2E_HYPRCTL=hyprctl HYPRLAND_INSTANCE_SIGNATURE="$NESTED_HISS" WAYLAND_DISPLAY="$NESTED_WAYLAND" \
  GUI_E2E_LEASE_DIR="$EVIDENCE/nested-leases" "$CONTROLLER" --tier hypr-headless --workspace 97 --output E2E-INNER --lease-id inner stop
! nested_hypr -j monitors all | jq -e 'any(.[]; .name == "E2E-INNER")' >/dev/null

# Exercise phone-display with service effects stubbed, against this instance only.
HYPRLAND_INSTANCE_SIGNATURE="$NESTED_HISS" WAYLAND_DISPLAY="$NESTED_WAYLAND" PHONE_DISPLAY_SYSTEMCTL=/bin/true bash -x "$PHONE" start 2>"$EVIDENCE/phone-start.trace"
nested_hypr -j monitors all | jq -e 'any(.[]; .name == "PHONE")' >/dev/null
HYPRLAND_INSTANCE_SIGNATURE="$NESTED_HISS" WAYLAND_DISPLAY="$NESTED_WAYLAND" PHONE_DISPLAY_SYSTEMCTL=/bin/true bash -x "$PHONE" stop 2>"$EVIDENCE/phone-stop.trace"
! nested_hypr -j monitors all | jq -e 'any(.[]; .name == "PHONE")' >/dev/null

host_hypr -j monitors all >"$EVIDENCE/host-during.json"
host_hypr -j workspaces >"$EVIDENCE/host-workspaces-during.json"
jq -ne --slurpfile b "$EVIDENCE/host-before.json" --slurpfile d "$EVIDENCE/host-during.json" --arg output "$OUTPUT" '
  ($b[0] | map(select(.name != $output)) | map({key:.name,value:{focused,workspace:.activeWorkspace.id}}) | from_entries)
  == ($d[0] | map(select(.name != $output)) | map({key:.name,value:{focused,workspace:.activeWorkspace.id}}) | from_entries)
' >/dev/null
printf 'nested Lua health, readbacks, dynamic lifecycles, and host isolation: ok\n'
