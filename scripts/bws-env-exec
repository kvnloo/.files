#!/usr/bin/env python3
"""Execute one named consumer with its allowlisted Bitwarden secrets, never argv."""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import stat
import subprocess
import sys
import tempfile


def vault(env):
    bootstrap = env.get('HERMES_KEYRING_BOOTSTRAP', str(Path.home() / '.hermes/bin/hermes-keyring-bootstrap.sh'))
    result = subprocess.run([bootstrap], capture_output=True, text=True, check=True, timeout=15)
    token = None
    for line in result.stdout.splitlines():
        for word in shlex.split(line):
            if word.startswith('BWS_ACCESS_TOKEN='):
                token = word.partition('=')[2]
    if not token:
        raise RuntimeError('Bitwarden access token unavailable in keyring')
    child = dict(env, BWS_ACCESS_TOKEN=token)
    binary = env.get('BWS_BIN', str(Path.home() / '.hermes/profiles/chiefstaff/bin/bws'))
    project = env.get('HERMES_BWS_PROJECT_ID', 'ef35bed4-fc4f-42ab-a21f-b4bf013919b7')
    server = env.get('HERMES_BWS_SERVER_URL', 'https://vault.bitwarden.com')
    result = subprocess.run([binary, 'secret', 'list', project, '--server-url', server, '--output', 'json'],
                            env=child, capture_output=True, text=True, check=True, timeout=30)
    items = json.loads(result.stdout)
    return {item['key']: item['value'] for item in items}


def cached_values(env, scope, mappings):
    """Read the same private runtime credentials used by systemd consumers."""
    runtime = env.get('XDG_RUNTIME_DIR')
    if not runtime:
        return None
    if not re.fullmatch(r'[a-z0-9][a-z0-9_-]*', scope):
        raise RuntimeError('invalid consumer scope')
    try:
        directory = os.open(Path(runtime) / 'bws-secrets',
                            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    try:
        info = os.fstat(directory)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise RuntimeError('unsafe credential cache directory')
        try:
            fd = os.open(scope + '.env', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                         dir_fd=directory)
        except FileNotFoundError:
            return None
        with os.fdopen(fd) as stream:
            info = os.fstat(stream.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_mode & 0o077):
                raise RuntimeError('unsafe credential cache file')
            cached = {}
            for line in stream:
                fields = shlex.split(line)
                if len(fields) != 1 or '=' not in fields[0]:
                    raise RuntimeError('invalid credential cache entry')
                name, value = fields[0].split('=', 1)
                if name in cached:
                    raise RuntimeError('duplicate credential cache entry')
                cached[name] = value
        if any(not cached.get(name) for name in mappings):
            raise RuntimeError('incomplete consumer credential cache')
        return {source: cached[name] for name, source in mappings.items()}
    finally:
        os.close(directory)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--scope')
    parser.add_argument('--refresh', action='store_true')
    parser.add_argument('--config', default=str(Path(__file__).resolve().parent.parent / 'config/bws-consumers.json'))
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command
    if command[:1] == ['--']:
        command = command[1:]
    scopes = json.loads(Path(args.config).read_text())['scopes']
    if args.refresh:
        values = vault(os.environ)
        runtime = Path(os.environ['XDG_RUNTIME_DIR']) / 'bws-secrets'
        runtime.mkdir(mode=0o700, exist_ok=True)
        runtime.chmod(0o700)
        for scope, mappings in scopes.items():
            lines = []
            for name, source in mappings.items():
                value = values[source]
                if any(c in value for c in '\n\r\x00'):
                    raise RuntimeError('multiline credential not supported')
                quoted = value.replace('\\', '\\\\').replace('"', '\\"')
                lines.append(name + '="' + quoted + '"')
            target = runtime / (scope + '.env')
            fd, temporary_name = tempfile.mkstemp(prefix='.' + scope + '-', dir=runtime)
            temporary = Path(temporary_name)
            with os.fdopen(fd, 'w') as stream:
                stream.write('\n'.join(lines) + '\n')
            temporary.replace(target)
        print('refreshed consumer scopes: ' + ','.join(scopes))
        return
    if not command or not args.scope:
        parser.error('--scope and a command are required')
    scope = args.scope
    if scope == 'hermes':
        home = Path(os.environ.get('HERMES_HOME', str(Path.home() / '.hermes'))).resolve()
        root = (Path.home() / '.hermes').resolve()
        scope = 'hermes-root' if home == root else 'hermes-' + home.name
    # An unmapped Hermes profile receives no injected credentials; it may use
    # its own OAuth/native configuration. Explicit scope typos still fail closed.
    mappings = scopes.get(scope, {}) if args.scope == 'hermes' else scopes[scope]
    values = cached_values(os.environ, scope, mappings) if mappings else {}
    if values is None:
        values = vault(os.environ)
    env = dict(os.environ)
    env.pop('BWS_ACCESS_TOKEN', None)
    env.pop('TYPESAFE_API_KEY', None)
    for name, source in mappings.items():
        if not re.fullmatch(r'[A-Z][A-Z0-9_]*', name):
            raise RuntimeError('invalid environment name in consumer map')
        if source not in values or not values[source]:
            raise RuntimeError('missing vault secret: ' + source)
        env[name] = values[source]
    os.execvpe(command[0], command, env)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as exc:
        # Subprocess errors can contain output/arguments. Never interpolate them.
        print('bws-env-exec: credential setup failed (' + type(exc).__name__ + ')', file=sys.stderr)
        sys.exit(1)
