#!/usr/bin/env python3
"""Build the auditable legacy-directive-to-Lua ownership inventory."""
import json
from pathlib import Path
from hypr_lua_semantics import extract
from hypr_lua_static import read_directives

root = Path(__file__).resolve().parents[1]
legacy = root / "config/hyprland/hyprland.legacy.conf"
out = root / "config/hyprland/migration-inventory.json"
stack = []
directives = []
semantics = []
for number, raw in enumerate(legacy.read_text().splitlines(), 1):
    text = raw.split("#", 1)[0].strip()
    if not text:
        continue
    if text.endswith("{"):
        stack.append(text[:-1].strip())
        key = stack[0]
    elif text == "}":
        key = stack[0]
        stack.pop()
    else:
        key = stack[0] if stack else text.split("=", 1)[0].strip()
    if key in {"monitor", "workspace"}:
        owner = "lua/monitors.lua"
    elif key == "env":
        owner = "lua/environment.lua"
    elif key in {"windowrule", "layerrule"} or (key == "source" and "liquid-glass" in text):
        owner = "lua/rules.lua"
    elif key.startswith("bind") or key in {"submap", "$mod"}:
        owner = "lua/binds.lua"
    elif key == "exec-once":
        owner = "lua/autostart.lua"
    else:
        owner = "lua/appearance.lua"
    directives.append({"line": number, "directive": text, "owner": owner})
    if "=" in text and not text.endswith("{"):
        name, value = (part.strip() for part in text.split("=", 1))
        path = ".".join([*stack, name]) if stack else name
        semantics.append({"line": number, "path": path, "value": value, "owner": owner})
if stack:
    raise SystemExit(f"unclosed blocks: {stack}")
# Root directive coverage remains an independent audit. Semantic proofs instead
# describe the effective ordered source graph, not overwritten root values.
semantics = []
effective = {}
repeatable = {"monitor", "workspace", "env", "windowrule", "layerrule", "gesture",
              "spatialoverview-gesture", "bezier", "animation", "preset",
              "unbind", "submap", "exec-once", "exec", "plugin"}
for record in read_directives(root):
    name, value = record["name"], record["value"]
    path = record["path"].replace("-", "_")
    if name.startswith("$"):
        continue
    if name in {"monitor", "workspace"}:
        owner = "lua/monitors.lua"
    elif name == "env":
        owner = "lua/environment.lua"
    elif name in {"windowrule", "layerrule"}:
        owner = "lua/rules.lua"
    elif name.startswith("bind") or name in {"submap", "unbind"}:
        owner = "lua/binds.lua"
    elif name in {"exec-once", "exec"}:
        owner = "lua/autostart.lua"
    else:
        owner = "lua/appearance.lua"
    item = {"line": record["line"], "file": record["file"], "path": path,
            "value": value, "owner": owner}
    if name in repeatable or name.startswith("bind") or record["stack"] == ["device"]:
        semantics.append(item)
    else:
        effective[path] = item
semantics.extend(effective.values())
for item in semantics:
    expected = f'{item["path"]}={item["value"]}'
    owner = root / "config/hyprland" / item["owner"]
    item["proof"] = {"expected": expected, **extract(owner, item["path"], item["value"])}
out.write_text(json.dumps({"legacy": legacy.name, "directives": directives, "semantics": semantics, "unclassified": []}, indent=2) + "\n")
