#!/usr/bin/env python3
"""offsite-sync: groot is never the only copy of git work (Kevin 2026-11-16).

For every git repo under the census scan roots (home map/config.yaml) it picks the first remote
owned by kvnloo and pushes:
  - every local branch, refs/reaped/* and tag that is missing from all remotes, as the same name
    (reaped snapshots go to branches reaped/<name>);
  - a snapshot of each dirty worktree (tracked + untracked, .gitignore respected, nothing over
    50 MB) to the hidden ref refs/offsite/<host>/<branch>, force-updated each run; no branch sprawl.
It never deletes or rewrites anything local. Repos with no kvnloo remote, failed pushes and skipped
big files are listed as SOLE COPIES in the report so they get a private repo or a blob backup.
"""
import argparse, json, os, re, shutil, socket, subprocess, tempfile, time
from pathlib import Path

HOME_MAP = Path("/workspace/repos/home/map/config.yaml")
RUNS = Path("/mnt/zer0models/workspace/zer0/data/operations/storage-maintenance/runs")
BIG = 50 << 20
HOST = socket.gethostname().split(".")[0]
REMOTE_RE = os.environ.get("OFFSITE_REMOTE_RE", r"github\.com[:/]kvnloo/")


def git(cd, *a, env=None, timeout=600):
    try:
        return subprocess.run(["git", "-C", cd, *a], capture_output=True, text=True, env=env, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(a, 124, "", "timeout")


def roots():
    if os.environ.get("OFFSITE_ROOTS"):   # "path:depth,path:depth"
        return [(p.rsplit(":", 1)[0], int(p.rsplit(":", 1)[1])) for p in os.environ["OFFSITE_ROOTS"].split(",")]
    out = []
    for m in re.finditer(r"path:\s*([^,}]+),\s*depth:\s*(\d+)", HOME_MAP.read_text()):
        out.append((m.group(1).strip(), int(m.group(2))))
    return out


def repos():
    seen = {}
    for root, depth in roots():
        r = subprocess.run(["find", root, "-maxdepth", str(depth + 1), "-name", ".git", "-prune",
                            "-not", "-path", "*/node_modules/*"], capture_output=True, text=True, timeout=600)
        for g in r.stdout.split():
            wt = str(Path(g).parent)
            common = git(wt, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
            if common and common not in seen and not git(wt, "rev-parse", "--is-bare-repository").stdout.startswith("true"):
                seen[common] = wt
    return seen


def kvn_remote(wt):
    for line in git(wt, "remote", "-v").stdout.splitlines():
        parts = line.split()  # a remote with an empty url prints just its name
        if len(parts) >= 2 and re.search(REMOTE_RE, parts[1]):
            return parts[0]
    return None


def local_only(wt, pattern):
    refs = git(wt, "for-each-ref", "--format=%(refname)", pattern).stdout.split()
    return [r for r in refs if git(wt, "rev-list", "-1", r, "--not", "--remotes").stdout.strip()]


def snapshot(wt, apply=True):
    """Commit tracked + untracked non-ignored changes of a dirty worktree; return (sha, skipped)."""
    if not git(wt, "status", "--porcelain").stdout.strip():
        return None, []
    if not apply:
        return "dirty", []
    new = git(wt, "ls-files", "-o", "--exclude-standard", "-z").stdout.split("\0")
    # Environments rebuild from lockfiles; a venv missing from .gitignore cost a 5 h run (2026-11-16).
    envs = [f[:-len("/pyvenv.cfg")] for f in new if f.endswith("/pyvenv.cfg")]
    skip = [":(exclude,glob)**/node_modules/**", *[f":(exclude){d}" for d in envs]]
    new = [f for f in new if "node_modules/" not in f and not any(f.startswith(d + "/") for d in envs)]
    big = [f for f in new if f and os.path.isfile(os.path.join(wt, f)) and os.path.getsize(os.path.join(wt, f)) > BIG]
    with tempfile.TemporaryDirectory() as td:
        env = dict(os.environ, GIT_INDEX_FILE=os.path.join(td, "index"))
        # start from a copy of the real index: its stat cache means only changed files get hashed
        idx = git(wt, "rev-parse", "--path-format=absolute", "--git-path", "index").stdout.strip()
        if os.path.isfile(idx):
            shutil.copyfile(idx, env["GIT_INDEX_FILE"])
        elif git(wt, "read-tree", "HEAD", env=env).returncode:
            return None, ["read-tree failed"]
        git(wt, "add", "-A", "--", ".", *skip, *[f":(exclude){f}" for f in big], env=env, timeout=1800)
        tree = git(wt, "write-tree", env=env).stdout.strip()
    sha = git(wt, "-c", "user.name=offsite-sync", "-c", "user.email=offsite-sync@localhost", "commit-tree",
              tree, "-p", "HEAD", "-m", f"offsite-sync snapshot of {wt}").stdout.strip()
    return sha or None, big


def sync(common, wt, apply):
    rec = {"repo": wt, "remote": kvn_remote(wt)}
    worktrees = [l[9:] for l in git(wt, "worktree", "list", "--porcelain").stdout.splitlines()
                 if l.startswith("worktree ") and os.path.isdir(l[9:])]
    specs = [f"{r}:{r}" for r in local_only(wt, "refs/heads") + local_only(wt, "refs/tags")]
    specs += [f"{r}:refs/heads/reaped/{r.removeprefix('refs/reaped/')}" for r in local_only(wt, "refs/reaped")]
    dirty, skipped = [], []
    for w in worktrees:
        sha, big = snapshot(w, apply)
        skipped += [os.path.join(w, f) for f in big]
        if sha:
            br = git(w, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
            br = br if br != "HEAD" else Path(w).name
            dirty.append(w)
            specs.append(f"+{sha}:refs/offsite/{HOST}/{br}")
    rec.update(unpushed=len(specs) - len(dirty), dirty=dirty, skipped_big=skipped)
    if not specs:
        return rec
    if not rec["remote"]:
        rec["sole_copy"] = "no kvnloo remote"
        return rec
    if apply:
        r = git(wt, "push", "--no-verify", rec["remote"], *specs, timeout=1800)
        rec["pushed"] = r.returncode == 0
        if r.returncode:
            rec["sole_copy"] = "push failed: " + r.stderr.strip()[-300:]
    return rec


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--apply", action="store_true", help="push (default: report only)")
    ap.add_argument("--out", type=Path, default=RUNS / time.strftime("offsite-%Y%m%d"))
    a = ap.parse_args()
    a.out.mkdir(parents=True, exist_ok=True)
    recs = []
    with open(a.out / "receipts.jsonl", "a") as log:
        for common, wt in sorted(repos().items()):
            rec = sync(common, wt, a.apply)
            recs.append(rec)
            log.write(json.dumps(rec) + "\n")
            log.flush()
    sole = [r for r in recs if r.get("sole_copy") or r["skipped_big"]]
    summary = {"time": time.strftime("%FT%T%z"), "apply": a.apply, "repos": len(recs),
               "pushed": sum(bool(r.get("pushed")) for r in recs), "sole_copies": len(sole),
               "sole": [{k: r.get(k) for k in ("repo", "sole_copy", "unpushed", "dirty", "skipped_big")} for r in sole]}
    (a.out / "summary.json").write_text(json.dumps(summary, indent=1))
    print(json.dumps({k: summary[k] for k in ("repos", "pushed", "sole_copies")}))


if __name__ == "__main__":
    main()
