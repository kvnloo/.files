#!/usr/bin/env python3
"""Regenerate ~/.config/tern/hosts from live Tailscale peers.

Tern's window always shows this machine's own daemon as "This computer". It
also attaches to every line of ~/.config/tern/hosts as a remote host, so a line
that points at this machine duplicates it. A static hosts file copied between
machines is therefore wrong by construction: every machine must leave itself out.

A peer is listed when all of these hold:
  * it is not this machine (any of Self.TailscaleIPs);
  * it is online in Tailscale and runs Linux or macOS. Android app nodes can't
    run `tern remote serve`; a phone's Omarchy guest is its own Linux node;
  * its Tern host key is pinned in ~/.config/tern/known_hosts, which is the
    trust Tern itself needs before it connects. Pin with
    `tern remote trust <ip> <SHA256:fp>` after checking `tern remote host-key` on
    that machine. `tern remote doctor` is not used as the gate because it stalls
    on its relay probes inside phone PRoot guests.

Names and users come from, in order:
  1. ~/.config/tern/hosts.names ("<ip> <name> [user]"), an optional local override;
  2. the private z0-hosts instance ($Z0_HOSTS_DIR, default ~/.config/z0-hosts):
     hosts/*/devices.toml, matched by MagicDNS label or Tailscale HostName against
     peer_hostname/aliases. The sidebar name is the first non-numeric alias, else the
     device key; the user is root for kind="phone", else kvn. No addresses are stored;
  3. otherwise the MagicDNS label, user kvn. The file is
written atomically, and only when its contents change.

  tern-hosts-sync             sync once
  tern-hosts-sync --dry-run   print the file instead of writing it
  tern-hosts-sync --every N   sync every N seconds (runit hosts without systemd timers)
"""
import json, os, subprocess, sys, tempfile, time, tomllib
from pathlib import Path

CFG = Path.home() / ".config/tern"
HOSTS, NAMES, KNOWN = CFG / "hosts", CFG / "hosts.names", CFG / "known_hosts"
PORT = 8376


def tailscale():
    return json.loads(subprocess.run(["tailscale", "status", "--json"], check=True,
                                     capture_output=True, text=True, timeout=20).stdout)


def names():
    out = {}
    if NAMES.exists():
        for line in NAMES.read_text().splitlines():
            parts = line.split("#", 1)[0].split()
            if len(parts) >= 2:
                out[parts[0]] = (parts[1], parts[2] if len(parts) > 2 else None)
    return out


def devices(root=None):
    """Label (peer_hostname or alias) -> (sidebar name, user) from the private z0-hosts devices.toml files."""
    root = Path(root or os.environ.get("Z0_HOSTS_DIR") or Path.home() / ".config/z0-hosts").expanduser()
    out = {}
    for path in sorted(root.glob("hosts/*/devices.toml")):
        try:
            table = tomllib.loads(path.read_text())
        except (OSError, tomllib.TOMLDecodeError) as e:
            print(f"tern-hosts-sync: ignoring {path.name} in {path.parent.name}: {e}", file=sys.stderr, flush=True)
            continue
        for key, dev in table.items():
            if not isinstance(dev, dict):
                continue
            aliases = [a for a in dev.get("aliases", []) if isinstance(a, str)]
            name = next((a for a in aliases if not a.isdigit()), key)
            user = "root" if dev.get("kind") == "phone" else "kvn"
            for label in [dev.get("peer_hostname"), *aliases]:
                if isinstance(label, str) and label:
                    out.setdefault(label, (name, user))
    return out


def pinned():
    """Host strings (without :port) that have a pinned Tern host key."""
    out = set()
    if KNOWN.exists():
        for line in KNOWN.read_text().splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1].startswith("SHA256:"):
                out.add(parts[0].rsplit(":", 1)[0])
    return out


def render(ts, named, trusted, devs=None):
    self_ips = set(ts["Self"]["TailscaleIPs"])
    lines, skipped = [], []
    for p in sorted(ts.get("Peer", {}).values(), key=lambda p: p["DNSName"]):
        ip = p["TailscaleIPs"][0]
        dns = p["DNSName"].rstrip(".")
        if ip in self_ips or not p.get("Online") or p.get("OS") not in ("linux", "macOS"):
            continue
        label = dns.split(".")[0]
        name, user = (named.get(ip) or (devs or {}).get(label) or (devs or {}).get(p.get("HostName"))
                      or (label or p["HostName"], None))
        if not trusted & {ip, dns, dns.split(".")[0]}:
            skipped.append(f"{name} ({ip}): host key not pinned")
            continue
        lines.append(f"{user or 'kvn'}@{ip}:{PORT}\t{name}")
    body = ("# Generated by tern-hosts-sync from live Tailscale peers. Do not edit; set names in hosts.names.\n"
            "# This machine is never listed: Tern shows it as \"This computer\".\n"
            + "".join(l + "\n" for l in lines))
    return body, lines, skipped


def sync(dry):
    body, lines, skipped = render(tailscale(), names(), pinned(), devices())
    for s in skipped:
        print("tern-hosts-sync: skipped", s, file=sys.stderr, flush=True)
    if dry:
        print(body, end="")
        return
    if HOSTS.exists() and HOSTS.read_text() == body:
        return
    CFG.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=CFG, prefix=".hosts.")
    with os.fdopen(fd, "w") as f:
        f.write(body)
    os.chmod(tmp, 0o600)
    os.replace(tmp, HOSTS)
    print("hosts updated:", ", ".join(l.split("\t")[1] for l in lines) or "(none)", flush=True)


def main():
    args = sys.argv[1:]
    if any(a in ("-h", "--help") for a in args) or any(
            a not in ("--dry-run", "--every") and not (i and args[i - 1] == "--every") for i, a in enumerate(args)):
        print(__doc__, file=sys.stderr)
        return 0 if any(a in ("-h", "--help") for a in args) else 2
    dry = "--dry-run" in sys.argv
    if "--every" in sys.argv:
        period = int(sys.argv[sys.argv.index("--every") + 1])
        while True:
            try:
                sync(dry)
            except Exception as e:  # keep running under the supervisor; retry next period
                print("tern-hosts-sync:", e, file=sys.stderr, flush=True)
            time.sleep(period)
    sync(dry)


if __name__ == "__main__":
    sys.exit(main())
