#!/bin/sh
# O10 applies again at the publication boundary.
set -eu
hook_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in ''|0000000000000000000000000000000000000000) continue ;; esac
  "$hook_root/scripts/check-phone-caps" "$local_oid"
done
